<!DOCTYPE translationbundle>
<translationbundle lang="kk">
<translation id="1001534784610492198">Орнатқыш мұрағаты бүлінген немесе жарамсыз. GTX Browser қайтадан жүктеңіз.</translation>
<translation id="102763973188675173">GTX Browser браузерін реттеңіз және басқарыңыз. Жаңартылған нұсқа қолжетімді.</translation>
<translation id="1051826050538111504">Компьютеріңізде зиянды бағдарламалық құрал бар. GTX Browser браузері оны өшіріп, параметрлеріңізді қалпына келтіреді де, кеңейтімдерді ажыратады. Соның арқасында браузеріңіз қалыпты жұмысын  жалғастырады.</translation>
<translation id="1065672644894730302">Реттеулерді оқу мүмкін емес.

Кейбір мүмкіндіктер қолжетімсіз болуы мүмкін және параметрлерге жасалған өзгертулер сақталмайды.</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" /> бұрын GTX Browser браузерін пайдаланған</translation>
<translation id="110877069173485804">Сізге арналған GTX Browser</translation>
<translation id="1125124144982679672">GTX Browser браузерін кім пайдаланып жатыр?</translation>
<translation id="1142745911746664600">GTX Browser браузерін жаңарту мүмкін емес</translation>
<translation id="1154147086299354128">&amp;GTX Browser браузерінде ашу</translation>
<translation id="1182414570724401860">GTX Browser бұл файлды жүктеп алмауды немесе ашпауды ұсынады.</translation>
<translation id="1278833599417554002">&amp;GTX Browser-ды жаңарту үшін қайта іске қосу</translation>
<translation id="1293325835983155583">Бұл құрылғыны пайдаланбас бұрын, <ph name="MANAGER" /> келесі Қызмет көрсету шарттарын оқып, қабылдауыңызды талап етеді. Бұл шарттар GTX Browser OS Шарттарын толықтырмайды, өзгертпейді және шектемейді.</translation>
<translation id="1302523850133262269">GTX Browser ең соңғы жүйе жаңартуларын орнатуда, күте тұрыңыз.</translation>
<translation id="137466361146087520">GTX Browser Beta</translation>
<translation id="1399397803214730675">Бұл компьютерге ең жаңа GTX Browser нұсқасы орнатылған. Бағдарламалық жасақтама жұмыс істемесе, GTX Browser браузерін жойып, әрекетті қайталап көріңіз.</translation>
<translation id="1434626383986940139">GTX Browser Canary қолданбалары</translation>
<translation id="1507198376417198979">Жаңа GTX Browser профиліңізді реттеңіз.</translation>
<translation id="1516530951338665275">Жұптауды жалғастыру үшін GTX Browser-ға Bluetooth-ты пайдалану рұқсаты керек. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1553358976309200471">GTX Browser жаңарту</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> бұл GTX Browser профиліне кіріп қойған. <ph name="USER_EMAIL_ADDRESS" /> үшін жаңа GTX Browser профилі жасалады.</translation>
<translation id="1587223624401073077">GTX Browser камераңызды пайдалануда.</translation>
<translation id="1587325591171447154"><ph name="FILE_NAME" /> қауіпті болғандықтан, GTX Browser оны бөгеді.</translation>
<translation id="1597911401261118146">Құпия сөздеріңіз ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK" />GTX Browser браузеріне кіріңіз<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">GTX Browser браузерін қауіпсіз ету үшін, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> тізімінде жоқ келесі кеңейтім  өшірілді, ол сізге ескертілмей қосылған болуы мүмкін.</translation>
<translation id="1628000112320670027">GTX Browser жөнінде анықтама алу</translation>
<translation id="1674870198290878346">Сілтемені GTX Browser инкогнито терезесінде ашу</translation>
<translation id="1682634494516646069">GTX Browser өзінің деректер каталогін оқуы және жазуы мүмкін емес:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">GTX Browser веб-беттер мен қолданбаларды өте жылдам пайдаланатын веб-браузер болып табылады. Ол жылдам, тұрақты және пайдалануға оңай. GTX Browser ендірілген зиянды бағдарлама және фишинг қорғанысымен интернетті қауіпсіз шарлаңыз.</translation>
<translation id="1713301662689114961">{0,plural, =1{GTX Browser браузері бір сағаттан кейін қайта іске қосылады}other{GTX Browser браузері # сағаттан кейін қайта іске қосылады}}</translation>
<translation id="1734234790201236882">GTX Browser бұл құпия сөзді Google аккаунтыңызда сақтайды. Оны есте сақтаудың қажеті жоқ.</translation>
<translation id="174539241580958092">Кіру кезіндегі қате себебінен GTX Browser деректеріңізді синхрондай алмайды.</translation>
<translation id="1759842336958782510">GTX Browser</translation>
<translation id="1786003790898721085"><ph name="TARGET_DEVICE_NAME" /> құрылғысындағы GTX Browser браузеріне кіргеніңізді тексеріп, қайта жіберіп көріңіз.</translation>
<translation id="1812689907177901597">Бұл функцияны өшіріп, GTX Browser браузеріне кірместен Gmail сияқты Google сайттарын пайдалана беруіңізге болады</translation>
<translation id="1860536484129686729">GTX Browser браузеріне бұл сайтта камераны пайдалану үшін рұқсат керек</translation>
<translation id="1873233029667955273">GTX Browser әдепкі браузеріңіз емес</translation>
<translation id="1874309113135274312">GTX Browser Beta (mDNS-In)</translation>
<translation id="1877026089748256423">GTX Browser ескірген</translation>
<translation id="1919130412786645364">GTX Browser браузеріне кіруге рұқсат ету</translation>
<translation id="2018528049276128029">Әр профильде бетбелгілер, тарих, құпия сөздер және тағы басқа GTX Browser ақпараты бар.</translation>
<translation id="2063848847527508675">Жаңарту күшіне енуі үшін GTX Browser OЖ-н қайта іске қосу қажет.</translation>
<translation id="2094919256425865063">GTX Browser браузерінен бәрібір шығасыз ба?</translation>
<translation id="2120620239521071941"><ph name="ITEMS_COUNT" /> элемент бұл құрылғыдан жойылады. Деректерді кейінірек алу үшін GTX Browser жүйесіне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="2121284319307530122">&amp;GTX Browser-ды жаңарту үшін қайта іске қосу</translation>
<translation id="2123055963409958220"><ph name="BEGIN_LINK" />Ағымдағы параметрлерді<ph name="END_LINK" /> хабарлау арқылы GTX Browser браузерін жақсартуға көмектесіңіз</translation>
<translation id="2151406531797534936">GTX Browser браузерін өшіріп, қайта қосыңыз</translation>
<translation id="2189289170880510015">GTX Browser-ның ең маңызды құпиялылық параметрлерін реттеңіз</translation>
<translation id="2258103955319320201">GTX Browser браузерінің материалдарын барлық құрылғыда пайдалану үшін аккаунтқа кіріп, синхрондау параметрін қосыңыз.</translation>
<translation id="2290014774651636340">Google API пернелері жоқ. Кейбір GTX Browser функционалдықтары өшіріледі.</translation>
<translation id="2290095356545025170">GTX Browser жою қажет пе?</translation>
<translation id="2309047409763057870">Бұл – GTX Browser браузерінің қайта орнатылған нұсқасы және әдепкі браузер бола алмайды.</translation>
<translation id="2345992953227471816">GTX Browser бұл кеңейтімдерде зиянды бағдарлама бар екенін анықтады:</translation>
<translation id="2348335408836342058">GTX Browser браузеріне бұл сайтта камераны және микрофонды пайдалану үшін рұқсат керек</translation>
<translation id="234869673307233423">GTX Browser сіздің құпия сөздеріңізді тексере алмайды. Кейінірек қайталап көріңіз.</translation>
<translation id="235650106824528204">Жұмыс профилінің әкімшісі осы профильді пайдалану кезінде құрылатын GTX Browser браузерінің кез келген дерегін (бетбелгілер, тарих, құпия сөздер жасау және басқа параметрлер сияқты) жоя алады. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">Жалғастыру</translation>
<translation id="2429317896000329049">GTX Browser деректеріңізді синхрондай алмады, себебі синхрондау функциясы доменіңіз үшін қолжетімді емес.</translation>
<translation id="2467438592969358367">GTX Browser құпия сөздерді экспорттағысы келеді. Бұған рұқсат беру үшін Windows құпия сөзіңізді теріңіз.</translation>
<translation id="2485422356828889247">Жою</translation>
<translation id="2534507159460261402">Google Pay (GTX Browser браузеріне көшірілген)</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> бұл GTX Browser профиліне кіріп қойған. Браузерді пайдалану деректерін бөлек сақтау үшін GTX Browser сізге жеке профиль жасай алады.</translation>
<translation id="2580411288591421699">Қазір ашылып тұрғанмен бірдей GTX Browser нұсқасын орнату мүмкін емес. GTX Browser браузерін жауып, әрекетті қайталаңыз.</translation>
<translation id="2586406160782125153">Құрылғыдан шолу деректері жойылады. Деректерді кейінірек алу үшін GTX Browser жүйесіне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="2622559029861875898">GTX Browser жаңа нұсқалардың бар-жоғын тексере алмайды. Интернет байланысын тексеріп көріңіз.</translation>
<translation id="2644798301485385923">GTX Browser OS жүйесі</translation>
<translation id="2652691236519827073">Сілтемені жаңа GTX Browser қойындысында ашу</translation>
<translation id="2665296953892887393">Google компаниясына ақау есептерін және <ph name="UMA_LINK" /> жіберу арқылы GTX Browser жақсартуға көмектесіңіз</translation>
<translation id="2689103672227170538">Бұл кеңейтім GTX Browser браузерін іске қосқан кезде көрсетілетін бетті өзгертті.</translation>
<translation id="2742320827292110288">Ескерту: GTX Browser кеңейтімдердің браузерді қолдану тарихын жазуына кедергі бола алмайды. Бұл кеңейтімді Инкогнито режимінде өшіру үшін бұл опцияның белгісін алып тастаңыз.</translation>
<translation id="2765403129283291972">GTX Browser браузеріне бұл сайтта микрофонды пайдалану үшін рұқсат керек</translation>
<translation id="2770231113462710648">Әдепкі браузерді келесіге өзгерту:</translation>
<translation id="2775140325783767197">GTX Browser сіздің құпия сөздеріңізді тексере алмайды. Интернет байланысын тексеріп көріңіз.</translation>
<translation id="2799223571221894425">Қайта іске қосу</translation>
<translation id="2847461019998147611">GTX Browser жүйесін осы тілде көрсету</translation>
<translation id="2857540653560290388">GTX Browser қосылып жатыр…</translation>
<translation id="2857972467023607093">Бұл аккаунтқа GTX Browser профилі тіркеліп қойған.</translation>
<translation id="2861074815332034794">GTX Browser жаңартылуда (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">GTX Browser жүйесіне кірдіңіз!</translation>
<translation id="2885378588091291677">Тапсырмалар реттегіші</translation>
<translation id="2888126860611144412">GTX Browser туралы</translation>
<translation id="2926676257163822632">Құпия сөзіңіз оңай болса, оны табу да оңай. GTX Browser браузеріне <ph name="BEGIN_LINK" />күрделі құпия сөздер жасауға және сақтауға<ph name="END_LINK" /> мүмкіндік беріңіз.</translation>
<translation id="2926952073016206995">GTX Browser бұл сайт үшін камераны пайдалануға рұқсат сұрайды.</translation>
<translation id="2929907241665500097">GTX Browser жаңартылған жоқ. Бірдеңе дұрыс болмады. <ph name="BEGIN_LINK" />GTX Browser браузеріндегі жаңартуға қатысты мәселелерді түзетіңіз.<ph name="END_LINK" /></translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" /> – Желіге кіру – GTX Browser</translation>
<translation id="3037838751736561277">GTX Browser фондық режимде.</translation>
<translation id="3059710691562604940">"Қауіпсіз шолу" функциясы өшірулі. GTX Browser браузері оны қосуды ұсынады.</translation>
<translation id="3065168410429928842">GTX Browser қойындысы</translation>
<translation id="3069821012350118710">GTX Browser браузерін жапқанға дейін, сіз кірген сайттар сіз туралы ақпаратты есте сақтайды.</translation>
<translation id="3080151273017101988">GTX Browser жабылғанда, фондық қолданбаларды пайдалануды жалғастыру</translation>
<translation id="3089968997497233615">Жаңа, қауіпсізірек GTX Browser нұсқасы қолжетімді.</translation>
<translation id="3100998948628680988">GTX Browser профиліне ат қойыңыз</translation>
<translation id="3114643501466072395">Басқа құпия сөздеріңіздің ұрланудан және басқа да қауіпсіздік мәселелерінен қаншалықты қорғалғанын тексеру үшін <ph name="BEGIN_LINK" />GTX Browser браузеріне кіріңіз<ph name="END_LINK" />.</translation>
<translation id="3140883423282498090">Өзгертулеріңіз GTX Browser келесі рет қайта іске қосылғанда күшіне енеді.</translation>
<translation id="3149510190863420837">GTX Browser Apps</translation>
<translation id="3360895254066713204">GTX Browser Helper</translation>
<translation id="3379938682270551431">{0,plural, =0{GTX Browser браузері қазір қайта іске қосылады}=1{GTX Browser браузері 1 секундтан кейін қайта іске қосылады}other{GTX Browser браузері # секундтан кейін қайта іске қосылады}}</translation>
<translation id="3395323229510056640">GTX Browser ОЖ жөнінде анықтама алу</translation>
<translation id="3396977131400919238">Орнату барысында операциялық жүйе қатесі орын алды. GTX Browser қолданбасын қайта жүктеңіз.</translation>
<translation id="3428747202529429621">Аккаунтқа кірген болсаңыз, сізді GTX Browser браузерінде қорғайды және басқа Google қолданбаларында қауіпсіздігіңізді жақсартуға пайдаланылуы мүмкін.</translation>
<translation id="3434246496373299699">Google аккаунтыңызбен кіргенде, GTX Browser сіздің құпия сөздеріңізді тексере алады.</translation>
<translation id="3451115285585441894">GTX Browser жүйесіне қосылуда…</translation>
<translation id="345171907106878721">GTX Browser жүйесіне өзіңізді қосу</translation>
<translation id="34857402635545079">GTX Browser браузеріндегі деректер де өшірілсін (<ph name="URL" />)</translation>
<translation id="3503306920980160878">Бұл сайтқа көрсету үшін GTX Browser браузері орналасқан жеріңізді білуі керек</translation>
<translation id="3533694711092285624">Ешқандай құпия сөз сақталмаған. Құпия сөздер сақталған кезде, GTX Browser оларды тексере алады.</translation>
<translation id="3541482654983822893">GTX Browser сіздің құпия сөздеріңізді тексере алмай жатыр. 24 сағаттан кейін қайталап көріңіз.</translation>
<translation id="3576528680708590453">Жүйе әкімшісі GTX Browser браузерін <ph name="TARGET_URL_HOSTNAME" /> бетіне кіргенде қосымша браузер ашылатын етіп конфигурациялады.</translation>
<translation id="3582972582564653026">GTX Browser браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіріңіз.</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{Жаңартылған нұсқаны қолдану үшін әкімшіңіз GTX Browser браузерін қайта іске қосуыңызды талап етеді.}=1{Жаңартылған нұсқаны қолдану үшін әкімшіңіз GTX Browser браузерін қайта іске қосуыңызды талап етеді. Инкогнито терезесі қайта ашылмайды.}other{Жаңартылған нұсқаны қолдану үшін әкімшіңіз GTX Browser браузерін қайта іске қосуыңызды талап етеді. # инкогнито терезесі қайта ашылмайды.}}</translation>
<translation id="3622797965165704966">Енді GTX Browser қолданбасын Google аккаунтымен және ортақ компьютерлерде пайдалану жеңілірек.</translation>
<translation id="3673813398384385993">GTX Browser "<ph name="EXTENSION_NAME" />" кеңейтімінде зиянды бағдарлама бар екенін анықтады.</translation>
<translation id="3678552270983184277">GTX Browser-ның әдепкі параметрлері көп адамға қолайлы етіп орнатылған, бірақ оларды өз ыңғайыңызға қарай реттеуге болады.</translation>
<translation id="3718181793972440140">Құрылғыдан 1 элемент жойылады. Деректерді кейінірек алу үшін GTX Browser браузеріне <ph name="USER_EMAIL" /> болып кіріңіз.</translation>
<translation id="3735758079232443276">«<ph name="EXTENSION_NAME" />» кеңейтімі GTX Browser браузерін іске қосқан кезде көрсетілетін бетті өзгертті.</translation>
<translation id="3779473566290487688">GTX Browser жаңартылған нұсқасын алу үшін OS X 10.11 не одан кейінгі операциялық жүйе керек. Бұл компьютерде OS X 10.10 нұсқасы орнатылған.</translation>
<translation id="3780814664026482060">GTX Browser – <ph name="PAGE_TITLE" /></translation>
<translation id="3835168907083856002"><ph name="USER_EMAIL_ADDRESS" /> үшін жаңа GTX Browser профилі жасалады.</translation>
<translation id="386202838227397562">Барлық GTX Browser терезелерін жауып, әрекетті қайталап көріңіз.</translation>
<translation id="3865754807470779944">GTX Browser браузерінің <ph name="PRODUCT_VERSION" /> нұсқасы орнатылды.</translation>
<translation id="3873044882194371212">Сілтемені GTX Browser инкогнито терезесінде ашу</translation>
<translation id="3889417619312448367">GTX Browser жою</translation>
<translation id="4050175100176540509">Соңғы нұсқасында қауіпсіздік жақсартылып, жаңа мүмкіндіктер берілген.</translation>
<translation id="4053720452172726777">GTX Browser реттеу және бақылау</translation>
<translation id="4110895483821904099">Жаңа GTX Browser профилінің параметрлерін реттеу</translation>
<translation id="4147555960264124640">Бақыланатын аккаунт арқылы кірдіңіз және оның әкімшісіне GTX Browser профиліңізді бақылау рұқсатын бердіңіз. Қолданбалар, бетбелгілер, журнал, құпия сөздер сияқты GTX Browser деректеріңіз және басқа параметрлер біржола <ph name="USER_NAME" /> пайдаланушысына байланыстырылады. Бұл деректерді Google аккаунт бақылау тақтасы арқылы жоя аласыз, бірақ бұл деректерді басқа аккаунтмен байланыстыра алмайсыз. <ph name="LEARN_MORE" /></translation>
<translation id="4149882025268051530">Орнату құралы мұрағаттан шығара алмады. GTX Browser қолданбасын қайта жүктеңіз.</translation>
<translation id="4191857738314598978">{0,plural, =1{GTX Browser браузерін бір күннің ішінде қайта іске қосыңыз}other{GTX Browser браузерін # күннің ішінде қайта іске қосыңыз}}</translation>
<translation id="4205939740494406371">GTX Browser сіздің құпия сөздеріңізді тексере алмай жатыр. 24 сағаттан кейін қайталап көріңіз немесе <ph name="BEGIN_LINK" />құпия сөздерді Google аккаунтынан тексеріңіз<ph name="END_LINK" />.</translation>
<translation id="4242034826641750751">GTX Browser бұл сайт үшін камера мен микрофонды пайдалануға рұқсат сұрайды.</translation>
<translation id="424864128008805179">GTX Browser жүйесінен шығасыз ба?</translation>
<translation id="4251615635259297716">Chromium дерегіңізді осы аккаунтпен байланыстырасыз ба?</translation>
<translation id="4281844954008187215">Қызмет көрсету шарттары</translation>
<translation id="4293420128516039005">GTX Browser браузерін барлық құрылғыларда синхрондап, параметрлерін жекелендіру үшін аккаунтыңызға кіріңіз.</translation>
<translation id="4325083532956419387">GTX Browser OS нұсқасы</translation>
<translation id="4328355335528187361">GTX Browser Dev (mDNS-In)</translation>
<translation id="4331809312908958774">GTX Browser OS</translation>
<translation id="4335235004908507846">GTX Browser деректердің қолды болуынан, сәйкес келмейтін кеңейтімдерден және тағы басқа мәселелерден қорғайды.</translation>
<translation id="4343195214584226067"><ph name="EXTENSION_NAME" /> кеңейтімі GTX Browser браузеріне енгізілді</translation>
<translation id="4384570495110188418">Аккаунтқа кірмегендіктен, GTX Browser сіздің құпия сөздеріңізді тексере алмайды.</translation>
<translation id="4407807842708586359">GTX Browser OS</translation>
<translation id="4427306783828095590">Жақсартылған қорғаныс фишинг пен зиянды бағдарламаларды бөгеуде көбірек істейді.</translation>
<translation id="4450664632294415862">GTX Browser – Желіге кіру – <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">GTX Browser браузерінде басқа операция орындалуда. Әрекетті кейінірек қайталаңыз.</translation>
<translation id="4480040274068703980">Кіру кезіндегі қате себебінен GTX Browser OS деректеріңізді синхрондай алмайды.</translation>
<translation id="4521185804071812304">Қосымша: диагностика және пайдаланылуы туралы деректі Google-ға автоматты түрде жіберу арқылы GTX Browser операциялық жүйесінің функцияларын және жұмыс өнімділігін жақсартуға көмектесу.</translation>
<translation id="4561051373932531560">GTX Browser вебтегі телефон нөмірін басып, оған Skype арқылы қоңырау шалуға мүмкіндік береді!</translation>
<translation id="4567424176335768812"><ph name="USER_EMAIL_ADDRESS" /> ретінде кіргенсіз. Енді барлық кірген құрылғыларда бетбелгілеріңізді, журналыңызды және басқа параметрлерді көре аласыз.</translation>
<translation id="4571503333518166079">GTX Browser хабарландыру параметрлері бөліміне өту</translation>
<translation id="459622048091363950">GTX Browser браузерінің кіру рұқсаты болса, веб-сайттар сізден кіру рұқсатын сұрай алады.</translation>
<translation id="4600710005438004015">GTX Browser браузерінің ең соңғы нұсқасы орнатылмады, сондықтан жаңа мүмкіндіктер мен қауіпсіздікке қатысты түзетілген функцияларды пайдалана алмайсыз.</translation>
<translation id="4633000520311261472">GTX Browser қауіпсіз ету үшін <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ішінде көрсетілмеген және сізге білдірмей қосылған болуы мүмкін кейбір кеңейтімдерді өшірдік.</translation>
<translation id="4728575227883772061">Орнату анықталмаған қате себебінен сәтсіз аяқталды. Қазір GTX Browser жұмыс істеп тұрса, оны жауып, әрекетті қайталаңыз.</translation>
