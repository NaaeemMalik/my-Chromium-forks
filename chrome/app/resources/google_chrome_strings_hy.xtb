<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hy">
<translation id="1001534784610492198">Տեղադրիչի արխիվը վնասված է կամ անվավեր: Նորից ներբեռնեք GTX Browser-ը:</translation>
<translation id="102763973188675173">Հասանելի է GTX Browser-ի նոր տարբերակը։</translation>
<translation id="1051826050538111504">Ձեր համակարգչում վնասաբեր ծրագիր է հայտնաբերվել։ Ձեր դիտարկիչի կայուն աշխատանքը վերականգնելու համար Chromium-ը կարող է ջնջել ծրագիրը և վերականգնել ձեր կարգավորումները։</translation>
<translation id="1065672644894730302">Ձեր նախասիրությունները չի հաջողվում ստանալ:

Որոշ գործառույթներ կարող են մատչելի չլինել: Նախընտրանքների փոփոխությունները չեն պահպանվի:</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" />-ը նախկինում GTX Browser է օգտագործել</translation>
<translation id="110877069173485804">Սա ձեր GTX Browser-ն է</translation>
<translation id="1125124144982679672">Ո՞վ է օգտագործում GTX Browser-ը</translation>
<translation id="1142745911746664600">Չհաջողվեց թարմացնել GTX Browser-ը</translation>
<translation id="1154147086299354128">&amp;Բացել GTX Browser-ում</translation>
<translation id="1182414570724401860">GTX Browser-ը խորհուրդ է տալիս ձեզ չներբեռնել և չբացել այս ֆայլը</translation>
<translation id="1278833599417554002">Վերագործարկել՝ &amp;GTX Browser-ը թարմացնելու համար</translation>
<translation id="1293325835983155583">Կայքը (<ph name="MANAGER" />) պահանջում է, որ դուք նախքան սարքն օգտագործելը կարդաք և ընդունեք հետևյալ Օգտագործման պայմանները։ Այս պայմանները չեն ընդլայնում, փոփոխում կամ սահմանափակում GTX Browser OS-ի պայմանները։</translation>
<translation id="1302523850133262269">Սպասեք` մինչ GTX Browser-ը տեղադրում է համակարգի նորագույն թարմացումները:</translation>
<translation id="137466361146087520">GTX Browser Բետա</translation>
<translation id="1399397803214730675">Այս համակարգչում արդեն տեղադրված է GTX Browser-ի ավելի նոր տարբերակը: Եթե ծրագիրը չի աշխատում, ապատեղադրեք GTX Browser-ը և նորից փորձեք:</translation>
<translation id="1434626383986940139">GTX Browser Canary հավելվածներ</translation>
<translation id="1507198376417198979">Կարգավորեք GTX Browser-ի նոր պրոֆիլը</translation>
<translation id="1516530951338665275">Զուգակցումը շարունակելու համար GTX Browser-ին հասանելի դարձրեք Bluetooth-ը։ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1553358976309200471">Թարմացնել GTX Browser-ը</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" />-ն արդեն մուտք է գործել GTX Browser-ի այս պրոֆիլը։ <ph name="USER_EMAIL_ADDRESS" /> օգտատիրոջ համար կստեղծվի GTX Browser-ի նոր պրոֆիլ։</translation>
<translation id="1587223624401073077">GTX Browser-ն օգտագործում է ձեր տեսախցիկը:</translation>
<translation id="1587325591171447154"><ph name="FILE_NAME" /> ֆայլը վտանգավոր է, և GTX Browser-ն արգելափակել է այն։</translation>
<translation id="1597911401261118146">Որպեսզի պաշտպանեք ձեր գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ GTX Browser դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="1619887657840448962">GTX Browser-ն ավելի ապահով դարձնելու համար հետևյալ ընդլայնումներն անջատվել են, որոնք նշված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="1628000112320670027">GTX Browser-ի օգնության էջ</translation>
<translation id="1674870198290878346">Բացել հղումը GTX Browser-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="1682634494516646069">GTX Browser-ը չի կարող կարդալ և գրել <ph name="USER_DATA_DIRECTORY" /> տվյալների գրացուցակում:</translation>
<translation id="1698376642261615901">GTX Browser-ը վեբէջերն ու հավելվածները կայծակի արագությամբ բացող դիտարկիչ է: Այն հուսալի է և պարզ գործածության մեջ: Այժմ աշխատանքը համացանցում ավելի ապահով է՝ շնորհիվ GTX Browser-ում վնասագրերի և խաբկայքերի դեմ ներկառուցված պաշտպանության:</translation>
<translation id="1713301662689114961">{0,plural, =1{GTX Browser-ը կվերագործարկվի մեկ ժամից}one{GTX Browser-ը կվերագործարկվի # ժամից}other{GTX Browser-ը կվերագործարկվի # ժամից}}</translation>
<translation id="1734234790201236882">GTX Browser-ը կպահի այս գաղտնաբառը ձեր Google հաշվում: Գաղտնաբառը հիշելու կարիք չի լինի:</translation>
<translation id="174539241580958092">GTX Browser-ը չկարողացավ համաժամացնել ձեր տվյալները՝ մուտք գործելիս տեղի ունեցած սխալի պատճառով:</translation>
<translation id="1759842336958782510">GTX Browser</translation>
<translation id="1786003790898721085">Համոզվեք, որ մուտք եք գործել հաշիվ <ph name="TARGET_DEVICE_NAME" /> սարքի GTX Browser դիտարկիչում և փորձեք նորից ուղարկել։</translation>
<translation id="1812689907177901597">Անջատելով այս գործառույթը՝ դուք կարող եք մտնել հաշիվ Google-ի կայքերում, օրինակ՝ Gmail, առանց մուտք գործելու GTX Browser:</translation>
<translation id="1860536484129686729">GTX Browser-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="1873233029667955273">GTX Browser-ը ձեր կանխադրված դիտարկիչը չէ</translation>
<translation id="1874309113135274312">GTX Browser Բետա (mDNS-In)</translation>
<translation id="1877026089748256423">GTX Browser-ը հնացած է</translation>
<translation id="1919130412786645364">Թույլատրել մուտքը GTX Browser-ում</translation>
<translation id="2018528049276128029">Յուրաքանչյուր պրոֆիլում առանձին պահվում են GTX Browser-ի օգտատերերի տվյալները, օրինակ՝ էջանիշները, պատմությունը, գաղտնաբառերը և այլն</translation>
<translation id="2063848847527508675">Թարմացումը կիրառելու համար հարկավոր է վերագործարկել GTX Browser OS-ը:</translation>
<translation id="2094919256425865063">Փակե՞լ GTX Browser-ը։</translation>
<translation id="2120620239521071941"><ph name="ITEMS_COUNT" /> տարր ձեր սարքից կջնջվի: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք GTX Browser <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2121284319307530122">Վերագործարկել՝ &amp;GTX Browser-ը թարմացնելու համար</translation>
<translation id="2123055963409958220">Օգնեք կատարելագործել GTX Browser-ը՝ հաղորդելով <ph name="BEGIN_LINK" />ընթացիկ կարգավորումների<ph name="END_LINK" /> մասին</translation>
<translation id="2151406531797534936">Վերագործարկեք GTX Browser-ը</translation>
<translation id="2189289170880510015">Անհատականացրեք GTX Browser-ի գաղտնիության կարևորագույն կարգավորումները</translation>
<translation id="2258103955319320201">GTX Browser դիտարկիչի ձեր տվյալները ձեր բոլոր սարքերում օգտագործելու համար մտեք հաշիվ և միացրեք համաժամացումը</translation>
<translation id="2290014774651636340">Google API-ի բանալիները չկան: GTX Browser-ի որոշ գործառույթներ կանջատվեն:</translation>
<translation id="2290095356545025170">Իսկապե՞ս հեռացնել GTX Browser-ը:</translation>
<translation id="2309047409763057870">Սա GTX Browser-ի երկրորդային տեղադրումն է: Այն չի կարող դառնալ ձեր կանխադրված դիտարկիչը:</translation>
<translation id="2345992953227471816">GTX Browser-ը այս ընդլայնումներում վնասագիր է հայտնաբերել՝</translation>
<translation id="2348335408836342058">GTX Browser-ին այս կայքի համար անհրաժեշտ է ձեր տեսախցիկն ու խոսափողը օգտագործելու թույլտվություն</translation>
<translation id="234869673307233423">GTX Browser-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Փորձեք ավելի ուշ։</translation>
<translation id="235650106824528204">Աշխատանքային պրոֆիլի ադմինիստրատորը կարող է ջնջել GTX Browser-ի բոլոր տվյալները, որոնք ստեղծվում են այս պրոֆիլի օգտագործման ընթացքում (օրինակ՝ էջանիշներ, պատմություն, գաղտնաբառեր և այլ կարգավորումներ)։ <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">Շարունակել</translation>
<translation id="2429317896000329049">GTX Browser-ը չկարողացավ համաժամացնել ձեր տվյալները, քանի որ Sync ծառայությունը մատչելի չէ ձեր տիրույթի համար:</translation>
<translation id="2467438592969358367">GTX Browser-ն ուզում է արտահանել ձեր գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="2485422356828889247">Ապատեղադրել</translation>
<translation id="2534507159460261402">Google Pay (պատճենվել է GTX Browser-ում)</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> օգտատերն արդեն մուտք է գործել GTX Browser-ի այս պրոֆիլը։ Ձեր դիտարկումների պատմությունն առանձին պահելու համար կարող եք GTX Browser-ի առանձին պրոֆիլ ստեղծել։</translation>
<translation id="2580411288591421699">Հնարավոր չէ տեղադրել GTX Browser-ի նույն տարբերակը, որն արդեն աշխատում է: Փակեք GTX Browser-ը և նորից փորձեք:</translation>
<translation id="2586406160782125153">Ձեր այցելությունների պատմությունը կջնջվի այս սարքից: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք GTX Browser <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="2622559029861875898">GTX Browser-ը չի կարող ստուգել թարմացումների առկայությունը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="2644798301485385923">GTX Browser OS համակարգ</translation>
<translation id="2652691236519827073">Բացել հղումը GTX Browser-ի նոր &amp;ներդիրում</translation>
<translation id="2665296953892887393">Օգնեք բարելավել GTX Browser-ը՝ ուղարկելով խափանումների մասին հաշվետվությունները և <ph name="UMA_LINK" />-ը Google-ին</translation>
<translation id="2689103672227170538">Այս ընդլայնումը փոխել է GTX Browser-ի մեկնարկի ժամանակ ցուցադրվող էջը:</translation>
<translation id="2742320827292110288">Ուշադրություն. GTX Browser-ը չի կարող արգելել ընդլայնումներին գրանցել ձեր այցելությունների պատմությունը։ Ընդլայնումն ինկոգնիտո ռեժիմում անջատելու համար ապանշեք այս պարամետրը։</translation>
<translation id="2765403129283291972">GTX Browser-ին այս կայքի համար անհրաժեշտ է ձեր խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="2770231113462710648">Կանխադրված դիտարկիչը դարձնել՝</translation>
<translation id="2775140325783767197">GTX Browser-ը չի կարող ստուգել ձեր գաղտնաբառերը։ Ստուգեք ինտերնետ կապը։</translation>
<translation id="2799223571221894425">Վերագործարկել</translation>
<translation id="2847461019998147611">GTX Browser-ը ցուցադրել այս լեզվով</translation>
<translation id="2857540653560290388">GTX Browser-ի գործարկում...</translation>
<translation id="2857972467023607093">Այս հաշվի հետ կապված GTX Browser-ի պրոֆիլ արդեն գոյություն ունի</translation>
<translation id="2861074815332034794">GTX Browser-ի թարմացում (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">Դուք մուտք եք գործել GTX Browser:</translation>
<translation id="2885378588091291677">Task Manager</translation>
<translation id="2888126860611144412">GTX Browser-ի մասին</translation>
<translation id="2926676257163822632">Թույլ գաղտնաբառերը հեշտ է գուշակել։ Թույլատրեք GTX Browser-ին <ph name="BEGIN_LINK" />գաղտնաբառեր ստեղծել և պահել ձեզ համար<ph name="END_LINK" />։</translation>
<translation id="2926952073016206995">Այս կայքի համար GTX Browser-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="2929907241665500097">Անհայտ սխալի պատճառով չհաջողվեց թարմացնել GTX Browser-ը։ <ph name="BEGIN_LINK" />Շտկել GTX Browser-ի թարմացման հետ կապված խնդիրները<ph name="END_LINK" /></translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" />– Ցանցի մուտք – GTX Browser</translation>
<translation id="3037838751736561277">GTX Browser-ն աշխատում է ֆոնային ռեժիմում:</translation>
<translation id="3059710691562604940">Անվտանգ դիտարկումն անջատված է։ GTX Browser-ը խորհուրդ է տալիս միացնել այն։</translation>
<translation id="3065168410429928842">GTX Browser-ի ներդիր</translation>
<translation id="3069821012350118710">Ձեր տվյալները կպահվեն այցելած կայքերում այնքան ժամանակ, մինչև կփակեք GTX Browser-ը։</translation>
<translation id="3080151273017101988">GTX Browser-ը փակելուց հետո շարունակել հավելվածների աշխատանքը հետնաշերտում</translation>
<translation id="3089968997497233615">Մատչելի է GTX Browser-ի նոր, ավելի ապահով տարբերակը:</translation>
<translation id="3100998948628680988">Անվանեք ձեր GTX Browser պրոֆիլը</translation>
<translation id="3114643501466072395">Որպեսզի պաշտպանեք ձեր մյուս գաղտնաբառերը տվյալների արտահոսքից և խուսափեք անվտանգության հետ կապված այլ խնդիրներից, <ph name="BEGIN_LINK" />մտեք հաշիվ GTX Browser դիտարկիչում<ph name="END_LINK" />։</translation>
<translation id="3140883423282498090">Ձեր փոփոխություններն ուժի մեջ կմտնեն հաջորդ անգամ GTX Browser-ը գործարկելիս:</translation>
<translation id="3149510190863420837">GTX Browser-ի հավելվածներ</translation>
<translation id="3360895254066713204">GTX Browser Helper</translation>
<translation id="3379938682270551431">{0,plural, =0{GTX Browser-ը հիմա կվերագործարկվի}=1{GTX Browser-ը կվերագործարկվի 1 վայրկյանից}one{GTX Browser-ը կվերագործարկվի # վայրկյանից}other{GTX Browser-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="3395323229510056640">GTX Browser OS-ի օգնության էջ</translation>
<translation id="3396977131400919238">Տեղադրման ժամանակ օպերացիոն համակարգի սխալ տեղի ունեցավ: Նորից ներբեռնեք GTX Browser-ը:</translation>
<translation id="3428747202529429621">Ապահովում է ձեր անվտանգությունը GTX Browser-ում և Google հավելվածներում, երբ մտել եք ձեր հաշիվ</translation>
<translation id="3434246496373299699">GTX Browser-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ մտնեք ձեր Google հաշիվ։</translation>
<translation id="3451115285585441894">Ավելացվում է GTX Browser-ին…</translation>
<translation id="345171907106878721">Ավելացնել GTX Browser-ի օգտատիրոջ</translation>
<translation id="34857402635545079">Մաքրել նաև GTX Browser-ի տվյալները (<ph name="URL" />)</translation>
<translation id="3503306920980160878">GTX Browser-ին այս կայքի համար անհրաժեշտ է ձեզ տեղորոշելու թույլտվություն</translation>
<translation id="3533694711092285624">Պահված գաղտնաբառեր չկան։ GTX Browser-ը կարող է ստուգել ձեր գաղտնաբառերը, երբ պահում եք դրանք։</translation>
<translation id="3541482654983822893">GTX Browser-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք։</translation>
<translation id="3576528680708590453">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել GTX Browser-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի մեկ այլ դիտարկիչով:</translation>
<translation id="3582972582564653026">Համաժամացրեք և անհատականացրեք GTX Browser-ը ձեր բոլոր սարքերում</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել GTX Browser-ը}=1{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել GTX Browser-ը: Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել GTX Browser-ը: Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Թարմացումը կիրառելու համար ադմինիստրատորը պահանջում է վերագործարկել GTX Browser-ը: Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="3622797965165704966">Այժմ ավելի հեշտ է օգտագործել GTX Browser-ը ձեր Google հաշվի հետ, այդ թվում նաև համօգտագործվող համակարգիչներով:</translation>
<translation id="3673813398384385993">GTX Browser-ը «<ph name="EXTENSION_NAME" />» ընդլայնման մեջ վնասագիր է հայտնաբերել</translation>
<translation id="3678552270983184277">GTX Browser-ի կանխադրված կարգավորումները նախատեսված են մարդկանց մեծամասնության համար, սակայն դուք կարող եք դրանք անհատականացնել։</translation>
<translation id="3718181793972440140">1 տարր ձեր սարքից կջնջվի: Հետագայում ձեր տվյալներն առբերելու համար մուտք գործեք GTX Browser <ph name="USER_EMAIL" /> հաշվով:</translation>
<translation id="3735758079232443276">«<ph name="EXTENSION_NAME" />» ընդլայնումը փոխել է GTX Browser-ի մեկնարկի ժամանակ ցուցադրվող էջը:</translation>
<translation id="3779473566290487688">GTX Browser-ի հետագա թարմացումները ստանալու համար ձեզ անհրաժեշտ է OS X 10.11 կամ ավելի նոր տարբերակ։ Այս համակարգիչն օգտագործում է OS X 10.10 տարբերակը։</translation>
<translation id="3780814664026482060">GTX Browser – <ph name="PAGE_TITLE" /></translation>
<translation id="3835168907083856002"><ph name="USER_EMAIL_ADDRESS" /> օգտատիրոջ համար կստեղծվի GTX Browser-ի նոր պրոֆիլ։</translation>
<translation id="386202838227397562">Փակեք GTX Browser-ի բոլոր պատուհանները և նորից փորձեք:</translation>
<translation id="3865754807470779944">Տեղադրված է GTX Browser-ի <ph name="PRODUCT_VERSION" /> տարբերակը</translation>
<translation id="3873044882194371212">Բացել հղումը GTX Browser-ի ինկ&amp;ոգնիտո պատուհանում</translation>
<translation id="3889417619312448367">Ապատեղադրել GTX Browser-ը</translation>
<translation id="4050175100176540509">Վերջին տարբերակում առկա են անվտանգության կարևոր բարելավումներ և նոր գործառույթներ:</translation>
<translation id="4053720452172726777">Հարմարեցնել և վերահսկել GTX Browser-ը</translation>
<translation id="4110895483821904099">Կարգավորեք GTX Browser-ի ձեր նոր պրոֆիլը</translation>
<translation id="4147555960264124640">Դուք մուտք եք գործում վերահսկվող հաշիվ` թույլ տալով ադմինիստրատորին վերահսկել ձեր GTX Browser պրոֆիլը: Ձեր GTX Browser տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և այլ կարգավորումները, մշտապես կկցվեն <ph name="USER_NAME" />-ին: Դուք կարող եք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարող համակցել դրանք այլ հաշվի հետ: <ph name="LEARN_MORE" /></translation>
<translation id="4149882025268051530">Տեղադրիչը չկարողացավ բացել արխիվը: Նորից ներբեռնեք GTX Browser-ը:</translation>
<translation id="4191857738314598978">{0,plural, =1{Վերագործարկեք GTX Browser-ը մեկ օրվա ընթացքում}one{Վերագործարկեք GTX Browser-ը # օրվա ընթացքում}other{Վերագործարկեք GTX Browser-ը # օրվա ընթացքում}}</translation>
<translation id="4205939740494406371">GTX Browser-ը չի կարող ստուգել ձեր գաղտնաբառերը։ 24 ժամ հետո նորից փորձեք կամ <ph name="BEGIN_LINK" />ստուգեք ձեր Google հաշվի գաղտնաբառերը<ph name="END_LINK" />։</translation>
<translation id="4242034826641750751">Այս կայքի համար GTX Browser-ին անհրաժեշտ է խոսափողն ու տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="424864128008805179">Դուրս գա՞լ GTX Browser-ից:</translation>
<translation id="4251615635259297716">Կապե՞լ ձեր GTX Browser-ի տվյալներն այս հաշվի հետ:</translation>
<translation id="4281844954008187215">Օգտագործման պայմաններ</translation>
<translation id="4293420128516039005">Մտեք հաշիվ՝ GTX Browser-ը ձեր բոլոր սարքերում անհատականացնելու համար</translation>
<translation id="4325083532956419387">GTX Browser OS-ի տարբերակը</translation>
<translation id="4328355335528187361">GTX Browser Dev (mDNS-In)</translation>
<translation id="4331809312908958774">GTX Browser OS</translation>
<translation id="4335235004908507846">GTX Browser-ը կարող է պաշտպանել տվյալների արտահոսքից, վնասաբեր ընդլայնումներից և այլ խնդիրներից</translation>
<translation id="4343195214584226067"><ph name="EXTENSION_NAME" /> ընդլայնումն ավելացվել է GTX Browser-ին</translation>
<translation id="4384570495110188418">GTX Browser-ը չի կարող ստուգել ձեր գաղտնաբառերը, քանի որ դուք հաշիվ չեք մտել։</translation>
<translation id="4407807842708586359">GTX Browser OS</translation>
<translation id="4427306783828095590">Լրացուցիչ պաշտպանությունն օգնում է խուսափել ֆիշինգից և արգելափակել վնասաբեր ծրագրերը</translation>
<translation id="4450664632294415862">GTX Browser – Ցանցի մուտքի էջ – <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">GTX Browser-ում տեղադրման մեկ այլ գործողություն ընթացքի մեջ է: Փորձեք ավելի ուշ:</translation>
<translation id="4480040274068703980">Մուտքի սխալի պատճառով GTX Browser OS-ը չկարողացավ համաժամացնել ձեր տվյալները:</translation>
<translation id="4521185804071812304">Ըստ ցանկության. օգնեք ավելի լավը դարձնել GTX Browser OS-ի գործառույթներն ու աշխատանքը՝ Google-ին ավտոմատ ուղարկելով օգտագործման և դիագնոստիկ տվյալները։</translation>
<translation id="4561051373932531560">GTX Browser-ը թույլ է տալիս սեղմելով կայքում գտնվող հեռախոսահամարի վրա՝ զանգահարել այդ համարին Skype-ի միջոցով:</translation>
<translation id="4567424176335768812">Դուք մուտք եք գործել որպես <ph name="USER_EMAIL_ADDRESS" />: Այժմ կարող եք օգտագործել ձեր էջանիշները, պատմությունը և այլ կարգավորումները ձեր բոլոր մուտք գործած սարքերում:</translation>
<translation id="4571503333518166079">Անցնել GTX Browser-ի ծանուցումների կարգավորումներ</translation>
<translation id="459622048091363950">Երբ GTX Browser-ը հասանելիություն ստանա, կայքերը կկարողանան ձեզնից հասանելիություն խնդրել։</translation>
<translation id="4600710005438004015">Չհաջողվեց տեղադրել GTX Browser-ի վերջին տարբերակը, որը թարմացվել է նոր գործառույթներով և անվտանգության բարելավումներով:</translation>
<translation id="4633000520311261472">GTX Browser-ն ավելի ապահով դարձնելու համար անջատվել են որոշ ընդլայնումներ, որոնք թվարկված չեն <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ում և կարող են ավելացված լինել առանց ձեր իմացության։</translation>
<translation id="4728575227883772061">Տեղադրումը չհաջողվեց անհայտ սխալի պատճառով: Եթե GTX Browser-ն այս պահին բաց է, փակեք այն և նորից փորձեք:</translation>
<translation id="4754614261631455953">GTX Browser Canary (mDNS-In)</translation>
<translation id="4771048833395599659">Այս ֆայլը կարող է վտանգավոր լինել, և GTX Browser-ն արգելափակել է այն։</translation>
<translation id="479167709087336770">Օգտագործվում է միևնույն ուղղագրիչը, ինչ Google Որոնման մեջ: Դիտարկիչում մուտքագրված տեքստերն ուղարկվում են Google-ին: Սա կարող եք փոխել կարգավորումներում։</translation>
<translation id="4891791193823137474">Թույլ տալ GTX Browser-ին աշխատել հետնաշերտում</translation>
<translation id="4895437082222824641">Բացել հղումը GTX Browser-ի նոր &amp;ներդիրում</translation>
<translation id="4953650215774548573">Դարձնել GTX Browser-ը կանխադրված դիտարկիչը</translation>
<translation id="495931528404527476">GTX Browser-ում</translation>
<translation id="4970761609246024540">Բարի գալուստ GTX Browser-ի պրոֆիլներ</translation>
<translation id="4990567037958725628">GTX Browser Canary</translation>
<translation id="5062123544085870375">GTX Browser OS-ի վերագործարկում</translation>
<translation id="5132929315877954718">Հավելվածների, խաղերի, ընդլայնումների և թեմաների լայն ընտրանի GTX Browser-ի համար:</translation>
<translation id="5139423532931106058">Անհատականացնել GTX Browser-ի պրոֆիլը</translation>
<translation id="5163087008893166964">Բարի գալուստ GTX Browser․ բացված է դիտարկիչի նոր պատուհան</translation>
<translation id="5170938038195470297">Դուք չեք կարող օգտագործել ձեր պրոֆիլը, քանի որ այն GTX Browser-ի նոր տարբերակով է:

Որոշ գործառույթներ մատչելի չեն լինի: Նշեք պրոֆիլի այլ գրացուցակ կամ օգտագործեք GTX Browser-ի նոր տարբերակը:</translation>
<translation id="5193136243808726294">GTX Browser OS-ը չի կարող բացել այս էջը:</translation>
<translation id="521447420733633466">Եթե ձեզնից բացի որևէ այլ օգտատեր օգտվում է այս սարքից (օրինակ՝ ձեր ընկերները կամ հարազատները), ապա նրանք կարող են առանձին աշխատել և անհատականացնել GTX Browser-ը</translation>
<translation id="5251420635869119124">Հյուրերը կարող են օգտագործել GTX Browser-ն առանց հետքեր թողնելու:</translation>
<translation id="5251679006894510177">Գրեթե պատրաստ է։ Վերագործարկեք GTX Browser-ը՝ թարմացումն ավարտելու համար։ Ինկոգնիտո պատուհանները նորից չեն բացվի։</translation>
<translation id="5334487786912937552">Ֆայլեր ներբեռնելու համար GTX Browser-ին անհրաժեշտ է հիշողությունն օգտագործելու թույլտվություն</translation>
<translation id="5386244825306882791">Այն նաև վերահսկում է, թե ինչ էջ պետք է ցուցադրվի GTX Browser-ը մեկնարկելիս կամ Omnibox-ից որոնում կատարելու ժամանակ:</translation>
<translation id="5394833366792865639">Կիսվեք GTX Browser-ի ներդիրով</translation>
<translation id="5430073640787465221">Ձեր նախընտրանքների ֆայլը վնասված է կամ անվավեր:

GTX Browser-ը չի կարողանում վերականգնել ձեր կարգավորումները:</translation>
<translation id="556024056938947818">GTX Browser-ը փորձում է ցույց տալ գաղտնաբառերը:</translation>
<translation id="5566025111015594046">GTX Browser (mDNS-In)</translation>
<translation id="5657226924540934362">Եթե որևէ կարգավորում չտեսնեք այս էջում, փնտրեք այն ձեր <ph name="LINK_BEGIN" />
      GTX Browser OS-ի կարգավորումներում<ph name="LINK_END" /></translation>
<translation id="565744775970812598"><ph name="FILE_NAME" /> ֆայլը կարող է վտանգավոր լինել, և GTX Browser-ն արգելափակել է այն։</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել GTX Browser-ը}=1{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել GTX Browser-ը: Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել GTX Browser-ը: Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{Այս թարմացումը կիրառելու համար ադմինիստրատորը խնդրում է վերագործարկել GTX Browser-ը: Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="5686916850681061684">GTX Browser-ի կարգավորման և կառավարման համար անհրաժեշտ է ձեր ուշադրությունը։ Սեղմեք՝ մանրամասներին ծանոթանալու համար։</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5715063361988620182">{SECONDS,plural, =1{GTX Browser-ը կվերագործարկվի 1 վայրկյանից}one{GTX Browser-ը կվերագործարկվի # վայրկյանից}other{GTX Browser-ը կվերագործարկվի # վայրկյանից}}</translation>
<translation id="5736850870166430177">Եթե կայքը փորձում է գողանալ ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, GTX Browser-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ Ապահով դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="573759479754913123">GTX Browser OS-ի մասին</translation>
<translation id="5756509061973259733">Այս հաշվի հետ կապված GTX Browser-ի պրոֆիլ արդեն գոյություն ունի այս սարքում</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> – GTX Browser Canary</translation>
<translation id="5804318322022881572">Չհաջողվեց գործարկել GTX Browser-ը։ Նորից փորձեք։</translation>
<translation id="5867197326698922595">GTX Browser-ը փորձում է փոխել գաղտնաբառերը:</translation>
<translation id="5895138241574237353">Վերագործարկել</translation>
<translation id="5901850848447342934">Երբ փակեք GTX Browser-ը, դուք <ph name="BEGIN_BOLD" />դուրս կգաք կայքերի մեծամասնությունից<ph name="END_BOLD" />։ Եթե համաժամացումն անջատված է, դուք նաև <ph name="BEGIN_BOLD" />դուրս կգաք Google-ի ծառայություններից և GTX Browser-ից<ph name="END_BOLD" />։</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> – Ցանցի մուտք</translation>
<translation id="5940385492829620908">Ձեր վեբ էջերը, էջանիշները և GTX Browser-ի մնացած տվյալներն այստեղ են:</translation>
<translation id="5941830788786076944">Դարձնել GTX Browser-ը կանխադրված դիտարկիչը</translation>
<translation id="6070348360322141662">Լրացուցիչ անվտանգության համար GTX Browser-ը կգաղտնագրի ձեր տվյալները</translation>
<translation id="608006075545470555">Աշխատանքային պրոֆիլի ավելացում այս դիտարկիչում</translation>
<translation id="608496399798299674">CloudReady 2.0</translation>
<translation id="6113794647360055231">GTX Browser-ը բարելավվել է</translation>
<translation id="6145313976051292476">Բացել PDF ֆայլեր GTX Browser-ում</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - GTX Browser</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> – GTX Browser բետա</translation>
<translation id="6235018212288296708">Թույլատրել GTX Browser-ում մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="6291089322031436445">GTX Browser Dev հավելվածներ</translation>
<translation id="6291549208091401781">GTX Browser-ն արդեն տեղադրված է ձեր համակարգչում բոլոր օգտատերերի համար:</translation>
<translation id="6368958679917195344">GTX Browser OS-ն ստեղծվել է շնորհիվ լրացուցիչ <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" />:</translation>
<translation id="6412673304250309937">Ստուգում է URL-ները GTX Browser-ում պահված վտանգավոր կայքերի ցանկի միջոցով։ Եթե կայքը փորձում է հափշտակել ձեր գաղտնաբառը, կամ երբ վնասակար ֆայլ եք ներբեռնում, GTX Browser-ը կարող է ուղարկել URL-ն ու էջի բովանդակությունը՝ անվտանգ դիտարկման միջոցով ստուգելու համար։</translation>
<translation id="6418662306461808273">Անցնե՞լ GTX Browser-ի առկա պրոֆիլ</translation>
<translation id="6506909944137591434">Ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար GTX Browser-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> – GTX Browser Dev</translation>
<translation id="6568793831116033768">GTX Browser OS համակարգ</translation>
<translation id="6594121454516132231">Դիտեք, թե ինչպես է Chromе-ը պաշտպանելու ձեզ գործողությունների միջկայքային հետագծման մեխանիզմներից</translation>
<translation id="6676384891291319759">Մտնել համացանց</translation>
<translation id="6679975945624592337">Թույլատրել GTX Browser-ին աշխատել ֆոնային ռեժիմում</translation>
<translation id="6696915334902295848">Այս կայքի համար GTX Browser-ին անհրաժեշտ է խոսափողն օգտագործելու թույլտվություն</translation>
<translation id="6739177684496155661">Շարունակե՞լ GTX Browser-ի նոր պրոֆիլով</translation>
<translation id="6750954913813541382">Ուղղագրական սխալները շտկելու համար GTX Browser-ը Google-ին է ուղարկում դիտարկիչում ձեր մուտքագրած տեքստը</translation>
<translation id="677276454032249905">Փակե՞լ GTX Browser-ը։</translation>
<translation id="683440813066116847">Թույլատրել GTX Browser Canary-ում տվյալների մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="6881299373831449287">GTX Browser-ի թարմացում</translation>
<translation id="6885412569789873916">GTX Browser Բետա հավելվածներ</translation>
<translation id="6943584222992551122">Այս օգտատիրոջ այցելությունների պատմությունը կջնջվի սարքից։ Տվյալները վերականգնելու համար GTX Browser դիտարկիչում մուտք գործեք <ph name="USER_EMAIL" /> հաշվով։</translation>
<translation id="6967962315388095737">Թույլատրել GTX Browser Բետայում մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="6989339256997917931">GTX Browser-ը թարմացվել է, բայց դուք չեք օգտագործել այն առնվազն 30 օր:</translation>
<translation id="7025800014283535195">Այստեղ կարող եք անցնել GTX Browser-ի այլ պրոֆիլի</translation>
<translation id="7062128746136194023">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը GTX Browser-ում։ Այս <ph name="EXTENSION_TYPE_PARAMETER" />ն արգելափակված է և չի կարող ավելացվել։</translation>
<translation id="7085332316435785646">Ընտրեք, թե արդյոք ներառել Chromе-ի պատմությունը՝ Google-ի ծառայությունների ավելի անհատականացված օգտագործման համար։</translation>
<translation id="7088681679121566888">GTX Browser-ը թարմացված է</translation>
<translation id="7098166902387133879">GTX Browser-ն օգտագործում է ձեր խոսափողը:</translation>
<translation id="7106741999175697885">Խնդիրների կառավարիչ - GTX Browser</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{GTX Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։}=1{GTX Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր ինկոգնիտո պատուհանը նորից չի բացվի։}one{GTX Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանը նորից չի բացվի։}other{GTX Browser-ի այս տարբերակի համար առկա է թարմացում: Այն կտեղադրվի, երբ դիտարկիչը վերագործարկվի։ Ձեր # ինկոգնիտո պատուհանները նորից չեն բացվի։}}</translation>
<translation id="7155997830309522122">Եթե այո, ապա փոխեք ձեր պահված գաղտնաբառը GTX Browser-ում, որպեսզի այն համապատասխանի ձեր նոր գաղտնաբառին։</translation>
<translation id="7161904924553537242">Բարի գալուստ GTX Browser</translation>
<translation id="7242029209006116544">Դուք մուտք եք գործում վերահսկվող հաշիվ՝ թույլ տալով ադմինիստրատորին կառավարել ձեր GTX Browser պրոֆիլը: Ձեր GTX Browser-ի տվյալները, ինչպես օրինակ՝ հավելվածները, էջանիշները, պատմությունը, գաղտնաբառերը և մյուս կարգավորումները, մշտապես կկցվեն <ph name="USER_NAME" /> հաշվին: Դուք կկարողանաք ջնջել այս տվյալները Google Dashboard-ի միջոցով, սակայն չեք կարողանա համակցել դրանք այլ հաշվի հետ: Որպես տարբերակ կարող եք ստեղծել նոր պրոֆիլ՝ GTX Browser-ի առկա տվյալներն առանձին պահելու համար: <ph name="LEARN_MORE" /></translation>
<translation id="7295052994004373688">Այս լեզուն օգտագործվում է որպես GTX Browser-ի միջերեսի լեզու</translation>
<translation id="7296210096911315575">Կարևոր տեղեկություններ օգտագործման և անվտանգության մասին</translation>
<translation id="7308322188646931570">Ֆայլեր ներբեռնելու համար GTX Browser-ին անհրաժեշտ է պահեստի օգտագործման թույլտվություն</translation>
<translation id="7339898014177206373">Նոր պատուհան</translation>
<translation id="7398801000654795464">Դուք մուտք եք գործում GTX Browser որպես <ph name="USER_EMAIL_ADDRESS" />: Նորից մուտք գործելու համար օգտագործեք նույն հաշիվը:</translation>
<translation id="7408085963519505752">GTX Browser OS-ի օգտագործման պայմաններ</translation>
<translation id="7419046106786626209">GTX Browser OS-ը չկարողացավ համաժամացնել ձեր տվյալները, քանի որ Sync-ը մատչելի չէ ձեր տիրույթի համար:</translation>
<translation id="7481213027396403996">Ուժեղացրեք GTX Browser-ի անվտանգությունը</translation>
<translation id="7486227612705979895">GTX Browser-ը կօգտագործի ձեր Drive-ը՝ հասցեագոտում հուշումներ ցուցադրելու համար</translation>
<translation id="7535429826459677826">GTX Browser Dev</translation>
<translation id="7573289029918943991">Սարքի ծրագրակազմի տարբերակը տեսնելու համար անցեք <ph name="LINK_BEGIN" />GTX Browser OS-ի կարգավորումներ<ph name="LINK_END" /></translation>
<translation id="7592736734348559088">GTX Browser-ը չկարողացավ համաժամացնել ձեր տվյալները, քանի որ ձեր հաշվի մուտքի տվյալները հնացած են:</translation>
<translation id="7626032353295482388">Բարի գալուստ GTX Browser</translation>
<translation id="7629695634924605473">GTX Browser-ը ձեզ տեղյակ կպահի, եթե ձեր գաղտնաբառերի անվտագությանը սպառնալիք լինի</translation>
<translation id="7641148173327520642">Ձեր համակարգի ադմինիստրատորն այնպես է կարգավորել GTX Browser-ը, որ <ph name="TARGET_URL_HOSTNAME" /> կայքը բացվի <ph name="ALTERNATIVE_BROWSER_NAME" /> դիտարկիչով:</translation>
<translation id="7651907282515937834">GTX Browser Enterprise-ի լոգո</translation>
<translation id="7665553140559834626">Վերագործարկել՝ &amp;GTX Browser OS-ը թարմացնելու համար</translation>
<translation id="7747138024166251722">Տեղադրիչը չկարողացավ ստեղծել ժամանակավոր գրացուցակ: Ստուգեք սկավառակում ազատ տարածքի առկայությունը և ծրագրակազմը տեղադրելու թույլտվությունը:</translation>
<translation id="7748512868279796735">Հետևյալ հաշիվները հասանելի են այս Chromе պրոֆիլի համար</translation>
<translation id="7761834446675418963">GTX Browser-ը բացելու և աշխատանքն սկսելու համար սեղմեք ձեր անվան վրա:</translation>
<translation id="7777080907402804672">Եթե պատկերն օգտակար նկարագրություն չունի, GTX Browser-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։ Ցանկացած պահի կարգավորումներում կարող եք անջատել սա:</translation>
<translation id="7781002470561365167">GTX Browser-ի նոր տարբերակը մատչելի է:</translation>
<translation id="778331955594035129">Այս կայքի համար GTX Browser-ին անհրաժեշտ է տեղորոշումն օգտագործելու թույլտվություն</translation>
<translation id="7787950393032327779">Պրոֆիլն օգտագործվում է GTX Browser-ի մեկ այլ գործընթացում (<ph name="PROCESS_ID" />)՝ ուրիշ համակարգչում (<ph name="HOST_NAME" />): GTX Browser-ը կողպել է պրոֆիլը, որպեսզի այն չվնասվի: Եթե համոզված եք, որ պրոֆիլը չի օգտագործվում այլ գործընթացներում, կարող եք ապակողպել այն և նորից գործարկել GTX Browser-ը:</translation>
<translation id="7801699035218095297">GTX Browser-ը փորձում է պատճենել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="7808348361785373670">Հեռացնել GTX Browser-ից...</translation>
<translation id="7825851276765848807">Տեղադրումը չհաջողվեց անհայտ սխալի պատճառով: Նորից ներբեռնեք GTX Browser-ը:</translation>
<translation id="7890208801193284374">Եթե դուք համակարգիչն օգտագործում եք ընկերների ու ընտանիքի անդամների հետ, նրանք կարող են առանձին աշխատել համացանցում և կարգավորել GTX Browser-ը՝ իրենց ուզած ձևով:</translation>
<translation id="7896673875602241923">Ինչ-որ մեկն այս համակարգչում <ph name="ACCOUNT_EMAIL_LAST" /> հասցեով մուտք է գործել GTX Browser: Ստեղծեք GTX Browser-ի նոր պրոֆիլ` ձեր տվյալներն առանձին պահելու համար:</translation>
<translation id="7917876797003313048">Դուք կարող եք կառավարել ձեր Google հաշիվները, որոնցում մուտք եք գործել։ Դրանք օգտագործվում են GTX Browser դիտարկիչում, Play Խանութում, Gmail-ում և այլ ծառայություններում։ Եթե ուզում եք ընտանեկան խմբի անդամի կամ մեկ ուրիշի համար հաշիվ ավելացնել, <ph name="DEVICE_TYPE" /> սարքում ավելացրեք նոր օգտատեր։ <ph name="LINK_BEGIN" />Իմանալ ավելին<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">GTX Browser-ը փորձում է պատճենել գաղտնաբառերը:</translation>
<translation id="7962410387636238736">Այս համակարգիչն այլևս չի ստանա GTX Browser-ի թարմացումներ, քանի որ Windows XP և Windows Vista համակարգերն այլևս չեն աջակցվում</translation>
<translation id="79947657522496226">GTX Browser OS-ը ստեղծվել է <ph name="BEGIN_LINK_CROS_OSS" />բաց կոդով ծրագրակազմի<ph name="END_LINK_CROS_OSS" /> հիման վրա, ինչպիսին է <ph name="BEGIN_LINK_LINUX_OSS" />Լինուքսի մշակման միջավայրը<ph name="END_LINK_LINUX_OSS" />։</translation>
<translation id="8008534537613507642">Նորից տեղադրել GTX Browser-ը</translation>
<translation id="8013993649590906847">Եթե պատկերն օգտակար նկարագրություն չունի, GTX Browser-ը կփորձի նոր նկարագրություն տրամադրել: Պատկերներն ուղարկվում են Google-ին՝ նկարագրություններ ստեղծելու համար։</translation>
<translation id="8129812357326543296">&amp;GTX Browser-ի մասին</translation>
<translation id="8255190535488645436">GTX Browser-ն օգտագործում է ձեր տեսախցիկն ու խոսափողը:</translation>
<translation id="8286862437124483331">GTX Browser-ը փորձում է ցույց տալ գաղտնաբառերը: Այս գործողությունը թույլատրելու համար մուտքագրեք ձեր Windows գաղտնաբառը:</translation>
<translation id="828798499196665338">Ձեր ծնողն անջատել է «Թույլտվություններ կայքերի, հավելվածների և ընդլայնումների համար» պարամետրը GTX Browser-ում։ Այս <ph name="EXTENSION_TYPE_PARAMETER" />ն արգելափակված է և չի կարող միացվել։</translation>
<translation id="8290100596633877290">GTX Browser-ը խափանվեց: Գործարկե՞լ նորից:</translation>
<translation id="8342675569599923794">Այս ֆայլը վտանգավոր է, և GTX Browser-ն արգելափակել է այն։</translation>
<translation id="8370517070665726704">© Google LLC <ph name="YEAR" />։ Բոլոր իրավունքները պահպանված են:</translation>
<translation id="8394720698884623075">Ստուգում է URL-ները GTX Browser-ում պահված վտանգավոր կայքերի ցանկի միջոցով։</translation>
<translation id="840084489713044809">GTX Browser-ն ուզում է արտահանել ձեր գաղտնաբառերը:</translation>
<translation id="8433638294851456451">Հեռախոսահամարն այստեղից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի GTX Browser դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="8498858610309223613">GTX Browser-ի անվտանգությունն ապահովող հատուկ թարմացումը տեղադրվել է: Վերագործարկեք GTX Browser-ը, և ձեր ներդիրները կվերականգնվեն:</translation>
<translation id="8521348052903287641">Թույլատրել GTX Browser Dev-ում մուտքային հոսքի փոխանցումը mDNS հաղորդակարգով:</translation>
<translation id="8540666473246803645">GTX Browser</translation>
<translation id="8550334526674375523">Այս աշխատանքային պրոֆիլն ամբողջովին առանձնացված է ձեր անձնական պրոֆիլից։</translation>
<translation id="8556340503434111824">GTX Browser-ի նոր տարբերակը մատչելի է և այն շատ ավելի արագ է:</translation>
<translation id="8571790202382503603">Chromе պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օգտատերերից։ Այդպես ավելի հեշտ է տարանջատել գործնական և անձնական նպատակներով օգտագործումը։</translation>
<translation id="8614913330719544658">GTX Browser-ը չի պատասխանում: Վերագործարկե՞լ:</translation>
<translation id="861702415419836452">GTX Browser-ին անհրաժեշտ է տեսախցիկն օգտագործելու թույլտվություն՝ ձեր շրջակայքի եռաչափ քարտեզը ստեղծելու համար։</translation>
<translation id="8625237574518804553">{0,plural, =1{GTX Browser-ը կվերագործարկվի 1 րոպեից}one{GTX Browser-ը կվերագործարկվի # րոպեից}other{GTX Browser-ը կվերագործարկվի # րոպեից}}</translation>
<translation id="8629311577791198377">Երբ փակեք GTX Browser-ի բոլոր պատուհանները, քուքիները և կայքերի տվյալներն ավտոմատ կմաքրվեն։</translation>
<translation id="8641606876632989680">GTX Browser-ը կտեղեկացնի ձեզ, երբ կոտրված գաղտնաբառ օգտագործեք։</translation>
<translation id="8669527147644353129">GTX Browser Helper</translation>
<translation id="8679801911857917785">Այն նաև վերահսկում է GTX Browser-ի մեկնարկման ժամանակ ցուցադրվող էջը:</translation>
<translation id="8686817260976772516">Chromе պրոֆիլների միջոցով դուք կարող եք օգտագործել դիտարկիչն առանձին այլ օտատերերից։ Ստեղծեք պրոֆիլներ ձեր ընկերների և ընտանիքի անդամների, կամ գործնական և անձնական նպատակների համար։</translation>
<translation id="873133009373065397">GTX Browser-ը չի կարողանում որոշել կամ սահմանել կանխադրված դիտարկիչը</translation>
<translation id="8823341990149967727">GTX Browser-ը հնացած է</translation>
<translation id="8834965163890861871">GTX Browser-ը փորձում է փոխել գաղտնաբառերը: Թույլատրելու համար մուտքագրեք Windows-ի ձեր գաղտնաբառը:</translation>
<translation id="884296878221830158">Այն նաև վերահսկում է էջերի ցուցադրումը GTX Browser-ը մեկնարկելիս կամ Սկիզբ կոճակը սեղմելիս:</translation>
<translation id="8862326446509486874">Դուք չունեք համապատասխան իրավունքներ՝ համակարգի մակարդակով տեղադրում կատարելու համար: Փորձեք տեղադրումը կատարել որպես Ադմինիստրատոր:</translation>
<translation id="8914504000324227558">GTX Browser-ի վերագործարկում</translation>
<translation id="8922193594870374009">Հեռախոսահամարը <ph name="ORIGIN" /> կայքից ձեր Android հեռախոսին ուղարկելու համար երկու սարքերի GTX Browser դիտարկիչներում մտեք հաշիվ։</translation>
<translation id="8983720963221508955">Դուք ձեր հաշվում միացրել եք բարելավված Ապահով դիտարկումը։ Այժմ միացրեք այն GTX Browser-ի համար։</translation>
<translation id="8986207147630327271">Դուք ավելացնում եք աշխատանքային պրոֆիլ այս դիտարկիչում և միայն դրա վերահսկողությունը տրամադրում ադմինիստրատորին։</translation>
<translation id="8999208279178790196">{0,plural, =0{Հասանելի է GTX Browser-ի նոր տարբերակը}=1{Հասանելի է GTX Browser-ի նոր տարբերակը}one{GTX Browser-ի նոր տարբերակը # օր է հասանելի է}other{GTX Browser-ի նոր տարբերակը # օր է հասանելի է}}</translation>
<translation id="9026991721384951619">GTX Browser OS-ը չկարողացավ համաժամացնել տվյալները, քանի որ ձեր հաշիվ մուտք գործելու տվյալները հնացած են:</translation>
<translation id="9067395829937117663">GTX Browser-ի համար հարկավոր է Windows 7 կամ ավելի նոր տարբերակ:</translation>
<translation id="911206726377975832">Ջնջե՞լ նաև ձեր դիտարկումների տվյալները:</translation>
<translation id="9138603949443464873">Փոփոխությունները կիրառելու համար վերագործարկեք GTX Browser-ը</translation>
<translation id="919706545465235479">Թարմացրեք GTX Browser-ը՝ համաժամացումը սկսելու համար</translation>
<translation id="922152298093051471">Անհատականացնել GTX Browser-ը</translation>
<translation id="940313311831216333">GTX Browser-ի ձեր տվյալները ձեր բոլոր սարքերում օգտագործելու համար մտեք հաշիվ և միացրեք համաժամացումը։</translation>
<translation id="989369509083708165">GTX Browser-ը ձեր կանխադրված դիտարկիչն է</translation>
<translation id="989816563149873169">GTX Browser-ի այլ պրոֆիլի կարող եք անցնել <ph name="SHORTCUT" /> ստեղների համադրության միջոցով</translation>
</translationbundle>