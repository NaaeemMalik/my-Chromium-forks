<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="mn">
<translation id="1026101648481255140">Үргэлжлүүлэн суулгах</translation>
<translation id="1029669172902658969">&amp;GTX BrowserOS-г шинэчлэхийн тулд дахин ачаална уу</translation>
<translation id="1065672644894730302">Таны хүсэлтийг уншиж чадахгүй байна. 

Зарим үйлдлүүд нь боломжгүй байж магадгүй бөгөөд сонголтонд хийсэн өөрчлөлтүүд хадгалагдахгүй.</translation>
<translation id="1098170124587656448">GTX Browser нь таныг өгөгдлийн зөрчил, муу өргөтгөл болон бусад асуудлаас хамгаалахад туслах боломжтой</translation>
<translation id="1104942323762546749">GTX Browser таны нууц үгийг экспортлох хүсэлтэй байна. Үүнийг зөвшөөрч байгаа бол Windows-н нууц үгээ оруулна уу.</translation>
<translation id="113122355610423240">GTX Browser таны өгөгдмөл хөтөч</translation>
<translation id="1131805035311359397">Нууц үгнүүддээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />GTX Browser-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="1157106475430165622">{NUM_DEVICES,plural, =0{GTX Browser өргөтгөлүүд HID төхөөрөмжүүдэд хандаж байсан}=1{GTX Browser өргөтгөлүүд HID төхөөрөмжүүдэд хандаж байна}other{GTX Browser өргөтгөлүүд # HID төхөөрөмжид хандаж байна}}</translation>
<translation id="1185134272377778587">GTX Browser-ийн тухай</translation>
<translation id="1202417120496358351">{COUNT,plural, =1{GTX Browser-г 1 минутын турш ашиглаагүй үед таны администратор үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}other{GTX Browser-г # минутын турш ашиглаагүй үед таны администратор үүнийг автоматаар хаана. Интернэтээр үзсэн өгөгдлийг устгадаг. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно.}}</translation>
<translation id="1203500561924088507">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="1261119230216066228">Санах ой хэмнэгч нь GTX Browser-г илүү хурдан болгосон</translation>
<translation id="1315551408014407711">GTX Browser-н шинэ профайлаа тохируулах</translation>
<translation id="1414495520565016063">Та GTX Browser руу нэвтэрсэн байна!</translation>
<translation id="1524282610922162960">GTX Browser-н таб хуваалцах</translation>
<translation id="1553461853655228091">Орчин тойрны тань 3D газрын зургийг үүсгэхийн тулд таны камерт хандах зөвшөөрөл GTX Browser-д шаардлагатай</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{Шинэчлэлтийг хэрэгжүүлэхийн тулд GTX Browser-г дахин ачаалахыг таны администратор танаас шаардаж байна}=1{Шинэчлэлтийг хэрэгжүүлэхийн тулд GTX Browser-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Шинэчлэлтийг хэрэгжүүлэхийн тулд GTX Browser-г дахин ачаалахыг таны администратор танаас шаардаж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="1625909126243026060">GTX Browser-н нууцлал болон аюулгүй байдлын үндсэн хяналтуудыг шалгана уу</translation>
<translation id="1632539827495546968">Хэрэв та энэ бүртгэлийг зөвхөн нэг удаа ашиглахыг хүсвэл GTX Browser хөтчид <ph name="GUEST_LINK_BEGIN" />Зочны горимыг<ph name="GUEST_LINK_END" /> ашиглах боломжтой. Хэрэв та өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл өөрийн <ph name="DEVICE_TYPE" /> дээр <ph name="LINK_BEGIN" />шинэ хүн нэмнэ үү<ph name="LINK_END" />.

Таны вебсайтууд болон аппуудад аль хэдийн өгсөн зөвшөөрөл нь энэ бүртгэлд хэрэгжиж болзошгүй. Та Google Бүртгэлүүдээ <ph name="SETTINGS_LINK_BEGIN" />Тохиргоо<ph name="SETTINGS_LINK_END" /> хэсэгт удирдах боломжтой.</translation>
<translation id="1640672724030957280">Татаж байна...</translation>
<translation id="1708666629004767631">GTX Browser-ийн шинэ, илүү аюулгүй хувилбар боломжтой байна.</translation>
<translation id="17264556997921157">Танд зар харуулахад ашиглах сонирхлын сайтуудын сэдвийг та харах болон хасах боломжтой. GTX Browser таны сонирхлыг саяхны хөтчийн түүхэд тань тулгуурлан тооцоолно.</translation>
<translation id="1733725117201708356">GTX Browser удахгүй интернэтээр үзсэн өгөгдлийг устгана</translation>
<translation id="1745121272106313518">GTX Browser-г <ph name="REMAINING_TIME" />-н дараа дахин эхлүүлнэ</translation>
<translation id="1774152462503052664">GTX Browser-ыг арын орчинд ажиллуулах</translation>
<translation id="1779356040007214683">GTX Browser аюулгүй байдлыг нэмэгдүүлэхийн тулд бид <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ны жагсаалтад байхгүй бөгөөд танд мэдэгдэлгүйгээр нэмэгдсэн байж болзошгүй зарим өргөтгөлүүдийг идэвхгүй болгосон.</translation>
<translation id="1808667845054772817">GTX Browser-ыг дахин суулгах</translation>
<translation id="1820835682567584003">GTX Browser <ph name="AUTHENTICATION_PURPOSE" /> оролдож байна</translation>
<translation id="185970820835152459">Та нэвтэрсэн Google Бүртгэлүүдээ удирдах боломжтой. Таны Google Бүртгэлүүдийг GTX Browser хөтөч, Play Store, Gmail болон бусад дээр ашигладаг. Хэрэв та гэр бүлийн гишүүн зэрэг өөр хэн нэгний бүртгэлийг нэмэхийг хүсвэл оронд нь өөрийн <ph name="DEVICE_TYPE" />-д шинэ хүн нэмнэ үү. <ph name="LINK_BEGIN" />Нэмэлт мэдээлэл авах<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">Сайтууд GTX Browser-р таны сонирхлын талаарх мэдээллийг хадгалах боломжтой. Жишээлбэл, та марафонд зориулж гутал авахаар сайтад зочилсон бол тухайн сайт таны сонирхлыг марафонд гүйх гэж тодорхойлж магадгүй. Дараа та уралдаанд бүртгүүлэхийн тулд өөр сайтад зочилсон бол тухайн сайт таны сонирхолд тулгуурлан танд гүйлтийн гутлын зарыг харуулах боломжтой.</translation>
<translation id="1881322772814446296">Та удирдлагатай бүртгэл рүү нэвтрэн орсноор түүний админд нь өөрийн GTX Browser-ын хувийн мэдээллийг удирдах эрхийг олгож байна гэсэн үг юм. Таны GTX Browser-ын мэдээлэл, аппликейшн, хайлтын жагсаалт, түүх, нууц үг болон бусад тохиргоонууд <ph name="USER_NAME" /> руу нэгдэх болно. Та энэ мэдээллийг Google-ийн Хяналтын самбарыг ашиглан устгаж болох хэдий ч энэ мэдээллийг өөр данс руу нэгтгэж чадахгүй. Та одоо байгаа GTX Browser-ын мэдээллийг тусад нь хадгалахын тулд шинэ хувийн мэдээлэл үүсгэж болно. <ph name="LEARN_MORE" /></translation>
<translation id="1906696617298807388">Таныг хаяг оруулах хэсэг эсвэл хайх хэсэгт бичих үед GTX Browser зүйлийн зөвлөмжүүд авахын тулд таны бичсэн зүйлийг Google Драйвт илгээдэг. Энэ нь Нууцлалтай горимд унтраалттай.</translation>
<translation id="1911763535808217981">Үүнийг унтрааснаар та Gmail зэрэг Google-н сайтуудад GTX Browser-д нэвтрэлгүйгээр нэвтэрч болно</translation>
<translation id="1929939181775079593">GTX Browser ажиллахгүй байна. Дахин эхлүүлэх үү?</translation>
<translation id="193439633299369377">Шинэчлэлтийг хэрэгжүүлэхийн тулд GTX BrowserOS-г дахин эхлүүлэх шаардлагатай.</translation>
<translation id="1953553007165777902">Татаж байна... <ph name="MINUTE" /> минут үлдсэн</translation>
<translation id="1966382378801805537">GTX Browser нь өгөгдмөл хөтчийг тодорхойлох эсвэл тохируулах боломжгүй</translation>
<translation id="2008474315282236005">Энэ нь төхөөрөмжөөс 1 зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд GTX Browser-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="2018879682492276940">Суулгаж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="2020032459870799438">Бусад нууц үгэндээ өгөгдлийн зөрчил болон аюулгүй байдлын өөр асуудал байхгүй болохыг шалгахын тулд <ph name="BEGIN_LINK" />GTX Browser-д нэвтэрнэ үү<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">Google-н үйлчилгээнүүдэд илүү хувийн болгосон туршлага авахын тулд GTX Browser-н түүхийг багтаах эсэхээ сонгоно уу</translation>
<translation id="2088953378266246249">GTX Browser өөрийн үндсэн гэрчилгээг хэрхэн удирддаг тухай мэдээлэл</translation>
<translation id="2174178932569897599">GTX Browser-г өөрчлөх</translation>
<translation id="2174917724755363426">Суулгаж дуусаагүй байна. Та цуцлахдаа итгэлтэй байна уу?</translation>
<translation id="2185166961232948079">GTX Browser - Сүлжээнд нэвтрэх - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">Хэрэв та компьютероо дундаа ашиглаж байгаа бол таны найз нөхөд, гэр бүл  тусдаа хайлт хийж,  өөрсдийн хүссэнээрээ GTX Browser-ыг тохируулж болно.</translation>
<translation id="2313870531055795960">URL-г GTX Browser-д хадгалсан аюултай сайтын жагсаалттай харьцуулж шалгадаг. Хэрэв сайт таны нууц үгийг хулгайлах гэж оролдвол эсвэл таныг аюултай файл татах үед GTX Browser нь хуудасны контентын зэрэг URL-г Аюулгүй хайлт руу мөн илгээж болзошгүй.</translation>
<translation id="2343156876103232566">Та эндээс Android утсандаа дугаар илгээхийн тулд хоёр төхөөрөмжийн аль алинаас нь GTX Browser-д нэвтэрнэ үү.</translation>
<translation id="2347108572062610441">Энэ өргөтгөл нь таныг GTX Browser эхлүүлэх үед хуудас дээр харуулах зүйлийг өөрчилсөн.</translation>
<translation id="2359808026110333948">Цааш</translation>
<translation id="2384373936468275798">Таны бүртгэлийн нэвтрэх дэлгэрэнгүй мэдээлэл хуучирсан тул GTX BrowserOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="2396765026452590966">"<ph name="EXTENSION_NAME" />" өргөтгөл нь таныг GTX Browser эхлүүлэх үед хуудасны харуулах зүйлийг өөрчилсөн.</translation>
<translation id="2401032172288869980">GTX Browser-д энэ сайтад зориулж камер болон микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="2478295928299953161">GTX Browser-г удахгүй хаана</translation>
<translation id="2483889755041906834">GTX Browser-д</translation>
<translation id="2485422356828889247">Устгах</translation>
<translation id="2554739539410784893">GTX Browser одоо байгаа нууц үгнүүдийг солихоор оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="2560420686485554789">Файл татахын тулд GTX Browser-д сангийн хандалт шаардлагатай</translation>
<translation id="2572494885440352020">GTX Browser-ийн туслагч</translation>
<translation id="2583187216237139145">Энэ профайлыг ашиглах үед үүссэн GTX Browser-н аливаа өгөгдлийг (хавчуурга, түүх, нууц үг болон бусад тохиргоог үүсгэх зэрэг) ажлын профайлын админ хасах боломжтой. <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">GTX Browser-г үргэлжлүүлэн ашиглах</translation>
<translation id="2648074677641340862">Суулгалтын явцад үйлдлийн системийн алдаа гарлаа. GTX Browser-ыг дахин татаж авна уу.</translation>
<translation id="2661879430930417727">Хэрэв та төхөөрөмжийг дундаа ашигладаг бол найз нөхөд, гэр бүл тань хөтчөөр тусдаа үзэж, GTX Browser-г хүссэнээрээ тохируулах боломжтой</translation>
<translation id="2669853942967761236">Энэ архивын файл хортой программ нууж байж магадгүй тул GTX Browser үүнийг блоклосон</translation>
<translation id="268602741124540128">GTX Browser-д тавтай морилно уу, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="2711502716910134313">GTX Browser таб</translation>
<translation id="2718390899429598676">Таны аюулгүй байдлыг сайжруулахын тулд GTX Browser таны өгөгдлийг шифрлэх болно.</translation>
<translation id="2770231113462710648">Стандарт веб хөтчийг дараах руу өөрчил:</translation>
<translation id="2799223571221894425">Дахин эхлүүлэх</translation>
<translation id="2837693172913560447">Энэ нь <ph name="USER_EMAIL_ADDRESS" />-д GTX Browser-н шинэ профайл үүсгэнэ</translation>
<translation id="2847479871509788944">GTX Browser-аас устгах ...</translation>
<translation id="2850691299438350830">Таныг нэвтэрсэн үед GTX Browser дээр таны аюулгүй байдлыг хангадаг бөгөөд Google-н бусад апп дахь таны аюулгүй байдлыг сайжруулахын тулд ашиглаж болзошгүй</translation>
<translation id="2885378588091291677">Асуудлын менежер</translation>
<translation id="2910007522516064972">GTX Browser-ын тухай</translation>
<translation id="2915996080311180594">Дараа дахин эхлүүлэх</translation>
<translation id="2928420929544864228">Суулгаж дууслаа.</translation>
<translation id="2977470724722393594">GTX Browser-г шинэчилсэн байна</translation>
<translation id="2977506796191543575">Хэрэв сайт таны нууц үгийг хулгайлахаар оролдох эсвэл таныг аюултай файл татах үед GTX Browser URL-г хуудасны бага зэрэг контентын хамт Аюулгүй үзэх рүү мөн илгээж болзошгүй</translation>
<translation id="3032706164202344641">GTX Browser таны нууц үгсийг шалгах боломжгүй байна. Дараа дахин оролдоно уу.</translation>
<translation id="3032787606318309379">GTX Browser-д өгөгдөл нэмэх нь ...</translation>
<translation id="3038232873781883849">Суулгахыг хүлээж байна...</translation>
<translation id="3068515742935458733">Алдаа ослын тайлан болон <ph name="UMA_LINK" />-ыг Google рүү илгээх замаар GTX Browser-ыг улам сайжруулахад тусална уу.</translation>
<translation id="3101560983689755071">Таны хөтчийн түүх таны хардаг зар болон доор тооцоолсны дагуу сонирхолд нөлөөлнө. Таны нууцлалыг хамгаалахын тулд GTX Browser тодорхойгүй хугацаанд сар бүр таны сонирхлыг автоматаар устгана. Та сонирхлыг хасаагүй бол сэргээх боломжтой.</translation>
<translation id="3103660991484857065">Програм суулгагч нь архивыг задалж үл чадсан тул GTX Browser-г дахин татаж авна уу.</translation>
<translation id="3130323860337406239">GTX Browser нь таны микрофоныг ашиглаж байна.</translation>
<translation id="3155163173539279776">GTX Browser-г дахин эхлүүлэх</translation>
<translation id="3179665906251668410">Холбоосыг GTX Browser-н нууцлалтай цонхонд нээх</translation>
<translation id="3185330573522821672">GTX Browser-н шинэ профайлаа тохируулна уу</translation>
<translation id="3190315855212034486">GTX Browser-д гамтал гарлаа. Дахин эхлүүлэх үү?</translation>
<translation id="3258596308407688501">GTX Browser нь өөрийн өгөгдлийн сан руу уншуулж бас бичиж чадахгүй байна: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="3283186697780795848">GTX Browser <ph name="PRODUCT_VERSION" /> хувилбарыг суулгасан</translation>
<translation id="3286538390144397061">Одоо дахин эхлүүлнэ үү</translation>
<translation id="328888136576916638">Google-ийн API түлхүүр байхгүй байна. GTX Browser-ийн зарим функц идэвхгүй болно.</translation>
<translation id="3296368748942286671">GTX Browser-ийг хаахад ард байгаа програмуудыг ажиллуулсан хэвээр бай.</translation>
<translation id="3350761136195634146">Энэ бүртгэлтэй GTX Browser-н профайл аль хэдийн байна</translation>
<translation id="3387527074123400161">GTX BrowserOS</translation>
<translation id="3406848076815591792">GTX Browser-н одоо байгаа профайл руу сэлгэх үү?</translation>
<translation id="3412460710772753638">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="3430503420100763906">Та GTX Browser профайлаар GTX Browser-н бүх зүйлээ тусгаарлах боломжтой. Найзууд, гэр бүлдээ профайл үүсгэх эсвэл ажил болон дуртай зүйлээ хооронд нь хуваагаарай.</translation>
<translation id="347328004046849135">Таныг алдагдсан нууц үгээр нэвтрэх үед GTX Browser танд мэдэгдэнэ</translation>
<translation id="3474745554856756813">Энэ нь төхөөрөмжөөс <ph name="ITEMS_COUNT" /> зүйл устгана. Өгөгдлөө дараа сэргээхийн тулд GTX Browser-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> GTX Browser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="3509308970982693815">GTX Browser-н бүх цонхыг хаасны дараагаар дахин хандана уу.</translation>
<translation id="3533435340678213462">Таны нууцлалыг хамгаалахын тулд бид таны 4 долоо хоногоос дээш хугацаатай сонирхлыг автоматаар устгадаг. Таныг үргэлжлүүлэн үзэх үед сонирхол нь жагсаалтад дахин харагдаж магадгүй. Эсвэл та GTX Browser-г харгалзан үзэхгүй байхыг хүсэж буй сонирхлоо хасах боломжтой.</translation>
<translation id="3567254597502212821">Таны хөтчийн түүх буюу энэ төхөөрөмж дээр GTX Browser-г ашиглан зочилсон сайтуудын бүртгэл.</translation>
<translation id="3575459661164320785">Таны компьютер дээр аюултай программ хангамж байна. GTX Browser таны хөтчийн ажиллагааг дахин хэвийн болгохын тулд үүнийг устгах, таны тохиргоог сэргээх болон өргөтгөлүүдийг идэвхгүй болгох боломжтой.</translation>
<translation id="3593091352817399191">Өөр бүртгэл аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд GTX Browser танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="363078681319665186">GTX Browser-н цаашдын шинэчлэлтийг авахын тулд танд macOS 10.15 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер macOS 10.13 хувилбарыг ашиглаж байна.</translation>
<translation id="3639635944603682591">Энэ хэрэглэгчийн хөтчийн өгөгдлийг энэ төхөөрөмжөөс устгана. Өгөгдлийг сэргээхийн тулд GTX Browser-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{GTX Browser-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно.}=1{GTX Browser-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны нууцлалтай цонхыг дахин нээхгүй.}other{GTX Browser-н шинэ шинэчлэлт боломжтой байгаа бөгөөд таныг дахин ачаалах үед түүнийг хэрэгжүүлэх болно. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3651803019964686660"><ph name="ORIGIN" />-с Android утсандаа дугаар илгээхийн тулд хоёр төхөөрөмжийнхөө аль алинаас нь GTX Browser-д нэвтэрнэ үү.</translation>
<translation id="3685209450716071127">GTX Browser таны нууц үгсийг шалгах боломжгүй байна. Интернэт холболтоо шалгаж үзнэ үү.</translation>
<translation id="3702352323269013324">GTX Browser-н сонирхсон зарын тохируулгын талаар нэмэлт мэдээлэл авах</translation>
<translation id="370962675267501463">{COUNT,plural, =0{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд GTX Browser-г дахин ачаалахыг таны администратор танаас хүсэж байна}=1{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд GTX Browser-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны нууцлалтай цонхыг дахин нээхгүй.}other{Энэ шинэчлэлтийг хэрэгжүүлэхийн тулд GTX Browser-г дахин ачаалахыг таны администратор танаас хүсэж байна. Таны # нууцлалтай цонхыг дахин нээхгүй.}}</translation>
<translation id="3713809861844741608">Холбоосыг шинэ GTX Browser болон табад нээх</translation>
<translation id="378917192836375108">GTX Browser танд веб сайтад байгаа дугаар дээр дараад Skype-тай дуудлага хийх боломжийг олгоно.</translation>
<translation id="3830894615770080216">GTX BrowserOS систем</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - GTX Browser</translation>
<translation id="386822487697155367">GTX BrowserOS-тэй холбоотой тусламж авах</translation>
<translation id="3871664619793219264">GTX Browser хөтчийн зүйлсээ <ph name="ACCOUNT_EMAIL" />-с авна уу</translation>
<translation id="387966568917439637">GTX Browser-н цаашдын шинэчлэлтийг авахын тулд танд macOS 10.15 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер macOS 10.14 хувилбарыг ашиглаж байна.</translation>
<translation id="388648406173476553">GTX Browser-г өөрчилж, хянана уу. Та ямар нэг зүйлд анхаарлаа хандуулах шаардлагатай байна. Дэлгэрэнгүй мэдээлэл авахын тулд товшино уу.</translation>
<translation id="3889543394854987837">GTX Browser-г нээх мөн хөтөчийг ашиглаж эхлэхийн тулд өөрийн нэр дээр дарна уу.</translation>
<translation id="390528597099634151"><ph name="EXISTING_USER" /> GTX Browser-н энэ профайлд аль хэдийн нэвтэрсэн байна. Таны хөтчийн үзэлтийг тусад нь байлгахын тулд GTX Browser танд өөрийн гэсэн профайл үүсгэж өгөх боломжтой.</translation>
<translation id="391789666908693569">Таны бүртгэлийг <ph name="MANAGER_NAME" /> удирддаг. Танай администратор энэ GTX Browser хөтчийн профайл болон үүний хавчуурга, түүх, нууц үг зэрэг өгөгдлийг харах болон засах боломжтой.</translation>
<translation id="3945058413678539331">GTX Browser нь нууц үгс хуулахыг оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="3962623956404948996">Энэ файл аюултай байж магадгүй тул GTX Browser үүнийг скан хийхийг зөвлөж байна</translation>
<translation id="3997429360543082038">GTX BrowserOS-н тухай</translation>
<translation id="4019629340646866719">GTX BrowserOS-г <ph name="BEGIN_LINK_LINUX_OSS" />Linux-н хөгжүүлэлтийн орчин <ph name="END_LINK_LINUX_OSS" /> болох нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="4036079820698952681"><ph name="BEGIN_LINK" />Одоогийн тохиргоог<ph name="END_LINK" /> мэдэгдэж GTX Browser-г сайжруулахад тусална уу</translation>
<translation id="4050175100176540509">Хамгийн сүүлийн хувилбар дээр аюулгүй байдлын чухал сайжруулалт болон шинэ функцийг санал болгож байна.</translation>
<translation id="4148957013307229264">Суулгаж байна...</translation>
<translation id="419998258129752635"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх - GTX Browser</translation>
<translation id="421369550622382712">GTX Browser-д зориулсан гайхалтай апп, тоглоом, өргөтгөл болон дэлгэцийн зургуудыг олж сонирхоорой.</translation>
<translation id="4216212958613226427">Энэ хэлийг GTX Browser UI-г харуулахад ашигладаг</translation>
<translation id="4222932583846282852">Цуцалж байна...</translation>
<translation id="4230135487732243613">Та өөрийн GTX Browser өгөгдлийг энэ хаягтай холбох хүсэлтэй байна уу?</translation>
<translation id="4271805377592243930">GTX Browser-с тусламж авах</translation>
<translation id="4285930937574705105">Гэнэтийн асуудлаас болж суулгах ажиллагаа амжилтгүй боллоо. Хэрвээ GTX Browser яг одоо ажиллаж байгаа бол хаагаад дахин оролдож үзнэ үү.</translation>
<translation id="4304713468139749426">Нууц үгний менежер</translation>
<translation id="4334294535648607276">Татаж дууслаа.</translation>
<translation id="439358628917130594"><ph name="MANAGER" /> танаас энэ төхөөрөмжийг ашиглахаасаа өмнө дараах үйлчилгээний нөхцөлийг уншиж, зөвшөөрөхийг шаардаж байна. Эдгээр нөхцөл нь GTX BrowserOS-н нөхцөлийг өргөтгөх, өөрчлөх эсвэл хязгаарлахгүй.</translation>
<translation id="4407044323746248786">Ямар ч байсан GTX Browser-с гарах уу?</translation>
<translation id="4415566066719264597">GTX Browser-г цаана ажиллуулахыг зөвшөөрөх</translation>
<translation id="4423735387467980091">GTX Browser-ыг гүйцэтгэх ба хянах</translation>
<translation id="4427306783828095590">Сайжруулсан хамгаалалт нь фишинг болон хортой кодыг блоклохын тулд илүү ихийг хийдэг</translation>
<translation id="452711251841752011">GTX Browser-д тавтай морилно уу; хөтчийн шинэ цонхыг нээсэн</translation>
<translation id="4544142686420020088">GTX Browser-г шинэчлээгүй, ямар нэг алдаа гарлаа. <ph name="BEGIN_LINK" />GTX Browser-г шинэчлэхтэй холбоотой асуудлууд болон амжилтгүй болсон шинэчлэлтүүдийг засна уу.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">GTX Browser-н шинэ профайлд үргэлжлүүлэх үү?</translation>
<translation id="4567424176335768812">Та <ph name="USER_EMAIL_ADDRESS" /> ингэж нэвтэрсэн байна. Одоо та өөрийн нэвтэрсэн бүх төхөөрөмжүүд дээрээ хайлтын жагсаалт, түүх болон бусад тохиргоонууд руугаа нэвтэрч болно.</translation>
<translation id="4594305310729380060">Энэ төхөөрөмж дээрх Нууц үгний менежерт</translation>
<translation id="459535195905078186">GTX Browser App</translation>
<translation id="4613863813562375431">GTX BrowserOS-н хувилбар</translation>
<translation id="4621240073146040695">Удахгүй шинэчилж дууслаа! GTX Browser-н шинэчлэлийг дуусгахын тулд дахин ачаалж эхлүүлнэ үү.</translation>
<translation id="4665829708273112819">Анхааруулга: GTX Browser өргөтгөлүүдийг таны хөтчийн түүхийг бичихээс хамгаалж чадахгүй. Энэ өргөтгөлийг Нууцлалтай горимд идэвхгүй болгохын тулд энэ сонголтыг болиулна уу.</translation>
<translation id="4673151026126227699">Хэрэв та мөн GTX Browser-н ашиглалтын тайланг хуваалцвал тэдгээр тайланд таны зочилсон URL багтана</translation>
<translation id="4677944499843243528">Хувийн мэдээллийг (<ph name="HOST_NAME" />) өөр компьютер дээр өөр GTX Browser үйлдэлд (<ph name="PROCESS_ID" />) ашиглаж байна гэж харагдаж байна. GTX Browser-аас хувийн мэдээллийг түгжсэн байгаа учраас үүнийг өөр зүйлд ашиглах боломжгүй юм. Хэрэв та өөр ямар ч үйлдэлд энэ хувийн мэдээллийг ашиглахгүй байгаа гэдэгт та итгэлтэй байгаа бол хувийн мэдээллээ цоожилж GTX Browser-ыг дахин эхлүүлж болно.</translation>
<translation id="4680828127924988555">Суулгахыг цуцлах</translation>
<translation id="4708774505295300557">Хэн нэгэн энэ компьютерт <ph name="ACCOUNT_EMAIL_LAST" /> бүртгэлээр GTX Browser-д нэвтэрсэн байна. Мэдээллээ тусад нь хадгалахын тулд GTX Browser-н шинэ хэрэглэгч үүсгэнэ үү.</translation>
<translation id="4746050847053251315">Ямар ч байсан GTX Browser-г орхих уу?</translation>
<translation id="4748217263233248895">GTX Browser-н аюулгүй байдлын тусгай шинэчлэлт хийгдэж дууслаа. Одоо дахин эхлүүлнэ үү. Бид таны табыг сэргээх болно.</translation>
<translation id="4765210420921718862">Та GTX Browser-н тохиргоо хэсэгт хүссэн үедээ бодлоо өөрчлөх боломжтой. Туршилтын хугацаа нь зарыг хүргэдэг одоогийн аргын хамт үргэлжлэх бөгөөд ингэснээр та өөрчлөлтүүдийг тэр даруй харахгүй.</translation>
<translation id="4788777615168560705">GTX Browser таны нууц үгсийг шалгах боломжгүй байна. 24 цагийн дараа дахин оролдоно уу эсвэл <ph name="BEGIN_LINK" />өөрийн Google Бүртгэл дэх нууц үгсийг шалгана уу<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">Энэ нь Google хайлтад ашигладаг зөв бичгийн ижил алдаа шалгагчийг ашигладаг. Таны хөтчид бичсэн текстийг Google-д илгээдэг. Та энэ ажиллах төлөвийг хүссэн үедээ тохиргоонд өөрчилж болно</translation>
<translation id="4888717733111232871">MDNS урсгалыг зөвшөөрөхийн тулд GTX Browser-д зориулсан хөндлөнгийн дүрэм.</translation>
<translation id="4893347770495441059">&amp;GTX Browser-г шинэчлэхийн тулд дахин ачаалах</translation>
<translation id="4943838377383847465">GTX Browser нь суурь горимд байна.</translation>
<translation id="4987820182225656817">Зочид GTX Browser-ийг ашигласнаар хамгийн сүүлийн үеийн мэдээллийг авна.</translation>
<translation id="4994636714258228724">Өөрийгөө GTX Browser руу нэмэх</translation>
<translation id="5114678101347489141">GTX Browser нь сайтуудад таны өгөгдлийг бага хэмжээгээр ашиглан ижил үзэх туршлагыг хүргэх боломжийг олгох шинэ онцлогуудыг судалж байна</translation>
<translation id="51579499820286700">{COUNT,plural, =1{GTX Browser-г 1 минутын турш ашиглаагүй үед таны администратор үүнийг автоматаар хаана.}other{GTX Browser-г # минутын турш ашиглаагүй үед таны администратор үүнийг автоматаар хаана.}}</translation>
<translation id="5224391634244552924">Хадгалсан ямар ч нууц үг алга. Таныг нууц үгсээ хадгалах үед GTX Browser тэднийг шалгах боломжтой.</translation>
<translation id="5252179775517634216"><ph name="EXISTING_USER" /> GTX Browser-н энэ профайлд аль хэдийн нэвтэрсэн байна. Энэ нь <ph name="USER_EMAIL_ADDRESS" />-д GTX Browser-н шинэ профайл үүсгэнэ</translation>
<translation id="5277894862589591112">Өөрчлөлтөө хэрэгжүүлэхийн тулд GTX Browser-г дахин ажиллуулна уу</translation>
<translation id="5296845517486664001">Туршилтын хугацаанд байгаа бөгөөд GTX Browser таныг санамсаргүй байдлаар идэвхтэй туршилтын хугацаанд байрлуулсан бол таны хөтчийн түүх доор тооцоолсны дагуу таны хардаг зар болон сонирхолд нөлөөлнө. Таны нууцлалыг хамгаалахын тулд GTX Browser тодорхойгүй хугацаанд сар бүр таны сонирхлыг устгана.</translation>
<translation id="5358375970380395591">Та удирдан ажиллаж буй хаягт нэвтэрч байгаагаас гадна таны GTX Browser профайлыг хянах эрхийг системийн ажилтанд шилжүүлж байна. Таны апп, хавчуурга, түүх, нууц үг болон бусад тохиргоо гэх мэт таны GTX Browser өгөгдлийг <ph name="USER_NAME" />-тэй холбох болно. Та энэхүү өгөгдлийг Google Accounts Dashboard-р дамжуулан устгах боломжтой боловч та энэхүү өгөгдлийн өөр хаягтай холбох боломжгүй байна. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">GTX Browser-г шинэчилж байна (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">GTX Browser-д нэвтрэхийг зөвшөөрөх</translation>
<translation id="5398878173008909840">Ашиглах боломжтой GTX Browser-ийн шинэ хувилбар байна.</translation>
<translation id="5405650547142096840">GTX Browser-аас устга</translation>
<translation id="5427571867875391349">GTX Browser-ыг өөрийн анхдагч веб хөтөч болгон тохируулах</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - GTX Browser Бета</translation>
<translation id="5473971139929175403">Үүнийг Linux дистрибьютер дээр цаашид дэмжихгүй тул GTX Browser буруу ажиллаж болзошгүй</translation>
<translation id="5480860683791598150">Таны байршлыг энэ сайттай хуваалцахын тулд GTX Browser-д таны байршилд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="5487574057737591516">Таны нууцлалыг хамгаалахын тулд бид таны 4 долоо хоногоос дээш хугацаатай сонирхлыг автоматаар устгадаг. Таныг үргэлжлүүлэн үзэх үед сонирхол нь жагсаалтад дахин харагдаж магадгүй. Мөн GTX Browser үүнийг буруу тооцоолсон эсвэл та тодорхой зарыг харахыг хүсэхгүй байвал та сонирхлыг хасах боломжтой.</translation>
<translation id="549669000822060376">GTX Browser нь хамгийн сүүлийн үеийн системийн шинэчлэлтүүдийг суулгаж байгаа тул түр хүлээнэ үү.</translation>
<translation id="5496810170689441661">GTX Browser нь нууц үгсийг засах гэж оролдож байна. Үүнийг зөвшөөрөхийн тулд Windows-н нууц үгээ бичнэ үү.</translation>
<translation id="5527463683072221100">PDF-г GTX Browser-д нээх</translation>
<translation id="5614091477838198795">Асаалттай үед таныг мөн GTX Browser-с гаргана</translation>
<translation id="5623402015214259806">{0,plural, =0{GTX Browser-н шинэчлэлт боломжтой байна}=1{GTX Browser-н шинэчлэлт боломжтой байна}other{GTX Browser-н шинэчлэлт # хоногийн турш боломжтой байсаар байна}}</translation>
<translation id="5653831366781983928">GTX Browser-г одоо дахин эхлүүлнэ үү</translation>
<translation id="5690427481109656848">Google ХХК</translation>
<translation id="5698481217667032250">GTX Browser-г энэ хэлээр харуулах</translation>
<translation id="5862307444128926510">GTX Browser-д тавтай морил</translation>
<translation id="5883558403894052917">Эдгээр зүйл хортой программ агуулж байгааг GTX Browser олж мэдлээ:</translation>
<translation id="5895138241574237353">Дахин асаах</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - Сүлжээнд нэвтрэх</translation>
<translation id="5924017743176219022">Интернэтэд холбогдож байна...</translation>
<translation id="5941711191222866238">Багасгах</translation>
<translation id="5972142260211327093">GTX Browser таныг идэвхтэй туршилтын хугацаанд санамсаргүй байдлаар байрлуулсан бөгөөд таны хөтчийн түүх доор тооцоолсны дагуу таны хардаг зар болон сонирхолд нөлөөлнө. Таны нууцлалыг хамгаалахын тулд GTX Browser тодорхойгүй хугацаанд сар бүр таны сонирхлыг устгана. Та сонирхлыг хасаагүй бол сэргээнэ.</translation>
<translation id="5987687638152509985">Синкийг эхлүүлэхийн тулд GTX Browser-г шинэчлэх</translation>
<translation id="5988505247484123880">Таны зочилсон сайтууд таны сонирхдог зүйлсийг таны туршлагыг хувийн болгохын тулд санах нь түгээмэл юм. Сайтууд мөн GTX Browser-р таны сонирхлын талаарх мэдээллийг хадгалах боломжтой.</translation>
<translation id="6003112304606738118">Татаж байна... <ph name="HOURS" /> цаг үлдсэн</translation>
<translation id="6040143037577758943">Хаах</translation>
<translation id="6055895534982063517">GTX Browser-ийн шинэ хувилбар боломжтой байна. Хэзээ хэзээнээс ч хурдан.</translation>
<translation id="6063093106622310249">&amp;GTX Browser-д нээх</translation>
<translation id="6072279588547424923"><ph name="EXTENSION_NAME" />-г GTX Browser-д нэмсэн</translation>
<translation id="6072463441809498330">GTX Browser-г илүү хурдан болгоорой</translation>
<translation id="608006075545470555">Энэ хөтчид ажлын профайл нэмэх</translation>
<translation id="6096348254544841612">GTX Browser-г тохируулж, хянана уу. Шинэчлэх боломжтой.</translation>
<translation id="6102072151902574948">Асаалттай үед GTX Browser жигд гүйлгэх болон видеоны фрэймийн хурд зэрэг дэвсгэрийн үйл ажиллагаа, визуал эффектийг хязгаарласнаар батарейн цэнэгийг хадгална.</translation>
<translation id="6119438414301547735">Өргөтгөлд GTX Browser-н самбарт хандах хүсэлт харуулахыг зөвшөөрнө үү</translation>
<translation id="6120345080069858279">GTX Browser энэ нууц үгийг таны Google Бүртгэлд хадгалах тул та үүнийг санах шаардлагагүй.</translation>
<translation id="6129621093834146363"><ph name="FILE_NAME" /> аюултай тул үүнийг GTX Browser блок хийсэн.</translation>
<translation id="6132897690380286411">GTX Browser удахгүй хаах бөгөөд өгөгдлийг устгана</translation>
<translation id="6134968993075716475">Аюулгүй үзэх онцлог унтраалттай байна. GTX Browser түүнийг асаахыг зөвлөж байна.</translation>
<translation id="6145820983052037069">Та энд GTX Browser-н профайлууд хооронд сэлгэх боломжтой</translation>
<translation id="6183079672144801177">Та GTX Browser-д өөрийн <ph name="TARGET_DEVICE_NAME" />-с нэвтэрсэн эсэхээ шалгаад, дахин илгээхээр оролдоно уу.</translation>
<translation id="6212496753309875659">Энэ компьютерт GTX Browser-ийн хамгийн сүүлийн үеийн хувилбар байна. Хэрэв программ ажиллахгүй байвал GTX Browser-ийг устгаад, дахин суурьлуулж үзнэ үү.</translation>
<translation id="6219195342503754812">{0,plural, =0{GTX Browser-г одоо дахин ажиллуулна}=1{GTX Browser-г 1 секундийн дотор дахин ажиллуулна}other{GTX Browser-г # секундийн дотор дахин ажиллуулна}}</translation>
<translation id="6241367896540709610">Файл татахын тулд GTX Browser-д хадгалах санд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="6245734527075554892">GTX Browser-д хадгалсан аюултай сайтын жагсаалттай URL-г шалгана</translation>
<translation id="6248213926982192922">GTX Browser-ыг анхдагч веб хөтөч болгох</translation>
<translation id="6266342355635466082">GTX Browser нь шинэчлэлтийг шалгах боломжгүй байна. Интернэт холболтоо шалгаж үзнэ үү.</translation>
<translation id="6268381023930128611">GTX Browser-с гарах уу?</translation>
<translation id="6273793429163604305">Бэлдээрэй...</translation>
<translation id="6281746429495226318">GTX Browser-н профайлаа өөрчлөх</translation>
<translation id="6290827346642914212">GTX Browser-н профайлаа нэрлэнэ үү</translation>
<translation id="6295779123002464101"><ph name="FILE_NAME" /> аюултай байж болзошгүй тул үүнийг GTX Browser блок хийсэн.</translation>
<translation id="6309712487085796862">GTX Browser таны камерыг ашиглаж байна.</translation>
<translation id="632355235628111698">Энэ файл аюултай тул GTX Browser үүнийг блоклосон</translation>
<translation id="6327105987658262776">Шинэчлэлт боломжгүй байна.</translation>
<translation id="6333502561965082103">GTX Browser-д өөр үйл ажиллагаа явагдаж байна. Дараа дахин оролдоно уу.</translation>
<translation id="6334986366598267305">Одоо та Google хаягаа ашиглан мөн өөр бусад компьютер дээр GTX Browser-г ашиглахад хялбар боллоо.</translation>
<translation id="6365489425007284765">{COUNT,plural, =1{Интернэтээр үзсэн өгөгдлийг 1 минутын турш ашиглаагүй үед таны администратор үүнийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны одоо байгаа табууд нээлттэй хэвээр үлдэнэ.}other{Интернэтээр үзсэн өгөгдлийг # минутын турш ашиглаагүй үед таны администратор үүнийг автоматаар устгана. Үүнд түүх, автоматаар бөглөх хэсэг болон татаж авсан файлууд багтаж болно. Таны одоо байгаа табууд нээлттэй хэвээр үлдэнэ.}}</translation>
<translation id="6373523479360886564">Та GTX Browser-ыг устгахыг хүсэж байгаадаа итгэлтэй байна уу?</translation>
<translation id="6384011394608460044"><ph name="BEGIN_BOLD" />Бид энэ өгөгдлийг хэрхэн ашигладаг вэ?:<ph name="END_BOLD" /> GTX Browser таны сонирхлыг тооцоолох боломжтой. Дараа нь таны зочилсон сайт таны хардаг зарыг хувийн болгохын тулд GTX Browser-с таны сонирхлыг харахыг хүсэх боломжтой.</translation>
<translation id="6403826409255603130">GTX Browser бол веб хуудсууд болон аппликейшнуудыг цахилгааны хурдаар ажиллуулдаг веб хөтөч юм. Энэ нь хурдан, найдвартай мөн хэрэглэхэд хялбар. GTX Browser-д бий болгосон хорт вирус болон фишингийн хамгаалалтыг ашиглан вебээр илүү аюулгүй хайлт хийгээрэй.</translation>
<translation id="6442900851116057561">GTX BrowserOS-г дахин эхлүүлнэ үү</translation>
<translation id="6455857529632101747">GTX Browser профайлд тавтай морилно уу</translation>
<translation id="6475912303565314141">Энэ нь мөн таныг GTX Browser-ыг эхлүүлж байх үед гарч ирсэн хуудсыг хянадаг.</translation>
<translation id="648319183876919572">Сайжруулсан аюулгүй хөтөч нь таныг аюултай вебсайт болон таталтаас хамгаалахын тулд илүү ихийг хийдэг</translation>
<translation id="6510925080656968729">GTX Browser-ийг устгах</translation>
<translation id="6542839706527980775">Профайл тус бүр GTX Browser-н өөрийн мэдээллийг агуулах бөгөөд үүнд хавчуурга, түүх, нууц үг болон бусад мэдээлэл багтана</translation>
<translation id="656935081669708576">Та өөр GTX Browser профайлаас нууц үгнүүдийг харахын тулд шилжих боломжтой</translation>
<translation id="6570579332384693436">Зөв бичгийн алдааг засахын тулд GTX Browser таны текстийн талбарт бичсэн текстийг Google-д илгээдэг</translation>
<translation id="6598877126913850652">GTX Browser-н мэдэгдлийн тохиргоо руу очих</translation>
<translation id="6613594504749178791">Таныг GTX Browser дахин эхлүүлэхэд өөрчлөлт идэвхжинэ.</translation>
<translation id="665732753414869868">Таны эргэн тойрны 3D газрын зургийг үүсгэхийн тулд GTX Browser-д камерын зөвшөөрөл шаардлагатай</translation>
<translation id="6663852025006259149">Сайтууд таны бодож байснаар ажиллаж магадгүй ч таныг GTX Browser-н бүх цонхыг хаасны дараа санахгүй</translation>
<translation id="6676384891291319759">Интернэтэд нэвтрэх</translation>
<translation id="668175097507315160">Нэвтрэх алдааны улмаас GTX BrowserOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="6709350901466051922">GTX Browser-д энэ сайтад зориулж микрофоны зөвшөөрөл шаардлагатай</translation>
<translation id="6717134281241384636">Таны профайлыг ашиглах боломжгүй байна. Учир нь энэ GTX Browser-ийн шинэ хувилбараас ирсэн байна.

Зарим функц ажиллахгүй байж болно. профайлын өөр зааварчилгааг тодорхойлж өгөх эсвэл GTX Browser-ийн шинэ хувилбарыг ашиглана уу.</translation>
<translation id="6730677189742196061">Санах ой хэмнэгч нь GTX Browser-г илүү хурдан болгосон</translation>
<translation id="6734291798041940871">GTX Browser-г таны компьютерийн бүх хэрэглэгчид суулгасан байна.</translation>
<translation id="673636774878526923">Та бүх төхөөрөмж дээрээ GTX Browser-н зүйлсдээ хандахын тулд нэвтэрч, дараа нь синк хийхийг асаана уу.</translation>
<translation id="67706546131546258">Энэ файл аюултай байж магадгүй тул GTX Browser үүнийг скан хийхийг зөвлөж байна.</translation>
<translation id="6774082503108938489">Таны эцэг эх GTX Browser-н "Сайтууд, аппууд болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна. Энэ <ph name="EXTENSION_TYPE_PARAMETER" />-г идэвхжүүлэхийг зөвшөөрдөггүй.</translation>
<translation id="6779406956731413166">GTX BrowserOS-г нэмэлт <ph name="BEGIN_LINK_CROS_OSS" />нээлттэй эх кодын программ хангамжаар<ph name="END_LINK_CROS_OSS" /> боломжтой болгосон.</translation>
<translation id="6847869444787758381">Хэрэв таны нууц үг алдагдсан байвал GTX Browser танд мэдэгдэнэ</translation>
<translation id="6852530923436401894">Энэ файл хортой программтай тул GTX Browser үүнийг блоклосон</translation>
<translation id="6857782730669500492">GTX Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="6863361426438995919">Google Pay (GTX Browser-д хуулсан)</translation>
<translation id="6873893289264747459">"<ph name="EXTENSION_NAME" />" хортой программ агуулж байгааг GTX Browser олж мэдлээ</translation>
<translation id="6893813176749746474">GTX Browser нь шинэчлэгдсэн байгаа хэдий ч та үүнийг доод тал нь 30 хоногийн турш ашиглаагүй байна.</translation>
<translation id="691026815377248078">Үргэлжлүүлэн хослуулахын тулд GTX Browser-д Bluetooth-н 
 хандалт шаардлагатай. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="6929417474050522668">Туршилтын хугацаанд байх үед Зарын хэмжилт нь таны зочилсон сайтуудад зарынхаа гүйцэтгэлийг хэмжихэд туслах мэдээллийг GTX Browser-с хүсэх боломжийг олгоно. Зарын хэмжилт нь сайт хооронд аль болох бага мэдээлэл шилжүүлснээр сайт хоорондын хяналтыг хязгаарлана.</translation>
<translation id="6940431691900807093">Дараа нь таны зочилсон сайт таны хардаг зарыг хувийн болгохын тулд GTX Browser-с таны сонирхлыг харахыг хүсэх боломжтой. GTX Browser 3 хүртэлх сонирхол хуваалцах боломжтой.</translation>
<translation id="6964305034639999644">Холбоосыг GTX Browser-н нууцлалтай цонхонд нээх</translation>
<translation id="6978145336957848883">Сул нууц үгийг таахад хялбар байдаг. GTX Browser-д <ph name="BEGIN_LINK" />танд зориулан сайн нууц үг үүсгэж, санах<ph name="END_LINK" /> боломж олгоорой.</translation>
<translation id="6981396265751285733">Асаалттай үед GTX Browser идэвхгүй табуудаас санах ойг чөлөөлнө. Энэ нь идэвхтэй табууд болон бусад аппад компьютерын илүү их нөөцийг өгч, GTX Browser-г хурдан байлгана. Таныг идэвхгүй табууд руугаа буцахад тэдгээр нь автоматаар дахин идэвхтэй болно.</translation>
<translation id="6985329841647292029">GTX BrowserOS-н нөхцөл</translation>
<translation id="6990124437352146030">Энэ сайтыг ашиглахын тулд GTX Browser-д таны микрофонд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="7025789849649390912">Суулгахыг зогсоосон.</translation>
<translation id="705851970750939768">GTX Browser-г шинэчлэх</translation>
<translation id="7067091210845072982">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол GTX Browser танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ.</translation>
<translation id="718435575166326686">GTX Browser-д энэ сайтад зориулж камерын зөвшөөрөл шаардлагатай</translation>
<translation id="7196312274710523067">GTX Browser-г эхлүүлж чадсангүй. Дахин оролдоно уу.</translation>
<translation id="7197677400338048821">GTX Browser таны нууц үгсийг шалгах боломжгүй байна. 24 цагийн дараа дахин оролдоно уу.</translation>
<translation id="7223968959479464213">Бодлогын менежер - GTX Browser</translation>
<translation id="7246575524853130370">GTX Browser-с тооцоолсон таны сонирхол</translation>
<translation id="7309928523159922338">Зарын хэмжилт нь таны зочилсон сайтуудад зарынхаа гүйцэтгэлийг хэмжихэд туслах мэдээллийг GTX Browser-с хүсэх боломжийг олгоно. Зарын хэмжилт нь сайт хооронд аль болох бага мэдээлэл шилжүүлснээр сайт хоорондын хяналтыг хязгаарлана.</translation>
<translation id="731795002583552498">GTX Browser-г шинэчилж байна</translation>
<translation id="7318036098707714271">Таны тохиргоо файл алдаатай эсвэл хүчин төгөлдөр бус байна. GTX Browser таны тохиргоог сэргээх боломжгүй байна.</translation>
<translation id="7337881442233988129">GTX Browser</translation>
<translation id="7339898014177206373">Шинэ цонх</translation>
<translation id="734373864078049451">Таны веб хуудас, хавчуурга, болон бусад GTX Browser-ийн зүйлс энд байдаг.</translation>
<translation id="7349591376906416160">Таны системийн админ GTX Browser-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд <ph name="ALTERNATIVE_BROWSER_NAME" />-г нээхээр тохируулсан байна.</translation>
<translation id="7398989605938454041">Та GTX Browser-н профайлуудаар GTX Browser-н бүх зүйлээ тусгаарлах боломжтой. Энэ нь ажил болон зугаацдаг зүйлсээ тусад нь байлгахад илүү хялбар болгоно.</translation>
<translation id="7449453770951226939"><ph name="PAGE_TITLE" /> - GTX Browser Дев</translation>
<translation id="7451052299415159299">Энэ сайтыг ашиглахын тулд GTX Browser-д таны камерт хандах зөвшөөрөл шаардлагатай</translation>
<translation id="7461356015007898716">GTX Browser-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 7-г ашиглаж байна.</translation>
<translation id="7467949745582939695">GTX Browser-г дахин эхлүүлэх үү?</translation>
<translation id="7483335560992089831">Одоо ажиллаж байгаа GTX Browser-ын ижил хувилбарыг суулгаж чадахгүй байна. GTX Browser-аа хаагаад дахин оролдоно уу.</translation>
<translation id="753534427205733210">{0,plural, =1{GTX Browser-г 1 минутын дотор дахин ажиллуулна}other{GTX Browser-г # минутын дотор дахин ажиллуулна}}</translation>
<translation id="7561906087460245826">GTX Browser-н (<ph name="URL" />) өгөгдлийг мөн адил устгах</translation>
<translation id="7582945390259497898">GTX Browser таны сонирхлыг тооцоолох боломжтой. Дараа нь таны зочилсон сайт таны хардаг зарыг хувийн болгохын тулд GTX Browser-с таны сонирхлыг харахыг хүсэх боломжтой.</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> суулгагч</translation>
<translation id="761356813943268536">GTX Browser нь таны камер болон микрофоныг ашиглаж байна.</translation>
<translation id="7617377681829253106">GTX Browser сайжирлаа</translation>
<translation id="7649070708921625228">Тусламж</translation>
<translation id="7682213815243802460">Та эдгээр онцлогийн талаар GTX Browser-н тохиргоо хэсгээс нэмэлт мэдээлэл авах боломжтой.</translation>
<translation id="7682601070171973634">GTX Browser нь сайтуудад таны өгөгдлийг бага хэмжээгээр ашиглах боломжийг олгодог шинэ боломжуудыг судалж байна</translation>
<translation id="7686590090926151193">GTX Browser таны өгөгдмөл хөтөч биш юм</translation>
<translation id="7689606757190482937">Төхөөрөмжүүддээ GTX Browser-г синк хийж, хувийн болгох</translation>
<translation id="7745317241717453663">Энэ нь төхөөрөмжөөс таны хайлтын түүхийг устгана. Өгөгдлөө дараа сэргээхийн тулд GTX Browser-д <ph name="USER_EMAIL" />-р нэвтэрнэ үү.</translation>
<translation id="7747138024166251722">Суулгагч нь түр зуурын хадгалалтын санг үүсгэж чадсангүй. Дискэнд сул зай байгаа эсэхийг мөн программ хангамж суулгах зөвшөөрлийг шалгана уу.</translation>
<translation id="7786760609782648049">GTX Browser-г илүү хурдан болгоорой</translation>
<translation id="7790626492778995050"><ph name="PAGE_TITLE" /> - GTX Browser Канари</translation>
<translation id="7828947555739565424">Энэ бүртгэлтэй GTX Browser-н профайл аль хэдийн энэ төхөөрөмж дээр байна</translation>
<translation id="7845233973568007926">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө компьютероо дахин эхлүүлэх ёстой.</translation>
<translation id="7859018312476869945">Таныг хаяг оруулах хэсэг эсвэл хайх хэсэгт бичих үед GTX Browser илүү сайн зөвлөмж авахын тулд таны бичсэн зүйлийг өгөгдмөл хайлтын системд тань илгээдэг. Энэ нь Нууцлалтай горимд унтраалттай.</translation>
<translation id="7867198900892795913">GTX Browser-г хамгийн сүүлийн хувилбарт шинэчлээгүй тул та шинэ онцлог болон аюулгүй байдлын засвар авах боломжгүй байна.</translation>
<translation id="7872446069773932638">Татаж байна... <ph name="SECONDS" /> секунд үлдсэн</translation>
<translation id="7877292582355102282"><ph name="BEGIN_BOLD" />Та өгөгдлөө хэрхэн удирдах боломжтой вэ?:<ph name="END_BOLD" /> Таны нууцлалыг хамгаалахын тулд бид таны 4 долоо хоногоос дээш хугацаатай сонирхлыг автоматаар устгадаг. Таныг үргэлжлүүлэн үзэх үед сонирхол нь жагсаалтад дахин харагдаж магадгүй. Эсвэл та GTX Browser-г бодож үзэхгүй байхыг хүсэж буй сонирхлоо хасах боломжтой.</translation>
<translation id="7937630085815544518">Та GTX Browser-д <ph name="USER_EMAIL_ADDRESS" />-аар нэвтэрсэн байна. Нэвтрэхийн тулд ижил данс хэрэглэнэ үү.</translation>
<translation id="7975919845073681630">Энэ нь GTX Browser-н хоёр дахь суулгалт тул таны өгөгдмөл хөтчөөр сонгох боломжгүй.</translation>
<translation id="7997934263947464652">Тодорхойгүй эх сурвалжийн өргөтгөл, апп болон загвар нь таны төхөөрөмжийг гэмтээх боломжтой. GTX Browser тэдгээрийг зөвхөн <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-с суулгахыг зөвлөж байна</translation>
<translation id="8013436988911883588">GTX Browser-д хандалт олгосны дараа веб сайтууд таны хандалтыг асуух боломжтой болно.</translation>
<translation id="80471789339884597">Суулгасанд баярлалаа. Та <ph name="BUNDLE_NAME" />-г ашиглахаасаа өмнө бүх хөтчөө дахин эхлүүлэх ёстой.</translation>
<translation id="8105840573057009683">GTX Browser-д энэ сайтад зориулж байршлын зөвшөөрөл шаардлагатай</translation>
<translation id="8133124826068723441">Синк нь таны домэйнд боломжгүй тул GTX BrowserOS таны өгөгдлийг синк хийж чадсангүй.</translation>
<translation id="813913629614996137">Эхлүүлж байна…</translation>
<translation id="81770708095080097">Энэ файл аюултай тул GTX Browser блоклосон байна.</translation>
<translation id="8213374284266571500">Энэ төрлийн файл аюултай тул GTX Browser энэ файлыг блоклосон</translation>
<translation id="8248265253516264921">Хэрэв зурагт хэрэгтэй тайлбар байхгүй бол GTX Browser танд тайлбар өгөхөөр оролдох болно. Тайлбар үүсгэхийн тулд зургийг Google-д илгээнэ. Та үүнийг хүссэн үедээ тохиргоонд унтрааж болно.</translation>
<translation id="8266560134891435528">Та нэвтрээгүй байгаа тул GTX Browser таны нууц үгсийг шалгах боломжгүй байна</translation>
<translation id="8290862415967981663">Энэ файл аюултай тул GTX Browser блоклосон байна.</translation>
<translation id="8325404639443959713">GTX Browser-р илүү ихийг хийгээрэй</translation>
<translation id="8330519371938183845">Төхөөрөмжүүддээ GTX Browser-г синк хийж, хувийн болгохын тулд нэвтрэх</translation>
<translation id="8340674089072921962"><ph name="USER_EMAIL_ADDRESS" /> өмнө нь GTX Browser-г ашиглаж байсан</translation>
<translation id="8357820681460164151">Та бүх төхөөрөмж дээрээ GTX Browser хөтчийн зүйлсдээ хандахын тулд нэвтэрч, дараа нь синк хийхийг асаана уу</translation>
<translation id="8360718212975266891">GTX Browser-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 8-г ашиглаж байна.</translation>
<translation id="8370517070665726704">Зохиогчийн эрх <ph name="YEAR" /> Google ХХК. Бүх эрх хуулиар хамгаалагдсан.</translation>
<translation id="8417404458978023919">{0,plural, =1{GTX Browser-г 1 хоногийн дотор дахин ажиллуулна уу}other{GTX Browser-г # хоногийн дотор дахин ажиллуулна уу}}</translation>
<translation id="8453117565092476964">Суулгагчийн архив устгагдсан эсвэл хүчингүй болсон байна. GTX Browser-ыг дахин татаж авна уу.</translation>
<translation id="8458614432758743027">GTX Browser нь Windows 10 эсвэл түүнээс дээших хувилбарыг шаарддаг.</translation>
<translation id="8463672209299734063">Заавал биш: Оношилгоо болон ашиглалтын өгөгдлийг Google-д автоматаар илгээснээр GTX BrowserOS-н онцлогууд, гүйцэтгэлийг сайжруулахад тусална уу.</translation>
<translation id="8493179195440786826">GTX Browser нь хуучирсан байна</translation>
<translation id="8550334526674375523">Энэ ажлын профайл нь таны хувийн профайлаас бүрэн тусдаа байна.</translation>
<translation id="8558383651099478961">Таны эцэг эх GTX Browser-н "Сайтууд, аппууд болон өргөтгөлүүдийн зөвшөөрөл"-ийг унтраасан байна. Энэ <ph name="EXTENSION_TYPE_PARAMETER" />-г нэмэхийг зөвшөөрдөггүй.</translation>
<translation id="8568283329061645092">GTX Browser нь таныг Google Бүртгэлээрээ нэвтрэх үед таны нууц үгсийг шалгах боломжтой</translation>
<translation id="8586442755830160949">GTX Browser-ийн зохиогчийн эрх <ph name="YEAR" />. Бүх эрхийг хуулиар хамгаалсан.</translation>
<translation id="8608079656141766906"><ph name="BEGIN_BOLD" />Бид энэ өгөгдлийг хэрхэн ашигладаг вэ?:<ph name="END_BOLD" /> Сайтууд GTX Browser-р таны сонирхлын талаарх мэдээллийг хадгалах боломжтой. Жишээлбэл, та марафонд зориулж гутал авахаар сайтад зочилсон бол тухайн сайт таны сонирхлыг марафонд гүйх гэж тодорхойлж магадгүй. Дараа та уралдаанд бүртгүүлэхийн тулд өөр сайтад зочилсон бол тухайн сайт таны сонирхолд тулгуурлан танд гүйлтийн гутлын зарыг харуулах боломжтой.</translation>
<translation id="8619360774459241877">GTX Browser-г эхлүүлж байна...</translation>
<translation id="8621669128220841554">Гэнэтийн алдаанаас болж суулгах ажиллагаа амжилтгүй боллоо. GTX Browser-ыг дахин татаж авна уу.</translation>
<translation id="867492205098279939">{NUM_DEVICES,plural, =0{GTX Browser өргөтгөл HID төхөөрөмжүүдэд хандаж байсан}=1{GTX Browser өргөтгөл 1 HID төхөөрөмжид хандаж байна}other{GTX Browser өргөтгөл # HID төхөөрөмжид хандаж байна}}</translation>
<translation id="8697124171261953979">Энэ нь мөн таныг GTX Browser-ыг эхлүүлж байх үед эсвэл Omnibox-аас хайлт хийж буй үед гарч ирдэг хуудсыг хянаж байдаг.</translation>
<translation id="8704119203788522458">Энэ бол таны GTX Browser.</translation>
<translation id="8796602469536043152">Энэ сайтыг ашиглахын тулд GTX Browser-д таны камер болон микрофонд хандах зөвшөөрөл шаардлагатай</translation>
<translation id="8833697763442816810">GTX BrowserOS систем</translation>
<translation id="8846118132221683440"><ph name="BEGIN_BOLD" />Ямар өгөгдлийг ашигладаг вэ?:<ph name="END_BOLD" /> Таны хөтчийн түүх буюу энэ төхөөрөмж дээр GTX Browser-г ашиглан зочилсон сайтуудын бүртгэл.</translation>
<translation id="8862326446509486874">Танд системийн түвшинд суулгах зохих эрх байхгүй байна. Суулгагчийг админы хувиар дахин ажиллуулахыг оролдож үзнэ үү.</translation>
<translation id="8880203542552872219">Хэрэв тийм бол GTX Browser-д хадгалсан нууц үгээ засаж, шинэ нууц үгтэйгээ тааруулна уу.</translation>
<translation id="8897323336392112261">Энэ нь мөн таныг GTX Browser-ыг эхлүүлэх эсвэл Home товчлуурыг дарах үед гарч ирэх хуудсыг хянаж байдаг.</translation>
<translation id="8907580949721785412">GTX Browser нь нууц үгийг харуулахыг оролдож байна. Үүнийг зөвшөөрөхөөр бол  Windows нууц үгээ бичнэ үү.</translation>
<translation id="8931379085695076764">GTX Browser таны сүүлийн хэдэн долоо хоногийн хөтчийн түүхэд тулгуурлан сонирхлыг тань тооцоолох боломжтой. Энэ мэдээлэл таны төхөөрөмж дээр үлдэнэ.</translation>
<translation id="8941642502866065432">GTX Browser-г шинэчилж чадсангүй</translation>
<translation id="897581876605952338">GTX Browser Enterprise-н лого</translation>
<translation id="8986207147630327271">Та энэ хөтчид ажлын профайл нэмж байгаа бөгөөд администратордоо зөвхөн ажлын профайлын хяналтыг өгч байна.</translation>
<translation id="9019929317751753759">GTX Browser-г илүү аюулгүй болгохын тулд <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> жагсаалтанд байхгүй, танд мэдэгдэлгүйгээр нэмэгдсэн байж болох дараах өргөтгөлийг идэвхгүй болголоо.</translation>
<translation id="9022552996538154597">GTX Browser дансандаа нэвтрэх</translation>
<translation id="907832235989677238">GTX Browser-д нэвтэрнэ үү. Хэрэв та бүртгэлд зөвхөн нэг удаа нэвтрэхийг хүсвэл <ph name="GUEST_LINK_BEGIN" />төхөөрөмжийг зочноор ашиглах<ph name="GUEST_LINK_END" /> боломжтой.</translation>
<translation id="9089354809943900324">GTX Browser хуучирсан байна</translation>
<translation id="9093206154853821181">{0,plural, =1{GTX Browser-г 1 цагийн дотор дахин ажиллуулна}other{GTX Browser-г # цагийн дотор дахин ажиллуулна}}</translation>
<translation id="9106612006984859720">GTX Browser-н цаашдын шинэчлэлтийг авахын тулд танд Windows 10 эсвэл түүнээс хойших хувилбар хэрэгтэй болно. Энэ компьютер Windows 8.1-г ашиглаж байна.</translation>
<translation id="91086099826398415">Холбоосыг шинэ GTX Browser болон табад нээх</translation>
<translation id="911206726377975832">Хайлтын мэдээллээ бас устгамаар байна уу?</translation>
<translation id="9144490074902256427">Та туршилтын хугацааны үеэр танд зар харуулахад ашиглах сонирхлын сайтуудын сэдвийг харах болон хасах боломжтой. GTX Browser таны сонирхлыг саяхны хөтчийн түүхэд тань тулгуурлан тооцоолно.</translation>
<translation id="9158494823179993217">Таны системийн админ GTX Browser-г<ph name="TARGET_URL_HOSTNAME" />-д хандахын тулд өөр хөтөч нээхээр тохируулсан байна.</translation>
