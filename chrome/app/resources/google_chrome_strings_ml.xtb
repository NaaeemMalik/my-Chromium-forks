<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ml">
<translation id="1001534784610492198">ഇന്‍സ്റ്റാളര്‍ ആര്‍ക്കൈവ് കേടായി അല്ലെങ്കില്‍ അസാധുവാണ്. ദയവായി GTX Browser വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="102763973188675173">GTX Browser ഇഷ്ടാനുസൃതമാക്കി നിയന്ത്രിക്കുക. അപ്‌ഡേറ്റ് ലഭ്യമാണ്.</translation>
<translation id="1051826050538111504">നിങ്ങളുടെ കമ്പ്യൂട്ടറിൽ ദോഷകരമായ സോഫ്‌റ്റ്‌വെയറുണ്ട്. നിങ്ങളുടെ ബ്രൗസർ വീണ്ടും സാധാരണ രീതിയിൽ പ്രവർത്തിക്കാൻ, GTX Browser-ന് ഇത് നീക്കം ചെയ്യാനും ക്രമീകരണം പുനഃസ്ഥാപിക്കാനും വിപുലീകരണം പ്രവർത്തനരഹിതമാക്കാനുമാവും.</translation>
<translation id="1065672644894730302">നിങ്ങളുടെ മുൻഗണനകൾ വായിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമല്ലായിരിക്കാം ഒപ്പം മുൻഗണനകളിലേക്കുള്ള മാറ്റങ്ങൾ സംരക്ഷിക്കപ്പെടുന്നതുമല്ല.</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" /> മുമ്പ് GTX Browser ഉപയോഗിച്ചിട്ടുണ്ട്</translation>
<translation id="110877069173485804">ഇതാണ് നിങ്ങളുടെ GTX Browser</translation>
<translation id="1125124144982679672">ആരൊക്കെയാണ് GTX Browser ഉപയോഗിക്കുന്നത്?</translation>
<translation id="1142745911746664600">GTX Browser അപ്‌ഡേറ്റ് ചെയ്യാനാവില്ല</translation>
<translation id="1154147086299354128">&amp;GTX Browser-ൽ തുറക്കുക</translation>
<translation id="1182414570724401860">ഈ ഫയൽ ഡൗൺലോഡ് ചെയ്യുകയോ തുറക്കുകയോ ചെയ്യരുതെന്ന് GTX Browser നിർദ്ദേശിക്കുന്നു</translation>
<translation id="1278833599417554002">&amp;GTX Browser അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="1293325835983155583">ഈ ഉപകരണം ഉപയോഗിക്കുന്നതിന് മുമ്പ് ഇനിപ്പറയുന്ന സേവന നിബന്ധനകൾ നിങ്ങൾ വായിച്ച് അംഗീകരിക്കണമെന്ന് <ph name="MANAGER" /> ആവശ്യപ്പെടുന്നു. ഈ നിബന്ധനകൾ GTX Browser OS നിബന്ധനകൾ വിപുലീകരിക്കുകയോ പരിഷ്‌കരിക്കുകയോ പരിമിതപ്പെടുത്തുകയോ ചെയ്യുന്നില്ല.</translation>
<translation id="1302523850133262269">ഏറ്റവും പുതിയ സിസ്‌റ്റം അപ്‌ഡേറ്റുകൾ GTX Browser ഇൻസ്റ്റാളുചെയ്യുന്നതുവരെ കാത്തിരിക്കുക.</translation>
<translation id="137466361146087520">GTX Browser ബീറ്റ</translation>
<translation id="1399397803214730675">ഈ കമ്പ്യൂട്ടറിൽ ഇപ്പോൾ തന്നെ GTX Browser-ന്റെ ഏറ്റവും പുതിയ പതിപ്പുണ്ട്. സോഫ്റ്റ്‍‍വെയർ പ്രവര്‍ത്തിക്കുന്നില്ലെങ്കില്‍, ദയവായി GTX Browser അണ്‍‌ഇന്‍സ്റ്റാള്‍ ചെയ്ത് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="1434626383986940139">GTX Browser കാനറി അപ്ലിക്കേഷനുകൾ</translation>
<translation id="1507198376417198979">നിങ്ങളുടെ പുതിയ GTX Browser പ്രൊഫൈൽ ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="1516530951338665275">ജോടിയാക്കൽ തുടരാൻ GTX Browser-ന് Bluetooth ആക്സസ് 
 ആവശ്യമാണ്. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1553358976309200471">GTX Browser അപ്‌ഡേറ്റുചെയ്യുക</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> ഇതിനകം ഈ GTX Browser പ്രൊഫൈലിൽ സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു. ഇത് <ph name="USER_EMAIL_ADDRESS" /> എന്ന അക്കൗണ്ടിനായി പുതിയൊരു GTX Browser പ്രൊഫൈൽ സൃഷ്ടിക്കും</translation>
<translation id="1587223624401073077">GTX Browser നിങ്ങളുടെ ക്യാമറ ഉപയോഗിക്കുന്നു.</translation>
<translation id="1587325591171447154"><ph name="FILE_NAME" /> അപകടകരമായതിനാൽ, GTX Browser ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="1597911401261118146">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK" />GTX Browser-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">GTX Browser സുരക്ഷിതമാക്കാൻ, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> എന്നതിൽ ലിസ്റ്റ് ചെയ്യാത്ത ചില വിപുലീകരണങ്ങൾ ഞങ്ങൾ പ്രവർത്തനരഹിതമാക്കി, അവ നിങ്ങളുടെ അറിവില്ലാതെ ചേർത്തിരിക്കാനിടയുണ്ട്.</translation>
<translation id="1628000112320670027">GTX Browser ഉപയോഗിക്കുന്നതിനുള്ള സഹായം തേടുക</translation>
<translation id="1674870198290878346">GTX Browser അദൃശ്യ വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="1682634494516646069">GTX Browser-ന് ഇതിന്റെ ഡാറ്റാ ഡയറക്റ്ററി വായിക്കാനോ അതിൽ എഴുതാനോ കഴിയില്ല:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">GTX Browser എന്നത് അതിവേഗത്തില്‍‌ വെബ്‌ പേജുകളും ആപ്പുകളും പ്രവര്‍‌ത്തിപ്പിക്കുന്ന ഒരു വെബ് ബ്രൗസറാണ്. അത് വേഗതയുള്ളതും, സ്ഥിരതയുള്ളതും ഉപയോഗിക്കാൻ എളുപ്പവുമാണ്. GTX Browser-ലേക്ക് ബില്‍‌റ്റ് ചെയ്‌ത മാൽവെയർ, ഫിഷിംഗ് പരിരക്ഷണം ഉപയോഗിച്ച് വെബ് കൂടുതല്‍‌ സുരക്ഷിതമായി ബ്രൗസ് ചെയ്യുക.</translation>
<translation id="1713301662689114961">{0,plural, =1{ഒരു മണിക്കൂറിൽ GTX Browser വീണ്ടും സമാരംഭിക്കും}other{# മണിക്കൂറിൽ GTX Browser വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="1734234790201236882">നിങ്ങളുടെ Google അക്കൗണ്ടിൽ GTX Browser ഈ പാസ്‌വേഡ് സംരക്ഷിക്കും. നിങ്ങൾ അത് ഓർത്ത് വയ്‌ക്കേണ്ടതില്ല.</translation>
<translation id="174539241580958092">സൈൻ ഇൻ ചെയ്യുന്നതിലെ ഒരു പിശകിനാൽ GTX Browser-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="1759842336958782510">GTX Browser</translation>
<translation id="1786003790898721085">നിങ്ങൾ <ph name="TARGET_DEVICE_NAME" /> ഉപകരണത്തിൽ GTX Browser-ലാണ് സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നതെന്ന് ഉറപ്പാക്കുക, തുടർന്ന് വീണ്ടും അയയ്‌ക്കാൻ ശ്രമിക്കുക.</translation>
<translation id="1812689907177901597">ഇത് ഓഫാക്കുന്നതിലൂടെ, GTX Browser-ലേക്ക് സൈൻ ഇൻ ചെയ്യാതെ തന്നെ Gmail പോലുള്ള Google സൈറ്റുകളിൽ നിങ്ങൾക്ക് സൈൻ ഇൻ ചെയ്യാനാവും</translation>
<translation id="1860536484129686729">ഈ സൈറ്റിനായി, GTX Browser-ന് നിങ്ങളുടെ ക്യാമറ ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="1873233029667955273">GTX Browser നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറല്ല</translation>
<translation id="1874309113135274312">GTX Browser ബീറ്റ (mDNS-In)</translation>
<translation id="1877026089748256423">GTX Browser കാലഹരണപ്പെട്ടതാണ്</translation>
<translation id="1919130412786645364">GTX Browser-ലേക്ക് സൈൻ ഇൻ ചെയ്യാൻ അനുവദിക്കുക</translation>
<translation id="2018528049276128029">ഓരോ പ്രൊഫൈലും ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ എന്നിവയും മറ്റും പോലുള്ള അതിന്റെ സ്വന്തം GTX Browser വിവരങ്ങൾ സൂക്ഷിക്കുന്നു</translation>
<translation id="2063848847527508675">അപ്‌ഡേറ്റ് ബാധകമാക്കാൻ GTX Browser റീസ്റ്റാർട്ട് ചെയ്യേണ്ടതുണ്ട്.</translation>
<translation id="2094919256425865063">എന്തായാലും GTX Browser-ൽ നിന്ന് പുറത്തുകടക്കണോ?</translation>
<translation id="2120620239521071941">ഇത് ഈ ഉപകരണത്തിൽ നിന്ന് <ph name="ITEMS_COUNT" /> ഇനങ്ങൾ ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL" /> എന്നയാളായി GTX Browser‌-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2121284319307530122">&amp;GTX Browser അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="2123055963409958220"><ph name="BEGIN_LINK" />നിലവിലെ ക്രമീകരണം<ph name="END_LINK" /> റിപ്പോർട്ട് ചെയ്‌തുകൊണ്ട് GTX Browser മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="2151406531797534936">GTX Browser ഇപ്പോൾ റീസ്‌റ്റാർട്ട് ചെയ്യുക</translation>
<translation id="2189289170880510015">ഏറ്റവും പ്രധാനപ്പെട്ട ചില GTX Browser സ്വകാര്യതാ തിരഞ്ഞെടുപ്പുകൾ ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="2258103955319320201">നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും GTX Browser ബ്രൗസർ ഉള്ളടക്കം ആക്സസ് ചെയ്യാൻ, സൈൻ ഇൻ ചെയ്ത ശേഷം സമന്വയിപ്പിക്കൽ ഓണാക്കുക</translation>
<translation id="2290014774651636340">Google API കീകൾ നഷ്‌ടമായി. GTX Browser-ന്‍റെ ചില പ്രവർത്തനങ്ങൾ പ്രവർത്തനരഹിതമാകും.</translation>
<translation id="2290095356545025170">GTX Browser അണിന്‍സ്റ്റാള്‍ ചെയ്യണമെന്ന് നിങ്ങള്‍ക്കുറപ്പാണോ?</translation>
<translation id="2309047409763057870">ഇത് GTX Browser-ന്റെ ദ്വിതീയ ഇൻസ്‌റ്റലേഷനായതിനാൽ, നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാക്കാൻ കഴിയില്ല.</translation>
<translation id="2345992953227471816">ഈ വിപുലീകരണങ്ങളിൽ മാൽവെയർ അടങ്ങുന്നതായി GTX Browser കണ്ടെത്തി:</translation>
<translation id="2348335408836342058">ഈ സൈറ്റിനായി, GTX Browser-ന് നിങ്ങളുടെ ക്യാമറയും മൈക്രോഫോണും ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="234869673307233423">GTX Browser-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="235650106824528204">ഈ പ്രൊഫൈലിന്റെ ഉപയോഗത്തിനിടയിൽ ഉണ്ടായ ഏത് GTX Browser ഡാറ്റയും (ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണം എന്നിവ സൃഷ്ടിക്കൽ പോലുള്ളവ) ഔദ്യോഗിക പ്രൊഫൈൽ അഡ്മിന് നീക്കം ചെയ്യാനാകും. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">തുടരുക</translation>
<translation id="2429317896000329049">നിങ്ങളുടെ ഡൊമെയ്‌‌നിനായി സമന്വയം ലഭ്യമല്ലാത്തതിനാൽ GTX Browser-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="2467438592969358367">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എക്‌സ്‌പോർട്ട് ചെയ്യാൻ GTX Browser ആഗ്രഹിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="2485422356828889247">അണ്‍‌ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യുക</translation>
<translation id="2534507159460261402">Google Pay (GTX Browser-ലേക്ക് പകർത്തി)</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> ഇതിനകം ഈ GTX Browser പ്രൊഫൈലിലേക്ക് സൈൻ ഇൻ ചെയ്തിരിക്കുന്നു. നിങ്ങൾക്ക് ഒറ്റയ്ക്ക് ബ്രൗസ് ചെയ്യാൻ, GTX Browser-ന് നിങ്ങളുടെ സ്വന്തം പ്രൊഫൈൽ സൃഷ്‌ടിക്കാനാകും.</translation>
<translation id="2580411288591421699">നിലവില്‍‌ പ്രവർത്തിക്കുന്ന GTX Browser പതിപ്പിന് സമാനമായത് ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യാന്‍‌ കഴിയില്ല. ദയവായി GTX Browser അടച്ചശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="2586406160782125153">ഇത് ഈ ഉപകരണത്തിൽ നിന്ന് നിങ്ങളുടെ ബ്രൗസിംഗ് വിവരങ്ങൾ ഇല്ലാതാക്കും. പിന്നീട് വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL" /> എന്നയാളായി GTX Browser‌-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="2622559029861875898">GTX Browser-ന് അപ്‌ഡേറ്റുകൾക്കായി പരിശോധിക്കാനാവില്ല. നിങ്ങളുടെ ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിക്കുക.</translation>
<translation id="2644798301485385923">GTX Browser OS സിസ്‌റ്റം</translation>
<translation id="2652691236519827073">പുതിയ GTX Browser &amp;ടാബിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="2665296953892887393">Google-ലേക്ക് ക്രാഷ് റിപ്പോർട്ടുകളും <ph name="UMA_LINK" /> എന്നതും അയയ്‌ക്കുന്നതിലൂടെ GTX Browser മികച്ചതാക്കാൻ സഹായിക്കുക</translation>
<translation id="2689103672227170538">നിങ്ങൾ GTX Browser ആരംഭിക്കുമ്പോൾ ദൃശ്യമാകുന്ന പേജിനെ ഈ വിപുലീകരണം മാറ്റി.</translation>
<translation id="2742320827292110288">മുന്നറിയിപ്പ്: നിങ്ങളുടെ ബ്രൗസിംഗ് ചരിത്രം റെക്കോർഡ് ചെയ്യുന്നതിൽ നിന്ന് വിപുലീകരണങ്ങളെ തടയാൻ GTX Browser-ന് കഴിയില്ല. അദൃശ്യമോഡിൽ ഈ വിപുലീകരണം പ്രവർത്തനരഹിതമാക്കാൻ, ഈ ഓപ്ഷൻ തിരഞ്ഞെടുത്തത് റദ്ദാക്കുക.</translation>
<translation id="2765403129283291972">ഈ സൈറ്റിനായി, GTX Browser-ന് നിങ്ങളുടെ മൈക്രോഫോൺ ആക്‌സസ് ചെയ്യാനുള്ള അനുമതി ആവശ്യമാണ്</translation>
<translation id="2770231113462710648">ഡിഫോൾട്ട് ബ്രൗസര്‍‌ ഇനിപ്പറയുന്നതിലേക്ക് മാറ്റുക:</translation>
<translation id="2775140325783767197">GTX Browser-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവില്ല. നിങ്ങളുടെ ഇന്റർനെറ്റ് കണക്ഷൻ പരിശോധിക്കുക.</translation>
<translation id="2799223571221894425">വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="2847461019998147611">ഈ ഭാഷയില്‍‌ GTX Browser പ്രദര്‍‌ശിപ്പിക്കുക</translation>
<translation id="2857540653560290388">GTX Browser സമാരംഭിക്കുന്നു...</translation>
<translation id="2857972467023607093">ഈ അക്കൗണ്ടുള്ള ഒരു GTX Browser പ്രൊഫൈൽ നിലവിലുണ്ട്</translation>
<translation id="2861074815332034794">GTX Browser അപ്‌ഡേറ്റ് ചെയ്യുന്നു (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">നിങ്ങൾ GTX Browser-ൽ സൈൻ ഇൻ ചെയ്‌തു!</translation>
<translation id="2885378588091291677">ടാസ്‌ക് മാനേജര്‍</translation>
<translation id="2888126860611144412">GTX Browser-നെ കുറിച്ച്</translation>
<translation id="2926676257163822632">ദുർബലമായ പാസ്‌വേഡുകൾ ഊഹിക്കാൻ എളുപ്പമാണ്. <ph name="BEGIN_LINK" />നിങ്ങൾക്കായി ശക്തമായ പാസ്‌വേഡുകൾ സൃഷ്ടിക്കാനും ഓർമ്മിക്കാനും<ph name="END_LINK" /> GTX Browser-നെ അനുവദിക്കുക.</translation>
<translation id="2926952073016206995">GTX Browser-ന് ഈ സൈറ്റിനായി ക്യാമറാ അനുമതി ആവശ്യമാണ്</translation>
<translation id="2929907241665500097">GTX Browser അപ്‌ഡേറ്റ് ചെയ്തില്ല, എന്തോ കുഴപ്പമുണ്ടായി. <ph name="BEGIN_LINK" />GTX Browser അപ്‌ഡേറ്റ് സംബന്ധിച്ച പ്രശ്നങ്ങളും പരാജയപ്പെട്ട അപ്ഡേറ്റുകളും പരിഹരിക്കുക.<ph name="END_LINK" /></translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" /> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - GTX Browser</translation>
<translation id="3037838751736561277">GTX Browser ഒരു പശ്ചാത്തല മോഡിലാണ്.</translation>
<translation id="3059710691562604940">സുരക്ഷിത ബ്രൗസിംഗ് ഓഫാണ്. ഇത് ഓണാക്കാൻ GTX Browser നിർദ്ദേശിക്കുന്നു.</translation>
<translation id="3065168410429928842">GTX Browser ടാബ്</translation>
<translation id="3069821012350118710">GTX Browser അടയ്‌ക്കുന്നതുവരെ നിങ്ങൾ സന്ദർശിക്കുന്ന സൈറ്റുകൾക്ക് നിങ്ങളുടെ വിവരങ്ങൾ ഓർമ്മിക്കാനാകും</translation>
<translation id="3080151273017101988">GTX Browser അടച്ചാലും പശ്ചാത്തല ആപ്ലിക്കേഷനുകള്‍ പ്രവര്‍ത്തിപ്പിക്കുന്നത് തുടരുക</translation>
<translation id="3089968997497233615">GTX Browser-ന്റെ പുതിയതും സുരക്ഷിതവുമായ പതിപ്പ് ലഭ്യമാണ്.</translation>
<translation id="3100998948628680988">നിങ്ങളുടെ GTX Browser പ്രൊഫൈലിന് പേര് നൽകുക</translation>
<translation id="3114643501466072395">ഡാറ്റാ ലംഘനങ്ങളിൽ നിന്നും മറ്റ് സുരക്ഷാ പ്രശ്‌നങ്ങളിൽ നിന്നും നിങ്ങളുടെ മറ്റ് പാസ്‌വേഡുകൾ സുരക്ഷിതമാണോ എന്ന് പരിശോധിക്കാൻ, <ph name="BEGIN_LINK" />GTX Browser-ൽ സൈൻ ഇൻ ചെയ്യുക<ph name="END_LINK" />.</translation>
<translation id="3140883423282498090">നിങ്ങളുടെ മാറ്റങ്ങൾ അടുത്ത തവണ GTX Browser വീണ്ടും ആരംഭിക്കുമ്പോൾ പ്രാബല്യത്തിൽ വരും.</translation>
<translation id="3149510190863420837">GTX Browser അപ്ലിക്കേഷനുകൾ</translation>
<translation id="3360895254066713204">GTX Browser സഹായി‌</translation>
<translation id="3379938682270551431">{0,plural, =0{GTX Browser ഇപ്പോൾ വീണ്ടും സമാരംഭിക്കും}=1{ഒരു സെക്കൻഡിൽ GTX Browser വീണ്ടും സമാരംഭിക്കും}other{# സെക്കൻഡിൽ GTX Browser വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="3395323229510056640">GTX Browser OS ഉപയോഗിക്കാനുള്ള സഹായം തേടുക</translation>
<translation id="3396977131400919238">ഇന്‍സ്റ്റാള്‍ ചെയ്യുന്ന സമയത്ത് ഒരു ഓപ്പറേറ്റിംഗ് സിസ്റ്റം പിശക് സംഭവിച്ചു. ദയവായി GTX Browser വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="3428747202529429621">നിങ്ങൾ സൈൻ ഇൻ ആയിരിക്കുമ്പോൾ GTX Browser-ൽ നിങ്ങളെ സുരക്ഷിതരാക്കുകയും മറ്റ് Google ആപ്പുകളിൽ നിങ്ങളുടെ സുരക്ഷ മെച്ചപ്പെടുത്താനും ഉപയോഗിച്ചേക്കാം</translation>
<translation id="3434246496373299699">നിങ്ങളുടെ Google അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്യുമ്പോൾ, GTX Browser-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവും</translation>
<translation id="3451115285585441894">GTX Browser-ലേക്ക് ചേർക്കുന്നു...</translation>
<translation id="345171907106878721">GTX Browser-ലേക്ക് സ്വയം ചേരുക</translation>
<translation id="34857402635545079">GTX Browser-ൽ നിന്നും ഡാറ്റ മായ്ക്കുക (<ph name="URL" />)</translation>
<translation id="3503306920980160878">ഈ സൈറ്റുമായി ലൊക്കേഷൻ പങ്കിടാൻ GTX Browser-ന് നിങ്ങളുടെ ലൊക്കേഷനിലേക്കുള്ള ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="3533694711092285624">സംരക്ഷിച്ച പാസ്‌വേഡുകളൊന്നുമില്ല. നിങ്ങളുടെ പാസ്‌വേഡുകൾ സംരക്ഷിക്കുകയാണങ്കിൽ, GTX Browser-ന് അവ പരിശോധിക്കാനാവും.</translation>
<translation id="3541482654983822893">GTX Browser-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. 24 മണിക്കൂറിന് ശേഷം വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="3576528680708590453"><ph name="TARGET_URL_HOSTNAME" /> ആക്‌സസ് ചെയ്യാൻ ഇതര ബ്രൗസർ തുറക്കുന്നതിനായി നിങ്ങളുടെ സിസ്‌റ്റം അഡ്‌മിൻ GTX Browser കോൺഫിഗർ ചെയ്‌തു.</translation>
<translation id="3582972582564653026">നിങ്ങളുടെ ഉപകരണങ്ങളിലുടനീളം GTX Browser സമന്വയിപ്പിച്ച് വ്യക്തിഗതമാക്കുക</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{അപ്‌ഡേറ്റ് ബാധകമാക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു}=1{അപ്‌ഡേറ്റ് ബാധകമാക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{അപ്‌ഡേറ്റ് ബാധകമാക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="3622797965165704966">ഇപ്പോൾ നിങ്ങളുടെ Google അക്കൗണ്ട് ഉപയോഗിച്ച്, പങ്കിട്ട കമ്പ്യൂട്ടറുകളിൽ Chromium ഉപയോഗിക്കാൻ എളുപ്പമാണ്.</translation>
<translation id="3673813398384385993">"<ph name="EXTENSION_NAME" />" എന്നതിൽ മാൽ‌വെയർ അടങ്ങുന്നതായി GTX Browser കണ്ടെത്തി</translation>
<translation id="3678552270983184277">മിക്ക ആളുകൾക്കും ഡിഫോൾട്ട് ക്രമീകരണം അനുയോജ്യമായിരിക്കും, എന്നാൽ നിങ്ങൾക്ക് GTX Browser ഉപയോഗിക്കേണ്ട രീതിയിൽ അവ ഇഷ്ടാനുസൃതമാക്കാം</translation>
<translation id="3718181793972440140">ഇത് ഈ ഉപകരണത്തിൽ നിന്നും ഒരിനം ഇല്ലാതാക്കും. പിന്നീട് നിങ്ങളുടെ വിവരങ്ങൾ വീണ്ടെടുക്കാൻ, <ph name="USER_EMAIL" /> എന്നയാളായി GTX Browser-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="3735758079232443276">നിങ്ങൾ GTX Browser ആരംഭിക്കുമ്പോൾ ദൃശ്യമാകുന്ന പേജിനെ "<ph name="EXTENSION_NAME" />" വിപുലീകരണം മാറ്റി.</translation>
<translation id="3779473566290487688">ഭാവിയിലെ GTX Browser അപ്‌ഡേറ്റുകൾ ലഭിക്കാൻ, നിങ്ങൾക്ക് OS X 10.11 അല്ലെങ്കിൽ അതിനുശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്. ഈ കമ്പ്യൂട്ടർ OS X 10.10 ഉപയോഗിക്കുന്നു.</translation>
<translation id="3780814664026482060">GTX Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="3835168907083856002">ഇത് <ph name="USER_EMAIL_ADDRESS" /> എന്ന അക്കൗണ്ടിനായി പുതിയൊരു GTX Browser പ്രൊഫൈൽ സൃഷ്ടിക്കും</translation>
<translation id="386202838227397562">ദയവായി എല്ലാ GTX Browser വിന്‍‌ഡോകളും അടച്ച് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="3865754807470779944">GTX Browser പതിപ്പ് <ph name="PRODUCT_VERSION" /> ഇൻസ്റ്റാൾ ചെയ്തിരിക്കുന്നു</translation>
<translation id="3873044882194371212">GTX Browser അദൃശ്യ വിൻഡോയിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="3889417619312448367">GTX Browser അണ്‍‌ഇന്‍സ്റ്റാള്‍ ചെയ്യുക</translation>
<translation id="4050175100176540509">ഏറ്റവും പുതിയ പതിപ്പിൽ പ്രധാനപ്പെട്ട സുരക്ഷാ മെച്ചപ്പെടുത്തലുകളും പുതിയ ഫീച്ചറുകളും ലഭ്യമാണ്.</translation>
<translation id="4053720452172726777">GTX Browser ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക</translation>
<translation id="4110895483821904099">നിങ്ങളുടെ പുതിയ GTX Browser പ്രൊഫൈൽ സജ്ജീകരിക്കുക</translation>
<translation id="4147555960264124640">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിനിസ്‌ട്രേറ്റർക്ക് നിങ്ങളുടെ GTX Browser പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള GTX Browser ഡാറ്റ <ph name="USER_NAME" /> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. Google അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാൻ കഴിയുമെങ്കിലും ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. <ph name="LEARN_MORE" /></translation>
<translation id="4149882025268051530">ആര്‍ക്കൈവ് അണ്‍‌കം‌പ്രസ് ചെയ്യാന്‍ ഇന്‍സ്റ്റാളറിന് കഴിഞ്ഞില്ല. ദയവായി GTX Browser വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="4191857738314598978">{0,plural, =1{ഒരു ദിവസത്തിനുള്ളിൽ GTX Browser വീണ്ടും സമാരംഭിക്കുക}other{# ദിവസത്തിനുള്ളിൽ GTX Browser വീണ്ടും സമാരംഭിക്കുക}}</translation>
<translation id="4205939740494406371">GTX Browser-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവുന്നില്ല. 24 മണിക്കൂറിന് ശേഷം വീണ്ടും ശ്രമിക്കുക അല്ലെങ്കിൽ <ph name="BEGIN_LINK" />നിങ്ങളുടെ Google അക്കൗണ്ടിലെ പാസ്‌വേഡുകൾ പരിശോധിക്കുക<ph name="END_LINK" />.</translation>
<translation id="4242034826641750751">GTX Browser-ന് ഈ സൈറ്റിനായി ക്യാമറ, മൈക്രോഫോൺ അനുമതികൾ ആവശ്യമാണ്</translation>
<translation id="424864128008805179">GTX Browser-ൽ നിന്ന് സൈൻ ഔട്ട് ചെയ്യണോ?</translation>
<translation id="4251615635259297716">നിങ്ങളുടെ GTX Browser ഡാറ്റ ഈ അക്കൗണ്ടുമായി ലിങ്ക് ചെയ്യണോ?</translation>
<translation id="4281844954008187215">സേവന നിബന്ധനകൾ</translation>
<translation id="4293420128516039005">നിങ്ങളുടെ ഉപകരണങ്ങളിലുടനീളം GTX Browser സമന്വയിപ്പിച്ച് വ്യക്തിഗതമാക്കാൻ സൈൻ ഇൻ ചെയ്യുക</translation>
<translation id="4325083532956419387">GTX Browser OS പതിപ്പ്</translation>
<translation id="4328355335528187361">GTX Browser Dev (mDNS-In)</translation>
<translation id="4331809312908958774">GTX Browser OS</translation>
<translation id="4335235004908507846">ഡാറ്റാ ലംഘനങ്ങൾ, മോശം വിപുലീകരണങ്ങൾ എന്നിവയിൽ നിന്നും മറ്റും നിങ്ങളെ സുരക്ഷിതമായി നിലനിർത്താൻ GTX Browser സഹായിക്കും</translation>
<translation id="4343195214584226067"><ph name="EXTENSION_NAME" /> GTX Browser-ലേക്ക് ചേർത്തു</translation>
<translation id="4384570495110188418">നിങ്ങൾ സൈൻ ഇൻ ചെയ്‌തിട്ടില്ലാത്തതിനാൽ GTX Browser-ന് നിങ്ങളുടെ പാസ്‌വേഡുകൾ പരിശോധിക്കാനാവില്ല</translation>
<translation id="4407807842708586359">GTX Browser OS</translation>
<translation id="4427306783828095590">ഫിഷിംഗും മാല്‍വെയറും ബ്ലോക്ക് ചെയ്യുന്നതിന് മെച്ചപ്പെടുത്തിയ പരിരക്ഷ കൂടുതൽ കാര്യങ്ങൾ ചെയ്യുന്നു</translation>
<translation id="4450664632294415862">GTX Browser - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">GTX Browser-ലെ മറ്റൊരു പ്രവർത്തനം പുരോഗതിയിലാണ്. പിന്നീട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4480040274068703980">സൈൻ ഇൻ ചെയ്യുന്നതിലെ പിശക് കാരണം GTX Browser OS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="4521185804071812304">ഓപ്ഷണൽ: പ്രശ്‍നനിർണ്ണയ, ഉപയോഗ വിവരങ്ങൾ Google-ലേക്ക് സ്വയമേവ അയച്ചുകൊണ്ട് GTX Browser OS ഫീച്ചറുകൾ മെച്ചപ്പെടുത്താൻ സഹായിക്കുക.</translation>
<translation id="4561051373932531560">വെബ്ബിലുള്ള ഒരു ഫോണ്‍ നമ്പരില്‍ ക്ലിക്ക് ചെയ്യുവാനും Skype ഉപയോഗിച്ച് വിളിക്കുവാനും GTX Browser നിങ്ങളെ അനുവദിക്കുന്നു!</translation>
<translation id="4567424176335768812">നിങ്ങൾ <ph name="USER_EMAIL_ADDRESS" /> ആയി സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നു. സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്ന എല്ലാ ഉപകരണങ്ങളിലും ബുക്ക്‌മാർക്കുകളും ചരിത്രവും മറ്റ് ക്രമീകരണങ്ങളും ആക്‌സസ് ചെയ്യാൻ ഇപ്പോൾ നിങ്ങൾക്കാകും.</translation>
<translation id="4571503333518166079">GTX Browser അറിയിപ്പ് ക്രമീകരണത്തിലേക്ക് പോവുക</translation>
<translation id="459622048091363950">GTX Browser-ന് ആക്‌സസ് ലഭിച്ചുകഴിഞ്ഞാൽ, വെബ്‌സൈറ്റുകൾക്ക് നിങ്ങളോട് ആക്‌സസ് ചോദിക്കാനാകും.</translation>
<translation id="4600710005438004015">ഏറ്റവും പുതിയ പതിപ്പിലേക്ക് GTX Browser അപ്‌ഡേറ്റ് ചെയ്യാനായില്ല, അതിനാൽ പുതിയ ഫീച്ചറുകളും സുരക്ഷാ പരിഹാരങ്ങളും നിങ്ങൾക്ക് ലഭിക്കുന്നില്ല.</translation>
<translation id="4633000520311261472">GTX Browser സുരക്ഷിതമാക്കുന്നതിന്, <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> എന്നതിൽ ലിസ്റ്റുചെയ്യാത്ത ചില വിപുലീകരണങ്ങൾ ഞങ്ങൾ പ്രവർത്തനരഹിതമാക്കി, അവ നിങ്ങളുടെ അറിവില്ലാതെ ചേർത്തിരിക്കാനിടയുണ്ട്.</translation>
<translation id="4728575227883772061">വ്യക്തമല്ലാത്ത പിശക് കാരണം ഇൻസ്റ്റലേഷൻ പരാജയപ്പെട്ടു. GTX Browser നിലവില്‍ പ്രവര്‍ത്തിക്കുകയാണെങ്കില്‍, ദയവായി അത് അടച്ചിട്ട് വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="4754614261631455953">GTX Browser കാനറി (mDNS-In)</translation>
<translation id="4771048833395599659">ഈ ഫയൽ അപകടകരമാകാൻ ഇടയുള്ളതിനാൽ GTX Browser ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="479167709087336770">Google തിരയലിൽ ഉപയോഗിക്കുന്ന അതേ സ്പെൽ ചെക്കർ ഇത് ഉപയോഗിക്കുന്നു. ബ്രൗസറിൽ നിങ്ങൾ ടൈപ്പ് ചെയ്യുന്ന ടെക്‌സ്‌റ്റ് Google-ന് അയയ്ക്കുന്നു. ക്രമീകരണത്തിൽ എപ്പോഴും ഈ രീതി മാറ്റാനാകും.</translation>
<translation id="4891791193823137474">പശ്ചാത്തലത്തില്‍ GTX Browser പ്രവര്‍ത്തിക്കാന്‍ അനുവദിക്കുക</translation>
<translation id="4895437082222824641">പുതിയ GTX Browser &amp;ടാബിൽ ലിങ്ക് തുറക്കുക</translation>
<translation id="4953650215774548573">GTX Browser-നെ നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറായി സജ്ജീകരിക്കുക</translation>
<translation id="495931528404527476">GTX Browser-ൽ</translation>
<translation id="4970761609246024540">GTX Browser പ്രൊഫൈലുകളിലേക്ക് സ്വാഗതം</translation>
<translation id="4990567037958725628">GTX Browser Canary</translation>
<translation id="5062123544085870375">GTX Browser OS പുനഃരാരംഭിക്കുക</translation>
<translation id="5132929315877954718">GTX Browser-നായി മികച്ച അപ്ലിക്കേഷനുകളും വിപുലീകരണങ്ങളും തീമുകളും കണ്ടെത്തുക.</translation>
<translation id="5139423532931106058">നിങ്ങളുടെ GTX Browser പ്രൊഫൈൽ ഇഷ്‌ടാനുസൃതമാക്കുക</translation>
<translation id="5163087008893166964">GTX Browser-ലേക്ക് സ്വാഗതം; പുതിയ ബ്രൗസർ വിൻഡോ തുറന്നു</translation>
<translation id="5170938038195470297">നിങ്ങളുടെ പ്രൊഫൈൽ GTX Browser-ന്റെ ഒരു പുതിയ പതിപ്പിൽ നിന്നായതിനാൽ ഉപയോഗിക്കാൻ കഴിയില്ല.

ചില സവിശേഷതകൾ ലഭ്യമല്ലാതായിരിക്കാം. ദയവായി ഒരു വ്യത്യസ്തമായ പ്രൊഫൈൽ ഡയറക്ടറി വ്യക്തമാക്കുക അല്ലെങ്കിൽ GTX Browser-ന്റെ ഒരു പുതിയ പതിപ്പ് ഉപയോഗിക്കുക.</translation>
<translation id="5193136243808726294">GTX Browser OS-ന് ഈ പേജ് തുറക്കാനാവില്ല.</translation>
<translation id="521447420733633466">നിങ്ങളൊരു ഉപകരണം പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്ക് താൽപ്പര്യമുള്ള തരത്തിൽ GTX Browser സജ്ജമാക്കാനുമാകും</translation>
<translation id="5251420635869119124">അതിഥികൾക്ക് ഒന്നും ശേഷിപ്പിക്കാതെ തന്നെ GTX Browser ഉപയോഗിക്കാനാവും.</translation>
<translation id="5251679006894510177">എകദേശം അപ് റ്റു ഡേറ്റാണ്! അപ്‌ഡേറ്റ് ചെയ്യൽ പൂർത്തിയാക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കുക. അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.</translation>
<translation id="5334487786912937552">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ GTX Browser-ന് സ്റ്റോറേജ് ആക്‌സസ് അനുമതി ആവശ്യമാണ്</translation>
<translation id="5386244825306882791">നിങ്ങൾ GTX Browser ആരംഭിയ്ക്കുമ്പോഴോ ഓമ്‌നിബോക്‌സിൽ നിന്ന് തിരയുമ്പോഴോ ദൃശ്യമാകുന്ന പേജും അത് നിയന്ത്രിയ്ക്കുന്നു.</translation>
<translation id="5394833366792865639">ഒരു GTX Browser ടാബ് പങ്കിടുക</translation>
<translation id="5430073640787465221">നിങ്ങളുടെ മുൻഗണനാ ഫയൽ കേടായതാണ് അല്ലെങ്കിൽ അസാധുവാണ്.

നിങ്ങളുടെ ക്രമീകരണം വീണ്ടെടുക്കാൻ GTX Browser-ന് കഴിയില്ല.</translation>
<translation id="556024056938947818">GTX Browser പാസ്‌വേഡുകൾ ദൃശ്യമാക്കാൻ ശ്രമിക്കുന്നു.</translation>
<translation id="5566025111015594046">GTX Browser (mDNS-In)</translation>
<translation id="5657226924540934362">ഈ പേജിൽ ക്രമീകരണം കാണിക്കുന്നില്ലെങ്കിൽ, <ph name="LINK_BEGIN" />
      GTX Browser OS ക്രമീകരണത്തിൽ<ph name="LINK_END" /> പരിശോധിക്കുക</translation>
<translation id="565744775970812598"><ph name="FILE_NAME" /> അപകടകരമാകാൻ ഇടയുള്ളതിനാൽ, GTX Browser ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു}=1{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{ഈ അപ്‌ഡേറ്റ് പ്രയോഗിക്കുന്നതിന് GTX Browser വീണ്ടും ആരംഭിക്കാൻ നിങ്ങളുടെ അഡ്‌മിൻ ആവശ്യപ്പെടുന്നു നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="5686916850681061684">GTX Browser ഇഷ്‌ടാനുസൃതമാക്കുക, നിയന്ത്രിക്കുക. എന്തോ ഒന്നിന് നിങ്ങളുടെ ശ്രദ്ധ വേണം -വിശദാംശങ്ങൾക്ക് ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5715063361988620182">{SECONDS,plural, =1{GTX Browser ഒരു സെക്കൻഡിൽ പുനഃരാരംഭിക്കും}other{GTX Browser # സെക്കൻഡിൽ പുനഃരാരംഭിക്കും}}</translation>
<translation id="5736850870166430177">ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുകയോ നിങ്ങൾ ദോഷകരമായ ഒരു ഫയൽ ഡൗൺലോഡ് ചെയ്യുകയോ ആണെങ്കിൽ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെ URL-കളും സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് GTX Browser അയച്ചേക്കാം</translation>
<translation id="573759479754913123">GTX Browser OS-നെക്കുറിച്ച്</translation>
<translation id="5756509061973259733">ഈ അക്കൗണ്ടുള്ള GTX Browser പ്രൊഫൈൽ ഈ ഉപകരണത്തിൽ നിലവിലുണ്ട്</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> - GTX Browser Canary</translation>
<translation id="5804318322022881572">GTX Browser ലോഞ്ച് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കുക.</translation>
<translation id="5867197326698922595">പാസ്‌വേഡുകൾ GTX Browser എഡിറ്റ് ചെയ്യാൻ ശ്രമിക്കുന്നു.</translation>
<translation id="5895138241574237353">പുനരാരംഭിക്കുക</translation>
<translation id="5901850848447342934">നിങ്ങൾ GTX Browser അടയ്ക്കുമ്പോൾ <ph name="BEGIN_BOLD" />മിക്ക സൈറ്റുകളിൽ നിന്നും സൈൻ ഔട്ട് ചെയ്യും<ph name="END_BOLD" />. സമന്വയിപ്പിക്കൽ ഓഫാണെങ്കിൽ, നിങ്ങളും<ph name="BEGIN_BOLD" />Google സേവനങ്ങളിൽ നിന്നും GTX Browser-ൽ നിന്നും സൈൻ ഔട്ട് ചെയ്യും<ph name="END_BOLD" />.</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - നെറ്റ്‌വർക്ക് സൈൻ ഇൻ</translation>
<translation id="5940385492829620908">നിങ്ങളുടെ വെബും ബുക്ക്മാർക്കുകളും മറ്റ് GTX Browser ഫയലും ഇവിടെ തത്സമയമാണ്.</translation>
<translation id="5941830788786076944">GTX Browser-നെ ഡിഫോൾട്ട് ബ്രൗസർ ആക്കുക</translation>
<translation id="6070348360322141662">കൂടുതൽ സുരക്ഷ ലഭ്യമാക്കാൻ, GTX Browser നിങ്ങളുടെ ഡാറ്റ എന്‍‌ക്രിപ്‌റ്റ് ചെയ്യും</translation>
<translation id="608006075545470555">ഈ ബ്രൗസറിലേക്ക് ഔദ്യോഗിക പ്രൊഫൈൽ ചേർക്കുക</translation>
<translation id="608496399798299674">CloudReady 2.0</translation>
<translation id="6113794647360055231">GTX Browser കൂടുതൽ മികച്ചതായി</translation>
<translation id="6145313976051292476">GTX Browser-ൽ PDF-കൾ തുറക്കുക</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - GTX Browser</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> - GTX Browser ബീറ്റ</translation>
<translation id="6235018212288296708">mDNS ട്രാഫിക് അനുവദിക്കാൻ GTX Browser-നുള്ള ഇൻബൗണ്ട് റൂൾ.</translation>
<translation id="6291089322031436445">GTX Browser Dev ആപ്പുകൾ</translation>
<translation id="6291549208091401781">നിങ്ങളുടെ കമ്പ്യൂട്ടറിലെ എല്ലാ ഉപയോക്താക്കൾക്കുമായി GTX Browser നിലവിൽ ഇൻസ്റ്റാൾ ചെയ്‌തിരിക്കുന്നു.</translation>
<translation id="6368958679917195344">അനുബന്ധ <ph name="BEGIN_LINK_CROS_OSS" />ഓപ്പണ്‍ ഉറവിട സോഫ്റ്റ്‍‌വെയർ<ph name="END_LINK_CROS_OSS" /> ഉപയോഗിച്ചാണ് GTX Browser OS നിര്‍മ്മിച്ചിരിക്കുന്നത്.</translation>
<translation id="6412673304250309937">GTX Browser-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു. ഒരു സൈറ്റ് നിങ്ങളുടെ പാസ്‌വേഡ് മോഷ്‌ടിക്കാൻ ശ്രമിക്കുമ്പോഴോ നിങ്ങൾ ഒരു ദോഷകരമായ ഫയൽ ഡൗൺലോഡ് ചെയ്യുമ്പോഴോ, പേജ് ഉള്ളടക്കത്തിന്റെ ബിറ്റുകൾ ഉൾപ്പെടെയുള്ള URL-കളും GTX Browser സുരക്ഷിത ബ്രൗസിംഗിലേക്ക് അയച്ചേക്കാം.</translation>
<translation id="6418662306461808273">നിലവിലുള്ള GTX Browser പ്രൊഫൈലിലേക്ക് മാറണോ?</translation>
<translation id="6506909944137591434">നിങ്ങളുടെ ചുറ്റുപാടുകളുടെ 3D മാപ്പ് സൃഷ്‌ടിക്കാൻ GTX Browser-ന് ക്യാമറാ അനുമതി ആവശ്യമാണ്</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - GTX Browser Dev</translation>
<translation id="6568793831116033768">GTX Browser OS സിസ്‌റ്റം</translation>
<translation id="6594121454516132231">ഓപ്പൺ വെബിനെ പരിരക്ഷിച്ച് കൊണ്ട് നിങ്ങളെ ക്രോസ്-സെെറ്റ് ട്രാക്കിംഗിൽ നിന്ന് സംരക്ഷിക്കാൻ GTX Browser പദ്ധതിയിടുന്നത് എങ്ങനെയെന്ന് കാണുക</translation>
<translation id="6676384891291319759">ഇന്റര്‍‌നെറ്റ് ആക്‌സസ് ചെയ്യുക</translation>
<translation id="6679975945624592337">പശ്ചാത്തലത്തില്‍ GTX Browser പ്രവര്‍ത്തിക്കാന്‍ അനുവദിക്കുക</translation>
<translation id="6696915334902295848">GTX Browser-ന് ഈ സൈറ്റിനായി മൈക്രോഫോൺ അനുമതി ആവശ്യമാണ്</translation>
<translation id="6739177684496155661">പുതിയ GTX Browser പ്രൊഫൈലിൽ തുടരണോ?</translation>
<translation id="6750954913813541382">അക്ഷരത്തെറ്റുകൾ പരിഹരിക്കാൻ നിങ്ങൾ ബ്രൗസറിൽ ടൈപ്പ് ചെയ്യുന്ന ടെക്‌സ്‌റ്റ് GTX Browser Google ലേക്ക് അയയ്ക്കുന്നു</translation>
<translation id="677276454032249905">എന്തായാലും GTX Browser-ൽ നിന്ന് പുറത്തുകടക്കണോ?</translation>
<translation id="683440813066116847">mDNS ട്രാഫിക് അനുവദിക്കാൻ GTX Browser കാനറിയ്‌ക്കുള്ള ഇൻബൗണ്ട് റൂൾ.</translation>
<translation id="6881299373831449287">GTX Browser അപ്‌ഡേറ്റ് ചെയ്യുന്നു</translation>
<translation id="6885412569789873916">GTX Browser ബീറ്റ ആപ്പുകൾ</translation>
<translation id="6943584222992551122">ഈ ഉപകരണത്തിൽ നിന്ന് ഈ വ്യക്തിയുടെ ബ്രൗസിംഗ് ഡാറ്റ ഇല്ലാതാകും. ഡാറ്റ വീണ്ടെടുക്കാൻ, Chromium-ത്തിലേക്ക് <ph name="USER_EMAIL" /> ആയി സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="6967962315388095737">mDNS ട്രാഫിക് അനുവദിക്കുന്നതിന് GTX Browser ബീറ്റയ്ക്ക് വേണ്ടിയുള്ള ഇൻബൗണ്ട് റൂൾ.</translation>
<translation id="6989339256997917931">GTX Browser അപ്ഡേറ്റ് ചെയ്തു, പക്ഷേ 30 ദിവസം പോലും നിങ്ങള്‍ ഇത് ഉപയോഗിച്ചിട്ടില്ല.</translation>
<translation id="7025800014283535195">നിങ്ങൾക്ക് ഇവിടെ GTX Browser പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
<translation id="7062128746136194023">നിങ്ങളുടെ രക്ഷിതാവ് GTX Browser-നുള്ള "സൈറ്റുകൾക്കും ആപ്പുകൾക്കും വിപുലീകരണങ്ങൾക്കുമുള്ള അനുമതികൾ" ഓഫാക്കി. ഈ <ph name="EXTENSION_TYPE_PARAMETER" /> ചേർക്കുന്നത് അനുവദനീയമല്ല.</translation>
<translation id="7085332316435785646">Google സേവനങ്ങളിൽ കൂടുതൽ വ്യക്തിപരമാക്കിയ അനുഭവം ലഭ്യമാകാൻ GTX Browser ചരിത്രം ഉൾപ്പെടുത്തണോ എന്ന് തിരഞ്ഞെടുക്കുക</translation>
<translation id="7088681679121566888">GTX Browser അപ് റ്റു ഡേറ്റാണ്</translation>
<translation id="7098166902387133879">GTX Browser നിങ്ങളുടെ മൈക്രോഫോൺ ഉപയോഗിക്കുന്നു.</translation>
<translation id="7106741999175697885">ടാസ്ക് മാനേജര്‍ - GTX Browser</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{GTX Browser-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും.}=1{GTX Browser-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും. നിങ്ങളുടെ അദൃശ്യ വിൻഡോ വീണ്ടും തുറക്കില്ല.}other{GTX Browser-നുള്ള പുതിയൊരു അപ്ഡേറ്റ് ലഭ്യമാണ്, നിങ്ങൾ വീണ്ടും ആരംഭിച്ച ഉടൻ തന്നെ അത് ബാധകമാക്കും. നിങ്ങളുടെ # അദൃശ്യ വിൻഡോകൾ വീണ്ടും തുറക്കില്ല.}}</translation>
<translation id="7155997830309522122">മാറ്റിയെങ്കിൽ, നിങ്ങളുടെ GTX Browser-ലെ സംരക്ഷിച്ച പാസ്‌വേഡ് എഡിറ്റ് ചെയ്യുക. എങ്കിൽ മാത്രമേ ഈ പുതിയ പാസ്‌വേഡുമായി അത് പൊരുത്തപ്പെടൂ.</translation>
<translation id="7161904924553537242">GTX Browser ലേക്ക് സ്വാഗതം</translation>
<translation id="7242029209006116544">നിങ്ങൾ ഒരു നിയന്ത്രിത അക്കൗണ്ട് ഉപയോഗിച്ച് സൈൻ ഇൻ ചെയ്‌ത് അതിന്റെ അഡ്‌മിന് നിങ്ങളുടെ GTX Browser പ്രൊഫൈലിന്റെ നിയന്ത്രണം നൽകുന്നു. നിങ്ങളുടെ ആപ്പുകൾ, ബുക്ക്‌മാർക്കുകൾ, ചരിത്രം, പാസ്‌വേഡുകൾ, മറ്റ് ക്രമീകരണങ്ങൾ എന്നിവ പോലെയുള്ള GTX Browser ഡാറ്റ <ph name="USER_NAME" /> എന്നതുമായി ശാശ്വതമായി ബന്ധിപ്പിച്ചതായിത്തീരും. Google അക്കൗണ്ട്സ് ഡാഷ്‌ബോർഡ് വഴി നിങ്ങൾക്ക് ഈ ഡാറ്റ ഇല്ലാതാക്കാൻ കഴിയുമെങ്കിലും ഈ ഡാറ്റ മറ്റൊരു അക്കൗണ്ടുമായി ബന്ധപ്പെടുത്താനാകില്ല. നിങ്ങളുടെ നിലവിലെ GTX Browser ഡാറ്റ പ്രത്യേകമായി സൂക്ഷിക്കുന്നതിന് നിങ്ങൾക്ക് ഒരു പുതിയ പ്രൊഫൈൽ ഓപ്‌ഷണലായി സൃഷ്‌ടിക്കാനാകും. <ph name="LEARN_MORE" /></translation>
<translation id="7295052994004373688">GTX Browser UI പ്രദര്‍ശിപ്പിക്കാൻ ഈ ഭാഷ ഉപയോഗിക്കുന്നു</translation>
<translation id="7296210096911315575">പ്രധാനപ്പെട്ട ഉപയോഗ, സുരക്ഷാ വിവരങ്ങൾ</translation>
<translation id="7308322188646931570">ഫയലുകൾ ഡൗൺലോഡ് ചെയ്യാൻ GTX Browser-ന് സ്റ്റോറേജ് ആക്‌സസ് ആവശ്യമാണ്</translation>
<translation id="7339898014177206373">പുതിയ വിന്‍ഡോ</translation>
<translation id="7398801000654795464">നിങ്ങൾ GTX Browser-ൽ <ph name="USER_EMAIL_ADDRESS" /> എന്നായി സൈൻ ഇൻ ചെയ്‌തു. വീണ്ടും സൈൻ ഇൻ ചെയ്യുന്നതിന് സമാന അക്കൗണ്ട് ഉപയോഗിക്കുക.</translation>
<translation id="7408085963519505752">GTX Browser OS നിബന്ധനകൾ</translation>
<translation id="7419046106786626209">നിങ്ങളുടെ ഡൊമെയ്‌‌നിനായി സമന്വയം ലഭ്യമല്ലാത്തതിനാൽ GTX Browser OS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="7481213027396403996">GTX Browser-ന്റെ ഏറ്റവും ശക്‌തമായ സുരക്ഷ നേടുക</translation>
<translation id="7486227612705979895">വിലാസ ബാറിൽ നിർദ്ദേശങ്ങൾ സൃഷ്‌ടിക്കാൻ, GTX Browser നിങ്ങളുടെ ഡ്രൈവ് ആക്‌സ‌സ് ചെയ്യും</translation>
<translation id="7535429826459677826">GTX Browser Dev</translation>
<translation id="7573289029918943991">നിങ്ങളുടെ ഉപകരണം അപ് ടു ഡേറ്റ് ആണോയെന്ന് കാണാൻ <ph name="LINK_BEGIN" />GTX Browser OS ക്രമീകരണത്തിലേക്ക്<ph name="LINK_END" /> പോവുക</translation>
<translation id="7592736734348559088">നിങ്ങളുടെ അക്കൗണ്ടിന്റെ സൈൻ ഇൻ വിശദാംശങ്ങൾ കാലഹരണപ്പെട്ടതിനാൽ GTX Browser-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="7626032353295482388">GTX Browser-ലേക്ക് സ്വാഗതം</translation>
<translation id="7629695634924605473">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എപ്പോഴെങ്കിലും അപഹരിക്കപ്പെട്ടിട്ടുണ്ടെങ്കിൽ അക്കാര്യം GTX Browser നിങ്ങളെ അറിയിക്കും</translation>
<translation id="7641148173327520642"><ph name="TARGET_URL_HOSTNAME" /> ആക്‌സസ് ചെയ്യാൻ <ph name="ALTERNATIVE_BROWSER_NAME" /> തുറക്കുന്നതിനായി നിങ്ങളുടെ സിസ്‌റ്റം അഡ്‌മിൻ GTX Browser കോൺഫിഗർ ചെയ്‌തു.</translation>
<translation id="7651907282515937834">GTX Browser എന്റർപ്രൈസ് ലോഗോ</translation>
<translation id="7665553140559834626">&amp;GTX Browser OS അപ്‌ഡേറ്റ് ചെയ്യാൻ വീണ്ടും ആരംഭിക്കുക</translation>
<translation id="7747138024166251722">ഇൻസ്റ്റാളറിന് താൽക്കാലിക ഡയറക്റ്ററി സൃഷ്‌ടിക്കാനായില്ല. ശൂന്യമായ ഡിസ്‍ക് സ്പെയിസും സോഫ്റ്റ്‌വെയർ ഇൻസ്റ്റാൾ ചെയ്യാനുള്ള അനുമതിയും പരിശോധിക്കുക.</translation>
<translation id="7748512868279796735">ഈ GTX Browser പ്രൊഫൈലിന് ഇനിപ്പറയുന്ന അക്കൗണ്ടുകൾ ലഭ്യമാണ്</translation>
<translation id="7761834446675418963">GTX Browser തുറന്ന് ബ്രൗസിംഗ് ആരംഭിക്കാൻ നിങ്ങളുടെ പേര് ക്ലിക്ക് ചെയ്യുക.</translation>
<translation id="7777080907402804672">ചിത്രത്തിൽ ഉപകാരപ്രദമായ വിവരണമില്ലെങ്കിൽ നിങ്ങൾക്കായി ഒരു വിവരണം നൽകാൻ GTX Browser ശ്രമിക്കും. വിവരണങ്ങൾ സൃഷ്‌ടിക്കാൻ, ചിത്രങ്ങൾ Google-ലേക്ക് അയയ്ക്കുന്നു. ഏതുസമയത്തും ക്രമീകരണത്തിൽ നിങ്ങൾക്കിത് ഓഫാക്കാം.</translation>
<translation id="7781002470561365167">GTX Browser ന്റെ പുതിയ പതിപ്പ് ലഭ്യമാണ്.</translation>
<translation id="778331955594035129">GTX Browser-ന് ഈ സൈറ്റിനായി ലൊക്കേഷൻ അനുമതി ആവശ്യമാണ്</translation>
<translation id="7787950393032327779">മറ്റൊരു കമ്പ്യൂട്ടറിൽ (<ph name="HOST_NAME" />) മറ്റൊരു GTX Browser പ്രോസസ് (<ph name="PROCESS_ID" />) പ്രൊഫൈൽ ഉപയോഗിക്കുന്നതുപോലെ തോന്നുന്നു. GTX Browser പ്രൊഫൈൽ ലോക്ക് ചെയ്‌തതിനാൽ ഇത് കേടാകുകയില്ല. മറ്റ് പ്രോസസ്സുകളൊന്നും ഈ പ്രൊഫൈൽ ഉപയോഗിക്കുന്നില്ലെന്ന് ഉറപ്പാണെങ്കിൽ നിങ്ങൾക്ക് പ്രൊഫൈൽ അൺലോക്ക് ചെയ്‌ത് GTX Browser വീണ്ടും സമാരംഭിക്കാം.</translation>
<translation id="7801699035218095297">പാസ്‌വേഡുകൾ പകർത്താൻ GTX Browser ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="7808348361785373670">GTX Browser-ൽ നിന്ന് നീക്കംചെയ്യുക...</translation>
<translation id="7825851276765848807">വ്യക്തമല്ലാത്ത പിശക് കാരണം ഇൻസ്റ്റലേഷൻ പരാജയപ്പെട്ടു. ദയവായി GTX Browser വീണ്ടും ഡൗൺലോഡ് ചെയ്യുക.</translation>
<translation id="7890208801193284374">നിങ്ങളൊരു കമ്പ്യൂട്ടർ പങ്കിടുകയാണെങ്കിൽ, സുഹൃത്തുക്കൾക്കും കുടുബാംഗങ്ങൾക്കും വെവ്വേറെ ബ്രൗസ് ചെയ്യാനും അവർക്കാവശ്യമുള്ള രീതിയിൽ GTX Browser സജ്ജമാക്കാനുമാകും.</translation>
<translation id="7896673875602241923">ഈ കമ്പ്യൂട്ടറിലെ GTX Browser-ൽ മുമ്പ് മറ്റാരോ <ph name="ACCOUNT_EMAIL_LAST" /> എന്നയാളായി സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്നു. നിങ്ങളുടെ വിവരങ്ങൾ പ്രത്യേകം വേർതിരിച്ച് സൂക്ഷിക്കാൻ പുതിയ GTX Browser ഉപയോക്താവിനെ സൃഷ്‌ടിക്കുക.</translation>
<translation id="7917876797003313048">സൈൻ ഇൻ ചെയ്‌തിരിക്കുന്ന Google അക്കൗണ്ടുകൾ നിങ്ങൾക്ക് മാനേജ് ചെയ്യാം. GTX Browser ബ്രൗസർ, Play Store, Gmail എന്നിവയ്ക്കും മറ്റുമായി നിങ്ങളുടെ Google അക്കൗണ്ടുകൾ ഉപയോഗിക്കുന്നു. കുടുംബാംഗത്തെ പോലുള്ള മറ്റാർക്കെങ്കിലും വേണ്ടി ഒരു അക്കൗണ്ട് ചേർക്കണമെങ്കിൽ, പകരം നിങ്ങളുടെ <ph name="DEVICE_TYPE" /> എന്നതിലേക്ക് പുതിയൊരു വ്യക്തിയെ ചേർക്കുക. <ph name="LINK_BEGIN" />കൂടുതലറിയുക<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">പാസ്‌വേഡുകൾ GTX Browser പകർത്താൻ ശ്രമിക്കുന്നു.</translation>
<translation id="7962410387636238736">Windows XP-ക്കും Windows Vista-യ്‌ക്കും ഇനിയങ്ങോട്ട് പിന്തുണ ഇല്ലാത്തതിനാൽ ഈ കമ്പ്യൂട്ടറിന് ഇനി GTX Browser അപ്‌ഡേറ്റുകൾ സ്വീകരിക്കാനാകില്ല</translation>
<translation id="79947657522496226">GTX Browser OS സാധ്യമാക്കിയത് <ph name="BEGIN_LINK_LINUX_OSS" />Linux വികസന പരിതസ്ഥിതി<ph name="END_LINK_LINUX_OSS" /> പോലുള്ള അധിക <ph name="BEGIN_LINK_CROS_OSS" />ഓപ്പൺ സോഴ്‌സ് സോഫ്‌റ്റ്‌വെയർ<ph name="END_LINK_CROS_OSS" /> ഉപയോഗിച്ചാണ്.</translation>
<translation id="8008534537613507642">GTX Browser വീണ്ടും ഇൻസ്റ്റാളുചെയ്യുക</translation>
<translation id="8013993649590906847">ചിത്രത്തിൽ ഉപകാരപ്രദമായ വിവരണമില്ലെങ്കിൽ നിങ്ങൾക്കായി ഒരു വിവരണം നൽകാൻ GTX Browser ശ്രമിക്കും. വിവരണങ്ങൾ സൃഷ്‌ടിക്കാൻ, ചിത്രങ്ങൾ Google-ലേക്ക് അയയ്ക്കുന്നു.</translation>
<translation id="8129812357326543296">&amp;GTX Browser-നെക്കുറിച്ച്</translation>
<translation id="8255190535488645436">GTX Browser നിങ്ങളുടെ ക്യാമറയും മൈക്രോഫോണും ഉപയോഗിക്കുന്നു.</translation>
<translation id="8286862437124483331">GTX Browser പാസ്‌വേഡുകൾ ദൃശ്യമാക്കാൻ ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് നൽകുക.</translation>
<translation id="828798499196665338">നിങ്ങളുടെ രക്ഷിതാവ് GTX Browser-നുള്ള "സൈറ്റുകൾക്കും ആപ്പുകൾക്കും വിപുലീകരണങ്ങൾക്കുമുള്ള അനുമതികൾ" ഓഫാക്കി. ഈ <ph name="EXTENSION_TYPE_PARAMETER" /> പ്രവർത്തനക്ഷമമാക്കുന്നത് അനുവദനീയമല്ല.</translation>
<translation id="8290100596633877290">ഓ! GTX Browser ക്രാഷുചെയ്തു. ഇപ്പോള്‍ വീണ്ടും സമാരംഭിക്കണോ?</translation>
<translation id="8342675569599923794">ഈ ഫയൽ അപകടകരമായതിനാൽ GTX Browser ഇതിനെ ബ്ലോക്കുചെയ്‌തു.</translation>
<translation id="8370517070665726704">പകർപ്പവകാശം <ph name="YEAR" /> Google LLC. എല്ലാ അവകാശങ്ങളും നിക്ഷിപ്‍തം.</translation>
<translation id="8394720698884623075">GTX Browser-ൽ സംഭരിച്ചിരിക്കുന്ന സുരക്ഷിതമല്ലാത്ത സൈറ്റുകളുടെ ലിസ്റ്റ് ഉപയോഗിച്ച് URL-കൾ പരിശോധിക്കുന്നു</translation>
<translation id="840084489713044809">നിങ്ങളുടെ പാസ്‌വേഡുകൾ എക്‌സ്‌പോർട്ട് ചെയ്യാൻ GTX Browser ആഗ്രഹിക്കുന്നു.</translation>
<translation id="8433638294851456451">ഇവിടെ നിന്ന് നിങ്ങളുടെ Android ഫോണിലേക്ക് ഒരു നമ്പർ അയയ്‌ക്കാൻ, രണ്ട് ഉപകരണങ്ങളിൽ നിന്നും GTX Browser-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8498858610309223613">GTX Browser-നുള്ള ഒരു പ്രത്യേക സുരക്ഷാ അപ്ഡേറ്റ് പ്രയോഗിച്ചിരിക്കുന്നു. ഇപ്പോൾ റീസ്‌റ്റാർട്ട് ചെയ്യുക, ഞങ്ങൾ നിങ്ങളുടെ ടാബുകൾ പുനഃസ്ഥാപിക്കും.</translation>
<translation id="8521348052903287641">mDNS ട്രാഫിക് അനുവദിക്കുന്നതിന് GTX Browser Dev-ന് വേണ്ടിയുള്ള ഇൻബൗണ്ട് റൂൾ.</translation>
<translation id="8540666473246803645">GTX Browser</translation>
<translation id="8550334526674375523">ഈ ഔദ്യോഗിക പ്രൊഫൈൽ നിങ്ങളുടെ വ്യക്തിപരമായ പ്രൊഫൈലിൽ നിന്ന് തികച്ചും വ്യത്യസ്തമാണ്.</translation>
<translation id="8556340503434111824">GTX Browser-ന്റെ പുതിയ പതിപ്പ് ലഭ്യമാണ്, അത് മുമ്പത്തേക്കാൾ വേഗതയേറിയതാണ്.</translation>
<translation id="8571790202382503603">GTX Browser പ്രൊഫൈലുകൾ ഉപയോഗിച്ച് നിങ്ങളുടെ എല്ലാ GTX Browser ഉള്ളടക്കവും വേർതിരിക്കാം. ജോലികാര്യങ്ങളും വിനോദവും പ്രത്യേകമായി തരംതിരിക്കുന്നത് ഇത് കൂടുതൽ എളുപ്പമാക്കുന്നു.</translation>
<translation id="8614913330719544658">GTX Browser പ്രതികരിക്കുന്നില്ല. ഇപ്പോള്‍ വീണ്ടും സമാരംഭിക്കണോ?</translation>
<translation id="861702415419836452">നിങ്ങളുടെ ചുറ്റുപാടിന്റെ 3D മാപ്പ് സൃഷ്ടിക്കുന്നതിന് നിങ്ങളുടെ ക്യാമറ ആക്സസ് ചെയ്യാൻ GTX Browser-ന് അനുമതി ആവശ്യമാണ്</translation>
<translation id="8625237574518804553">{0,plural, =1{ഒരു മിനിറ്റിൽ GTX Browser വീണ്ടും സമാരംഭിക്കും}other{# മിനിറ്റിൽ GTX Browser വീണ്ടും സമാരംഭിക്കും}}</translation>
<translation id="8629311577791198377">നിങ്ങൾ എല്ലാ GTX Browser വിൻഡോകളും അടയ്ക്കുമ്പോൾ, കുക്കികളും സൈറ്റ് ഡാറ്റയും സ്വയമേവ മായ്ക്കും</translation>
<translation id="8641606876632989680">അപഹരിക്കപ്പെട്ട പാസ്‌വേഡ് ഉപയോഗിച്ച് നിങ്ങൾ സൈൻ ഇൻ ചെയ്യുമ്പോൾ GTX Browser നിങ്ങളെ അറിയിക്കും</translation>
<translation id="8669527147644353129">GTX Browser സഹായി</translation>
<translation id="8679801911857917785">നിങ്ങൾ GTX Browser ആരംഭിയ്ക്കുമ്പോൾ ഏത് പേജാണ് കാണിക്കേണ്ടതെന്നും അത് നിയന്ത്രിയ്ക്കുന്നു.</translation>
<translation id="8686817260976772516">GTX Browser പ്രൊഫൈലുകൾ ഉപയോഗിച്ച് നിങ്ങളുടെ എല്ലാ GTX Browser ഉള്ളടക്കവും വേർതിരിക്കാം. സുഹൃത്തുക്കൾക്കും കുടുംബത്തിനും വ്യത്യസ്‌ത പ്രൊഫൈലുകൾ സൃഷ്‌ടിക്കൂ അല്ലെങ്കിൽ ജോലികാര്യങ്ങളും വിനോദവും പ്രത്യേകമായി തരംതിരിക്കൂ.</translation>
<translation id="873133009373065397">GTX Browser-ന് ഡിഫോൾട്ട് ബ്രൗസർ നിർണ്ണയിക്കാനോ സജ്ജമാക്കാനോ കഴിയില്ല</translation>
<translation id="8823341990149967727">GTX Browser കാലഹരണപ്പെട്ടതാണ്</translation>
<translation id="8834965163890861871">പാസ്‌വേഡുകൾ എഡിറ്റ് ചെയ്യാൻ GTX Browser ശ്രമിക്കുന്നു. ഇത് അനുവദിക്കാൻ നിങ്ങളുടെ Windows പാസ്‌വേഡ് ടൈപ്പ് ചെയ്യുക.</translation>
<translation id="884296878221830158">നിങ്ങൾ GTX Browser ആരംഭിക്കുമ്പോഴോ ഹോം ബട്ടൺ ക്ലിക്ക് ചെയ്യുമ്പോഴോ ഏത് പേജാണ് കാണിക്കേണ്ടതെന്നും അത് നിയന്ത്രിയ്ക്കുന്നു.</translation>
<translation id="8862326446509486874">സിസ്റ്റം തലത്തിൽ ഇന്‍‌സ്റ്റാള്‍‌ ചെയ്യുന്നതിന് നിങ്ങള്‍‌ക്ക് ഉചിതമായ അവകാശങ്ങളില്ല. അഡ്‌മിനിസ്‌ട്രേറ്ററായി ഇന്‍‌സ്റ്റാളര്‍‌ റണ്‍ ചെയ്യിക്കാൻ വീണ്ടും ശ്രമിക്കൂ.</translation>
<translation id="8914504000324227558">GTX Browser വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="8922193594870374009"><ph name="ORIGIN" /> എന്നതിൽ നിന്ന് നിങ്ങളുടെ Android ഫോണിലേക്ക് ഒരു നമ്പർ അയയ്‌ക്കാൻ, രണ്ട് ഉപകരണങ്ങളിൽ നിന്നും GTX Browser-ൽ സൈൻ ഇൻ ചെയ്യുക.</translation>
<translation id="8983720963221508955">നിങ്ങളുടെ അക്കൗണ്ടിൽ മെച്ചപ്പെടുത്തിയ സുരക്ഷിത ബ്രൗസിംഗ് ഓണാക്കിയിരിക്കുന്നു. ഇപ്പോൾ അത് GTX Browser-ലും നേടൂ.</translation>
<translation id="8986207147630327271">നിങ്ങൾ ഈ ബ്രൗസറിലേക്ക് ഒരു ഔദ്യോഗിക പ്രൊഫൈൽ ചേർക്കുകയും നിങ്ങളുടെ അഡ്മിന് ഔദ്യോഗിക പ്രൊഫൈലിലേക്ക് മാത്രം നിയന്ത്രണം നൽകുകയും ചെയ്യുന്നു.</translation>
<translation id="8999208279178790196">{0,plural, =0{GTX Browser-നൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}=1{GTX Browser-നൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}other{# ദിവസമായി GTX Browser-നൊരു അപ്‌ഡേറ്റ് ലഭ്യമാണ്}}</translation>
<translation id="9026991721384951619">നിങ്ങളുടെ അക്കൗണ്ടിന്റെ സൈൻ ഇൻ വിശദാംശങ്ങൾ കാലഹരണപ്പെട്ടതിനാൽ GTX Browser OS-ന് നിങ്ങളുടെ ഡാറ്റ സമന്വയിപ്പിക്കാനായില്ല.</translation>
<translation id="9067395829937117663">GTX Browser-ന് Windows 7 അല്ലെങ്കിൽ അതിനുശേഷമുള്ള പതിപ്പ് ആവശ്യമാണ്.</translation>
<translation id="911206726377975832">നിങ്ങളുടെ ബ്രൗസിംഗ് ഡാറ്റയും ഇതോടൊപ്പം ഇല്ലാതാക്കണോ?</translation>
<translation id="9138603949443464873">നിങ്ങളുടെ മാറ്റങ്ങൾ ബാധകമാക്കാൻ GTX Browser വീണ്ടും സമാരംഭിക്കുക</translation>
<translation id="919706545465235479">സമന്വയിപ്പിക്കാൻ തുടങ്ങുന്നതിന് GTX Browser അപ്‌ഡേറ്റ് ചെയ്യുക</translation>
<translation id="922152298093051471">GTX Browser ഇഷ്ടാനുസൃതമാക്കുക</translation>
<translation id="940313311831216333">നിങ്ങളുടെ എല്ലാ ഉപകരണങ്ങളിലും GTX Browser ഫയൽ ആക്സസ് ചെയ്യാൻ, സൈൻ ഇൻ ചെയ്ത ശേഷം സമന്വയിപ്പിക്കൽ ഓണാക്കുക.</translation>
<translation id="989369509083708165">GTX Browser നിങ്ങളുടെ ഡിഫോൾട്ട് ബ്രൗസറാണ്</translation>
<translation id="989816563149873169"><ph name="SHORTCUT" /> എന്നതിന് GTX Browser പ്രൊഫൈലുകൾ തമ്മിൽ പരസ്‌പരം മാറ്റാനാകും</translation>
</translationbundle>