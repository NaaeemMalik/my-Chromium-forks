<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1001534784610492198">‏آرشیو نصب‌کننده خراب یا نامعتبر است. لطفاً دوباره GTX Browser را بارگیری کنید.</translation>
<translation id="102763973188675173">‏سفارشی کردن و کنترل GTX Browser. به‌روزرسانی‌ در دسترس است.</translation>
<translation id="1051826050538111504">‏نرم‌افزار مضری در رایانه‌تان وجود دارد. GTX Browser می‌تواند آن را بردارد، تنظیمات را بازیابی کند و افزونه‌ها را غیرفعال کند تا عملکرد مرورگرتان دوباره عادی شود.</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="1088300314857992706">‏<ph name="USER_EMAIL_ADDRESS" /> قبلاً از GTX Browser استفاده می‌کرد</translation>
<translation id="110877069173485804">‏این GTX Browser شماست</translation>
<translation id="1125124144982679672">‏چه‌کسی از GTX Browser استفاده می‌کند؟</translation>
<translation id="1142745911746664600">‏به‌روزرسانی GTX Browser امکان‌پذیر نیست</translation>
<translation id="1154147086299354128">‏&amp;باز کردن در GTX Browser</translation>
<translation id="1182414570724401860">‏GTX Browser توصیه می‌کند این فایل را بارگیری یا باز نکنید</translation>
<translation id="1278833599417554002">‏راه‌اندازی مجدد برای به‌روزرسانی GTX Browser</translation>
<translation id="1293325835983155583">‏<ph name="MANAGER" /> لازم می‌داند که شما شرایط خدمات زیر را قبل‌از استفاده از دستگاه بخوانید و بپذیرید. این شرایط بسط داده نمی‌شوند، اصلاح نمی‌شوند، و شرایط GTX Browser OS را محدود نمی‌کنند.</translation>
<translation id="1302523850133262269">‏لطفاً صبر کنید تا GTX Browser جدیدترین به‌روزرسانی‌های سیستم را نصب کند.</translation>
<translation id="137466361146087520">‏GTX Browser نسخه بتا</translation>
<translation id="1399397803214730675">‏این رایانه از قبل دارای نسخه جدیدتر GTX Browser است. اگر نرم‌افزار کار نمی‌کند، لطفاً GTX Browser را حذف نصب کرده و دوباره امتحان کنید.</translation>
<translation id="1434626383986940139">‏برنامه‌های GTX Browser Canary</translation>
<translation id="1507198376417198979">‏سفارشی کردن نمایه جدید GTX Browser</translation>
<translation id="1516530951338665275">‏GTX Browser باید برای ادامه مرتبط‌سازی به بلوتوث
دسترسی داشته باشد. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1553358976309200471">‏به‌روزرسانی GTX Browser</translation>
<translation id="1583073672411044740">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه GTX Browser وارد شده است. با این کار، نمایه GTX Browser جدیدی برای <ph name="USER_EMAIL_ADDRESS" /> ایجاد خواهد شد</translation>
<translation id="1587223624401073077">‏GTX Browser درحال استفاده از دوربین شما است.</translation>
<translation id="1587325591171447154">‏<ph name="FILE_NAME" /> خطرناک است، بنابراین GTX Browser آن را مسدود کرده ست.</translation>
<translation id="1597911401261118146">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم GTX Browser وارد شوید<ph name="END_LINK" />.</translation>
<translation id="1619887657840448962">‏برای ایمن‌تر کردن GTX Browser، افزونه زیر را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده است و ممکن است بدون اطلاع شما اضافه شده باشد، غیرفعال کردیم.</translation>
<translation id="1628000112320670027">‏دریافت کمک برای GTX Browser</translation>
<translation id="1674870198290878346">‏باز کردن پیوند در پنجره &amp;ناشناس GTX Browser</translation>
<translation id="1682634494516646069">‏GTX Browser نمی‌تواند مسیر داده‌های خود را بخواند یا در آن بنویسد: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">‏GTX Browser یک مرورگر وب است که برنامه‌های کاربردی و صفحات وب را در یک چشم به هم زدن اجرا و باز می‌کند. استفاده از آن سریع و آسان است و همیشه در دسترس است. با برنامه‌های حفاظت در برابر رمزگیری و بدافزار تعبیه شده در GTX Browser، وب را با امنیت بیشتر مرور کنید.</translation>
<translation id="1713301662689114961">{0,plural, =1{‏GTX Browser یک ساعت دیگر راه‌اندازی مجدد می‌شود}one{‏GTX Browser # ساعت دیگر راه‌اندازی مجدد می‌شود}other{‏GTX Browser # ساعت دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="1734234790201236882">‏GTX Browser این گذرواژه را در حساب Google شما ذخیره می‌کند. لازم نیست آن را به خاطر بسپارید.</translation>
<translation id="174539241580958092">‏به دلیل وجود خطا در ورود به سیستم، GTX Browser قادر به همگام‌سازی داده‌های شما نبود.</translation>
<translation id="1759842336958782510">GTX Browser</translation>
<translation id="1786003790898721085">‏مطمئن شوید در <ph name="TARGET_DEVICE_NAME" /> به سیستم GTX Browser وارد شده باشید و سپس دوباره ارسال کنید.</translation>
<translation id="1812689907177901597">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم GTX Browser به سیستم سایت‌های Google مانند Gmail وارد شوید</translation>
<translation id="1860536484129686729">‏GTX Browser برای این سایت به مجوز دسترسی به دوربین نیاز دارد</translation>
<translation id="1873233029667955273">‏GTX Browser مرورگر پیش‌فرض شما نیست</translation>
<translation id="1874309113135274312">‏GTX Browser نسخه بتا (mDNS-In)</translation>
<translation id="1877026089748256423">‏نسخه GTX Browser قدیمی است</translation>
<translation id="1919130412786645364">‏مجاز کردن ورود به سیستم GTX Browser</translation>
<translation id="2018528049276128029">‏هرکدام از نمایه‌های GTX Browser دارای اطلاعات مختص خودش است (مثل نشانک‌ها، سابقه، گذرواژه‌ها، و غیره)</translation>
<translation id="2063848847527508675">‏برای اعمال به‌روزرسانی، سیستم‌عامل GTX Browser باید راه‌اندازی مجدد شود.</translation>
<translation id="2094919256425865063">‏درهرصورت از GTX Browser خارج می‌شوید؟</translation>
<translation id="2120620239521071941">‏این کار <ph name="ITEMS_COUNT" /> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم GTX Browser شوید.</translation>
<translation id="2121284319307530122">‏راه‌اندازی مجدد برای به‌روزرسانی GTX Browser</translation>
<translation id="2123055963409958220">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن GTX Browser کمک کنید</translation>
<translation id="2151406531797534936">‏لطفاً اکنون GTX Browser را بازراه‌اندازی کنید</translation>
<translation id="2189289170880510015">‏سفارشی کردن بعضی‌از مهم‌ترین انتخاب‌های حریم‌خصوصی GTX Browser</translation>
<translation id="2258103955319320201">‏برای دسترسی به چیزهایتان در مرورگر GTX Browser در همه دستگاه‌هایتان، به سیستم وارد شوید، سپس همگام‌سازی را روشن کنید</translation>
<translation id="2290014774651636340">‏کلیدهای Google API وجود ندارد. برخی از عملکردهای GTX Browser از کار خواهد افتاد.</translation>
<translation id="2290095356545025170">‏آیا می‌خواهید GTX Browser را غیر فعال کنید؟</translation>
<translation id="2309047409763057870">‏این نصب ثانویه GTX Browser است و نمی‌تواند مرورگر پیش‌فرضتان شود.</translation>
<translation id="2345992953227471816">‏GTX Browser متوجه شده است که این افزونه‌ها حاوی بدافزار هستند:</translation>
<translation id="2348335408836342058">‏GTX Browser برای این سایت به مجوز دسترسی به دوربین و میکروفون نیاز دارد</translation>
<translation id="234869673307233423">‏GTX Browser نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعداً دوباره امتحان کنید.</translation>
<translation id="235650106824528204">‏سرپرست نمایه کاری می‌تواند داده‌های GTX Browser را که درطول استفاده از این نمایه ایجاد شده‌اند (مثل ایجاد سابقه نشانک‌ها، گذرواژه‌ها، و دیگر تنظیمات) بردارد. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="2429317896000329049">‏GTX Browser قادر به همگام‌سازی داده‌های شما نبود زیرا همگام‌سازی برای دامنه شما قابل دسترسی نیست.</translation>
<translation id="2467438592969358367">‏GTX Browser می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="2534507159460261402">‏Google Pay (در GTX Browser کپی شد)</translation>
<translation id="2574930892358684005">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه GTX Browser وارد شده است. برای جدا نگه داشتن مرور، GTX Browser می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="2580411288591421699">‏نمی‌توان همان نسخه GTX Browser را که اکنون در حال اجراست نصب کرد. لطفاً GTX Browser را ببندید و دوباره سعی کنید.</translation>
<translation id="2586406160782125153">‏این کار داده‌های محصول مرورتان را برای همیشه از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم GTX Browser شوید.</translation>
<translation id="2622559029861875898">‏GTX Browser نمی‌تواند به‌روزرسانی‌ها را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="2644798301485385923">‏سیستم سیستم‌عامل GTX Browser</translation>
<translation id="2652691236519827073">‏باز کردن پیوند در &amp;برگه جدید GTX Browser</translation>
<translation id="2665296953892887393">‏با ارسال گزارش‌های خرابی و <ph name="UMA_LINK" /> به Google، به بهبود GTX Browser کمک کنید.</translation>
<translation id="2689103672227170538">‏این افزونه، صفحه‌ای را تغییر داده است که هنگام راه‌اندازی GTX Browser نشان داده می‌شود.</translation>
<translation id="2742320827292110288">‏اخطار: GTX Browser نمی تواند مانع از ثبت سابقه مرور شما توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت ناشناس»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="2765403129283291972">‏GTX Browser برای این سایت به مجوز دسترسی به میکروفون نیاز دارد</translation>
<translation id="2770231113462710648">تغییر مرورگر پیش‌فرض به:</translation>
<translation id="2775140325783767197">‏GTX Browser نمی‌تواند گذرواژه‌هایتان را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="2799223571221894425">راه‌اندازی مجدد</translation>
<translation id="2847461019998147611">‏نمایش GTX Browser به این زبان</translation>
<translation id="2857540653560290388">‏درحال راه‌اندازی GTX Browser…</translation>
<translation id="2857972467023607093">‏درحال‌حاضر یک نمایه GTX Browser با این حساب وجود دارد</translation>
<translation id="2861074815332034794">‏درحال به‌روزرسانی GTX Browser (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">‏شما در حال حاضر وارد سیستم GTX Browser شده‌اید!</translation>
<translation id="2885378588091291677">مدیر فعالیت‌ها</translation>
<translation id="2888126860611144412">‏درباره GTX Browser</translation>
<translation id="2926676257163822632">‏گذرواژه‌های ضعیف را می‌توان به‌راحتی حدس زد. به GTX Browser اجازه دهید <ph name="BEGIN_LINK" />گذرواژه‌هایی قوی برایتان ایجاد کند و آن‌ها را به‌خاطر بسپارد<ph name="END_LINK" />.</translation>
<translation id="2926952073016206995">‏GTX Browser برای این سایت به اجازه دوربین نیاز دارد</translation>
<translation id="2929907241665500097">‏GTX Browser به‌روزرسانی نشد؛ مشکلی پیش آمد. <ph name="BEGIN_LINK" />مشکلات به‌روزرسانی GTX Browser و به‌روزرسانی‌های ناموفق را برطرف کنید.<ph name="END_LINK" /></translation>
<translation id="2969728957078202736">‏<ph name="PAGE_TITLE" /> - ورود به سیستم شبکه - GTX Browser</translation>
<translation id="3037838751736561277">‏GTX Browser در حالت پس‌زمینه است.</translation>
<translation id="3059710691562604940">‏«مرور ایمن» خاموش است. GTX Browser توصیه می‌کند آن را روشن کنید.</translation>
<translation id="3065168410429928842">‏برگه GTX Browser</translation>
<translation id="3069821012350118710">‏تا زمانی‌که GTX Browser بسته نشود، سایت‌هایی که بازدید می‌کنید اطلاعاتتان را به‌خاطر می‌سپارند</translation>
<translation id="3080151273017101988">‏ادامه اجرای برنامه‌ها در پس‌زمینه هنگامیکه GTX Browser بسته می‌شود</translation>
<translation id="3089968997497233615">‏نسخه جدید و امن تری از GTX Browser موجود است.</translation>
<translation id="3100998948628680988">‏نام‌گذاری نمایه GTX Browser</translation>
<translation id="3114643501466072395">‏برای بررسی اینکه از دیگر گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود یا نه، <ph name="BEGIN_LINK" />به سیستم GTX Browser وارد شوید<ph name="END_LINK" />.</translation>
<translation id="3140883423282498090">‏دفعه بعد که GTX Browser را مجدداً راه‌اندازی می‌کنید، این تغییرات اعمال می‌شوند.</translation>
<translation id="3149510190863420837">‏برنامه‌های GTX Browser</translation>
<translation id="3360895254066713204">‏راهنمای GTX Browser</translation>
<translation id="3379938682270551431">{0,plural, =0{‏GTX Browser هم‌اکنون راه‌اندازی مجدد می‌شود}=1{‏GTX Browser ‏۱ ثانیه دیگر راه‌اندازی مجدد می‌شود}one{‏GTX Browser ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}other{‏GTX Browser ‏# ثانیه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="3395323229510056640">‏دریافت کمک از GTX Browser OS</translation>
<translation id="3396977131400919238">‏هنگام نصب یک خطای سیستم‌عامل رخ داد. لطفاً دوباره GTX Browser را بارگیری کنید.</translation>
<translation id="3428747202529429621">‏وقتی به سیستم وارد شده باشید، امنیت شما را در GTX Browser حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر Google استفاده شود</translation>
<translation id="3434246496373299699">‏GTX Browser زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که با «حساب Google» خود به سیستم وارد شوید</translation>
<translation id="3451115285585441894">‏افزودن به GTX Browser...</translation>
<translation id="345171907106878721">‏افرودن خودتان به GTX Browser</translation>
<translation id="34857402635545079">‏همچنین داده‌ها از GTX Browser پاک شود (<ph name="URL" />)</translation>
<translation id="3503306920980160878">‏GTX Browser برای هم‌رسانی مکانتان با این سایت باید به مکان شما دسترسی داشته باشد</translation>
<translation id="3533694711092285624">‏گذرواژه ذخیره‌شده‌ای وجود ندارد. GTX Browser زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید.</translation>
<translation id="3541482654983822893">‏GTX Browser نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید.</translation>
<translation id="3576528680708590453">‏سرپرست سیستم برای باز شدن مرورگری دیگر جهت دسترسی به <ph name="TARGET_URL_HOSTNAME" />، GTX Browser را پیکربندی کرده است.</translation>
<translation id="3582972582564653026">‏GTX Browser را در همه دستگاه‌هایتان همگام‌سازی و شخصی‌سازی کنید</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="3622797965165704966">‏اکنون استفاده از GTX Browser با حساب Google شما و در رایانه‌های مشترک آسان‌تر شده است.</translation>
<translation id="3673813398384385993">‏GTX Browser متوجه شده است که این «<ph name="EXTENSION_NAME" />» حاوی بدافزار است</translation>
<translation id="3678552270983184277">‏تنظیمات پیش‌فرض برای اکثر افراد کافی هستند، اما می‌توانید آن‌ها را متناسب با نحوه استفاده‌تان از GTX Browser سفارشی کنید</translation>
<translation id="3718181793972440140">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> وارد سیستم GTX Browser شوید.</translation>
<translation id="3735758079232443276">‏افزونه «<ph name="EXTENSION_NAME" />»، صفحه‌ای را تغییر داده است که هنگام راه‌اندازی GTX Browser نشان داده می‌شود.</translation>
<translation id="3779473566290487688">‏برای دریافت به‌روزرسانی‌های آتی GTX Browser، باید OS X نسخه ۱۰.۱۱ یا بالاتر داشته باشید. این رایانه از OS X نسخه ۱۰.۱۰ استفاده می‌کند.</translation>
<translation id="3780814664026482060">GTX Browser - <ph name="PAGE_TITLE" /></translation>
<translation id="3835168907083856002">‏با این کار، نمایه GTX Browser جدیدی برای <ph name="USER_EMAIL_ADDRESS" /> ایجاد خواهد شد</translation>
<translation id="386202838227397562">‏لطفاً همه پنجره‌های GTX Browser را ببندید و دوباره امتحان کنید.</translation>
<translation id="3865754807470779944">‏GTX Browser نسخه <ph name="PRODUCT_VERSION" /> نصب شده است</translation>
<translation id="3873044882194371212">‏باز کردن پیوند در پنجره &amp;ناشناس GTX Browser</translation>
<translation id="3889417619312448367">‏حذف نصب GTX Browser</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4053720452172726777">‏‫سفارشی کردن و کنترل GTX Browser</translation>
<translation id="4110895483821904099">‏راه‌اندازی نمایه GTX Browser جدید</translation>
<translation id="4147555960264124640">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه GTX Browser خود را می‌دهید. داده‌های GTX Browser شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE" /></translation>
<translation id="4149882025268051530">‏نصب‌کننده در خارج کردن آرشیو از حالت فشرده ناموفق بود. لطفاً دوباره GTX Browser را بارگیری کنید.</translation>
<translation id="4191857738314598978">{0,plural, =1{‏GTX Browser را ظرف یک روز راه‌اندازی مجدد کنید}one{‏GTX Browser را ظرف # روز راه‌اندازی مجدد کنید}other{‏GTX Browser را ظرف # روز راه‌اندازی مجدد کنید}}</translation>
<translation id="4205939740494406371">‏GTX Browser نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید یا <ph name="BEGIN_LINK" />گذرواژه‌ها را در «حساب Google» خود بررسی کنید<ph name="END_LINK" />.</translation>
<translation id="4242034826641750751">‏GTX Browser برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="424864128008805179">‏از سیستم GTX Browser خارج می شوید؟</translation>
<translation id="4251615635259297716">‏داده‌های GTX Browser شما به این حساب مرتبط شوند؟</translation>
<translation id="4281844954008187215">شرایط استفاده از سرویس</translation>
<translation id="4293420128516039005">‏برای همگام‌سازی و شخصی‌سازی GTX Browser در همه دستگاه‌هایتان، به سیستم وارد شوید</translation>
<translation id="4325083532956419387">‏نسخه GTX Browser OS</translation>
<translation id="4328355335528187361">‏GTX Browser نسخه Dev‏، (mDNS-In)</translation>
<translation id="4331809312908958774">GTX Browser OS</translation>
<translation id="4335235004908507846">‏GTX Browser می‌تواند به ایمن ماندن شما در برابر نقض داده، افزونه‌های مخرب، و خطرهای دیگر کمک کند</translation>
<translation id="4343195214584226067">‏<ph name="EXTENSION_NAME" /> به GTX Browser اضافه شده است</translation>
<translation id="4384570495110188418">‏چون به سیستم وارد نشده‌اید، GTX Browser نمی‌تواند گذرواژه‌هایتان را بررسی کند</translation>
<translation id="4407807842708586359">‏سیستم‌عامل GTX Browser</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="4450664632294415862">‏GTX Browser - ورود به سیستم شبکه - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">‏عملکرد دیگری در GTX Browser درحال انجام است. لطفاً بعداً دوباره امتحان کنید.</translation>
<translation id="4480040274068703980">‏به دلیل وجود یک خطای ورود به سیستم، سیستم‌عامل GTX Browser قادر به همگام‌سازی داده‌هایتان نبود.</translation>
<translation id="4521185804071812304">‏اختیاری: با ارسال خودکار داده‌های استفاده و عیب‌یابی به Google، به بهبود ویژگی‌ها و عملکرد سیستم‌عامل GTX Browser کمک کنید.</translation>
<translation id="4561051373932531560">‏GTX Browser به شما اجازه می‌دهد بر روی شماره تلفن روی وب کلیک کرده و از طریق Skype تماس بگیرید!</translation>
<translation id="4567424176335768812">با حساب <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم شده‌اید. اکنون در همه دستگاه‌هایی که با آنها به سیستم وارد شده‌اید می‌توانید به نشانک‌ها، سابقه و دیگر تنظیماتتان دسترسی داشته باشید.</translation>
<translation id="4571503333518166079">‏رفتن به تنظیمات اعلان GTX Browser</translation>
<translation id="459622048091363950">‏وقتی GTX Browser دسترسی داشته باشد، وب‌سایت‌ها می‌توانند مجوز دسترسی درخواست کنند.</translation>
<translation id="4600710005438004015">‏GTX Browser به جدیدترین نسخه به‌روزرسانی نشد، بنابراین قابلیت‌های جدید و رفع اشکال‌های امنیتی را ندارید.</translation>
<translation id="4633000520311261472">‏برای ایمن‌تر کردن GTX Browser، برخی از افزونه‌هایی را که در<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست نشده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="4728575227883772061">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر GTX Browser در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="4754614261631455953">‏GTX Browser Canary (ورودی mDNS)</translation>
<translation id="4771048833395599659">‏این فایل ممکن است خطرناک باشد، بنابراین GTX Browser آن را مسدود کرده است.</translation>
<translation id="479167709087336770">‏از همان غلط‌گیر املایی استفاده می‌کند که در جستجوی Google استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Google ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4891791193823137474">‏اجازه به GTX Browser برای اجرا در پس‌زمینه</translation>
<translation id="4895437082222824641">‏باز کردن پیوند در &amp;برگه جدید GTX Browser</translation>
<translation id="4953650215774548573">‏تنظیم GTX Browser به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="495931528404527476">‏در GTX Browser</translation>
<translation id="4970761609246024540">‏به نمایه‌های GTX Browser خوش‌آمدید</translation>
<translation id="4990567037958725628">GTX Browser Canary</translation>
<translation id="5062123544085870375">‏بازراه‌اندازی سیستم‌عامل GTX Browser</translation>
<translation id="5132929315877954718">‏برنامه‌های کاربردی، بازی‌ها، افزونه‌ها و طرح‌های زمینه فوق‌العاده را برای GTX Browser کاوش کنید.</translation>
<translation id="5139423532931106058">‏سفارشی کردن نمایه GTX Browser</translation>
<translation id="5163087008893166964">‏به GTX Browser خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="5170938038195470297">‏نمایهٔ شما نمی‌تواند استفاده شود زیرا مربوط به یک نسخه جدیدتر از GTX Browser است. بعضی از ویژگی‌ها ممکن است موجود نباشند. لطفاً یک مسیر دیگر برای نمایه تعیین کنید یا از نسخه جدیدتر GTX Browser استفاده کنید.</translation>
<translation id="5193136243808726294">‏GTX Browser OS نمی‌‎تواند این صفحه را باز کند.</translation>
<translation id="521447420733633466">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و GTX Browser را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="5251420635869119124">‏مهمان‌‌ها می‌توانند از GTX Browser استفاده کنند بدون اینکه اثری از خود به جا بگذارند.</translation>
<translation id="5251679006894510177">‏تقریباً به‌روزرسانی شده است! برای تکمیل به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. پنجره‌های ناشناس بازگشایی نمی‌شود.</translation>
<translation id="5334487786912937552">‏GTX Browser برای بارگیری فایل‌ها به اجازه دسترسی به فضای ذخیره‌سازی نیاز دارد</translation>
<translation id="5386244825306882791">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی GTX Browser یا جستجو از Omnibox نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="5394833366792865639">‏هم‌رسانی برگه GTX Browser</translation>
<translation id="5430073640787465221">‏فایل اولویت‌های شما خراب یا نامعتبر است. GTX Browser نمی‌تواند تنظیمات شما را بازیابی کند.</translation>
<translation id="556024056938947818">‏GTX Browser می‌خواهد گذرواژه‌ها را نمایش دهد.</translation>
<translation id="5566025111015594046">‏GTX Browser (ورودی mDNS)</translation>
<translation id="5657226924540934362">‏اگر تنظیمی در این صفحه نشان داده نمی‌شود، در <ph name="LINK_BEGIN" />
      تنظیمات مرورگر GTX Browser OS<ph name="LINK_END" /> آن را کنید</translation>
<translation id="565744775970812598">‏<ph name="FILE_NAME" /> ممکن است خطرناک باشد، بنابراین GTX Browser آن را مسدود کرده است.</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، GTX Browser را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="5686916850681061684">‏GTX Browser ‫را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="5690427481109656848">Google LLC</translation>
<translation id="5715063361988620182">{SECONDS,plural, =1{‏GTX Browser بعد از ۱ ثانیه بازراه‌اندازی می‌شود}one{‏GTX Browser بعد از # ثانیه بازراه‌اندازی می‌شود}other{‏GTX Browser بعد از # ثانیه بازراه‌اندازی می‌شود}}</translation>
<translation id="5736850870166430177">‏اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، GTX Browser ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه، به «مرور ایمن» ارسال کند</translation>
<translation id="573759479754913123">‏درباره GTX Browser OS</translation>
<translation id="5756509061973259733">‏درحال‌حاضر یک نمایه GTX Browser با این حساب در این دستگاه وجود دارد</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> - GTX Browser Canary</translation>
<translation id="5804318322022881572">‏GTX Browser راه‌اندازی نشد. دوباره امتحان کنید.</translation>
<translation id="5867197326698922595">‏GTX Browser می‌خواهد گذرواژه‌ها را ویرایش کند.</translation>
<translation id="5895138241574237353">راه‌اندازی مجدد</translation>
<translation id="5901850848447342934">‏وقتی GTX Browser را می‌بندید، <ph name="BEGIN_BOLD" />از سیستم اکثر سایت‌ها خارج می‌شوید<ph name="END_BOLD" />. اگر همگام‌سازی خاموش باشد، از <ph name="BEGIN_BOLD" />از سیستم GTX Browser و سرویس‌های Google نیز خارج می‌شوید<ph name="END_BOLD" />.</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - ورود به سیستم شبکه</translation>
<translation id="5940385492829620908">‏وب، نشانک‌ها و موارد دیگر GTX Browser شما در اینجا هستند.</translation>
<translation id="5941830788786076944">‏GTX Browser مرورگر پیش‌فرض شود</translation>
<translation id="6070348360322141662">‏برای امنیت بیشتر، GTX Browser داده‌های شما را رمزگذاری می‌کند</translation>
<translation id="608006075545470555">افزودن نمایه کاری به این مرورگر</translation>
<translation id="608496399798299674">CloudReady 2.0</translation>
<translation id="6113794647360055231">‏GTX Browser اکنون بهتر شده است</translation>
<translation id="6145313976051292476">‏بازکردن فایل‌های PDF در GTX Browser</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - GTX Browser</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> - GTX Browser Beta</translation>
<translation id="6235018212288296708">‏قانون ورودی برای GTX Browser به منظور اجازه به ترافیک mDNS.</translation>
<translation id="6291089322031436445">‏برنامه‌های GTX Browser نسخه Dev</translation>
<translation id="6291549208091401781">‏GTX Browser از قبل برای همه کاربران این رایانه نصب شده است.</translation>
<translation id="6368958679917195344">‏GTX Browser OS با یک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزار منبع آزاد<ph name="END_LINK_CROS_OSS" /> دیگر امکان‌پذیر است.</translation>
<translation id="6412673304250309937">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در GTX Browser ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، GTX Browser ممکن است نشانی‌های وب را نیز به همراه بخش‌های کوچکی از محتوای صفحه، به «مرور ایمن» ارسال کند.</translation>
<translation id="6418662306461808273">‏به نمایه GTX Browser موجود می‌روید؟</translation>
<translation id="6506909944137591434">‏GTX Browser برای ایجاد نقشه سه‌بعدی از محیط اطرافتان به اجازه دوربین نیاز دارد</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - GTX Browser Dev</translation>
<translation id="6568793831116033768">‏سیستم GTX Browser OS</translation>
<translation id="6594121454516132231">‏ببینید GTX Browser چگونه قصد دارد با حفظ وبِ باز، از شما دربرابر ردیابی بین‌سایتی محافظت کند</translation>
<translation id="6676384891291319759">دسترسی به اینترنت</translation>
<translation id="6679975945624592337">‏اجازه به GTX Browser برای اجرا در پس‌زمینه</translation>
<translation id="6696915334902295848">‏GTX Browser برای این سایت به اجازه میکروفون نیاز دارد</translation>
<translation id="6739177684496155661">‏در نمایه جدیدی از GTX Browser ادامه می‌دهید؟</translation>
<translation id="6750954913813541382">‏GTX Browser برای رفع غلط‌های املایی، نوشتاری را که در مرورگر تایپ می‌کنید به Google ارسال می‌کند</translation>
<translation id="677276454032249905">‏درهرصورت از GTX Browser خارج می‌شوید؟</translation>
<translation id="683440813066116847">‏قانون ترافیک ورودی برای GTX Browser Canary به منظور اجازه به ترافیک mDNS .</translation>
<translation id="6881299373831449287">‏درحال به‌روزرسانی GTX Browser</translation>
<translation id="6885412569789873916">‏برنامه‌های GTX Browser نسخه بتا</translation>
<translation id="6943584222992551122">‏داده‌های محصول مرور این فرد از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL" /> به سیستم GTX Browser وارد شوید.</translation>
<translation id="6967962315388095737">‏قانون ترافیک ورودی GTX Browser نسخه بتا برای امکان دادن به ترافیک mDNS.</translation>
<translation id="6989339256997917931">‏GTX Browser به روز شده است اما حداقل ۳۰ روز از آن استفاده نکرده‌اید.</translation>
<translation id="7025800014283535195">‏می‌توانید در اینجا بین نمایه‌های GTX Browser جابه‌جا شوید</translation>
<translation id="7062128746136194023">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای GTX Browser خاموش کرده است. افزودن این <ph name="EXTENSION_TYPE_PARAMETER" /> مجاز نیست.</translation>
<translation id="7085332316435785646">‏انتخاب کنید که آیا سابقه GTX Browser برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Google لحاظ شود یا نه</translation>
<translation id="7088681679121566888">‏GTX Browser به‌روز است</translation>
<translation id="7098166902387133879">‏GTX Browser درحال استفاده از میکروفون شما است.</translation>
<translation id="7106741999175697885">‏مدیر فعالیت‌ها - GTX Browser</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای GTX Browser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای GTX Browser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای GTX Browser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای GTX Browser در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="7155997830309522122">‏در این صورت، لطفاً گذرواژه ذخیره‌شده در GTX Browser را ویرایش کنید تا با گذرواژه جدیدتان مطابقت داشته باشد.</translation>
<translation id="7161904924553537242">‏به GTX Browser خوش آمدید</translation>
<translation id="7242029209006116544">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه GTX Browser خود را می‌دهید. داده‌های GTX Browser شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Google حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های GTX Browser موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE" /></translation>
<translation id="7295052994004373688">‏از این زبان برای نمایش میانای کاربر GTX Browser استفاده می‌شود</translation>
<translation id="7296210096911315575">اطلاعات مهم درباره استفاده و ایمنی</translation>
<translation id="7308322188646931570">‏GTX Browser برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="7339898014177206373">پنجرهٔ جدید</translation>
<translation id="7398801000654795464">‏شما بعنوان <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم GTX Browser شدید. لطفاً برای ورود به سیستم مجدد از همان حساب استفاده کنید.</translation>
<translation id="7408085963519505752">‏شرایط GTX Browser OS</translation>
<translation id="7419046106786626209">‏سیستم‌عامل GTX Browser قادر به همگام‌سازی داده‌هایتان نبود زیرا همگام‌سازی برای دامنه شما قابل دسترسی نیست.</translation>
<translation id="7481213027396403996">‏دریافت قوی‌ترین امنیت GTX Browser</translation>
<translation id="7486227612705979895">‏GTX Browser برای ارائه پیشنهاد در نوار نشانی، به Drive شما دسترسی خواهد داشت</translation>
<translation id="7535429826459677826">‏GTX Browser نسخه Dev</translation>
<translation id="7573289029918943991">‏برای اینکه ببینید دستگاهتان به‌روز است یا نه، به <ph name="LINK_BEGIN" />تنظیمات GTX Browser OS<ph name="LINK_END" /> بروید</translation>
<translation id="7592736734348559088">‏GTX Browser قادر به همگام‌سازی داده‌های شما نبود زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="7626032353295482388">‏به GTX Browser خوش آمدید</translation>
<translation id="7629695634924605473">‏GTX Browser می‌تواند، اگر گذرواژه‌هایتان در معرض خطر باشد، مطلعتان کند</translation>
<translation id="7641148173327520642">‏سرپرست سیستم برای باز شدن <ph name="ALTERNATIVE_BROWSER_NAME" /> جهت دسترسی به <ph name="TARGET_URL_HOSTNAME" />، GTX Browser را پیکربندی کرده است.</translation>
<translation id="7651907282515937834">‏نشان‌واره GTX Browser Enterprise</translation>
<translation id="7665553140559834626">‏راه‌اندازی مجدد برای به‌روزرسانی GTX Browser OS</translation>
<translation id="7747138024166251722">نصب‌کننده نتوانست دایرکتوری موقت ایجاد کند. لطفاً فضای خالی دیسک و اجازه نصب نرم‌افزار را بررسی کنید.</translation>
<translation id="7748512868279796735">‏حساب‌های زیر برای این نمایه GTX Browser دردسترس هستند</translation>
<translation id="7761834446675418963">‏برای باز کردن GTX Browser و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="7777080907402804672">‏اگر تصویری توضیح مفیدی نداشته باشد، GTX Browser توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Google ارسال می‌شود. هروقت خواستید می‌توانید این گزینه را در تنظیمات خاموش کنید.</translation>
<translation id="7781002470561365167">‏نسخه جدیدی از GTX Browser موجود است.</translation>
<translation id="778331955594035129">‏GTX Browser برای این سایت به اجازه مکان نیاز دارد</translation>
<translation id="7787950393032327779">‏ظاهراً نمایه توسط فرآیند GTX Browser دیگری (<ph name="PROCESS_ID" />) در رایانه‌ای دیگر (<ph name="HOST_NAME" />) در حال استفاده است. GTX Browser نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرآیندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و GTX Browser را مجدداً راه‌اندازی نمایید.</translation>
<translation id="7801699035218095297">‏GTX Browser می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="7808348361785373670">‏حذف از GTX Browser...</translation>
<translation id="7825851276765848807">‏بدلیل خطای نامشخص، نصب ناموفق بود. لطفاً دوباره GTX Browser را بارگیری کنید.</translation>
<translation id="7890208801193284374">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و GTX Browser را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="7896673875602241923">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST" /> به سیستم GTX Browser در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر GTX Browser جدیدی ایجاد کنید.</translation>
<translation id="7917876797003313048">‏می‌توانید «حساب‌های Google» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Google» شما در مرورگر GTX Browser، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE" /> خود اضافه کنید. <ph name="LINK_BEGIN" />بیشتر بدانید<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">‏GTX Browser می‌خواهد گذرواژه‌ها را کپی کند.</translation>
<translation id="7962410387636238736">‏این رایانه دیگر به‌روزرسانی‌های GTX Browser را دریافت نمی‌کند زیرا Windows XP و Windows Vista دیگر پشتیبانی نمی‌شوند</translation>
<translation id="79947657522496226">‏ساخت GTX Browser OS به‌وسیله <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزار متن‌باز<ph name="END_LINK_CROS_OSS" /> دیگری که <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS" /> است، امکان‌پذیر شده است.</translation>
<translation id="8008534537613507642">‏نصب مجدد GTX Browser</translation>
<translation id="8013993649590906847">‏اگر تصویری توضیح مفیدی نداشته باشد، GTX Browser توضیحی برای شما ارائه خواهد کرد. برای ایجاد توضیحات، تصاویر به Google ارسال می‌شود.</translation>
<translation id="8129812357326543296">‏درباره &amp;GTX Browser</translation>
<translation id="8255190535488645436">‏GTX Browser درحال استفاده از دوربین و میکروفون شما است.</translation>
<translation id="8286862437124483331">‏GTX Browser در حال تلاش برای نشان دادن گذرواژه‌هاست. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="828798499196665338">‏ولی‌تان «اجازه‌های مربوط به سایت‌ها، برنامه‌ها، و افزونه‌ها» را برای GTX Browser خاموش کرده است. فعال کردن این <ph name="EXTENSION_TYPE_PARAMETER" /> مجاز نیست.</translation>
<translation id="8290100596633877290">‏اوه! GTX Browser با اشکال مواجه شده است. دوباره راه‌اندازی شود؟</translation>
<translation id="8342675569599923794">‏این فایل خطرناک است، بنابراین GTX Browser آن را مسدود کرده است.</translation>
<translation id="8370517070665726704">‏حق نشر <ph name="YEAR" /> Google LLC.‎ کلیه حقوق محفوظ است.</translation>
<translation id="8394720698884623075">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در GTX Browser ذخیره شده است مقایسه می‌کند</translation>
<translation id="840084489713044809">‏GTX Browser می‌خواهد گذرواژه‌های شما را صادر کند.</translation>
<translation id="8433638294851456451">‏برای ارسال شماره از اینجا به تلفن Android خود، در هر دو دستگاه به سیستم GTX Browser وارد شوید.</translation>
<translation id="8498858610309223613">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای GTX Browser اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="8521348052903287641">‏قانون ترافیک ورودی GTX Browser نسخه Dev برای امکان دادن به ترافیک mDNS.</translation>
<translation id="8540666473246803645">GTX Browser</translation>
<translation id="8550334526674375523">این نمایه کاری کاملاً مجزا از نمایه شخصی‌تان است.</translation>
<translation id="8556340503434111824">‏نسخه جدیدی از GTX Browser وجود دارد که سریعتر از همیشه است.</translation>
<translation id="8571790202382503603">‏با نمایه‌های GTX Browser می‌توانید همه‌چیزتان را در GTX Browser جدا کنید. با این کار، راحت‌تر می‌توان کار و سرگرمی را ازهم جدا کرد.</translation>
<translation id="8614913330719544658">‏GTX Browser پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="861702415419836452">‏GTX Browser برای دسترسی به دوربین به اجازه نیاز دارد تا بتواند نقشه سه‌بعدی محیط شما را ایجاد کند</translation>
<translation id="8625237574518804553">{0,plural, =1{‏GTX Browser ‏۱ دقیقه دیگر راه‌اندازی مجدد می‌شود}one{‏GTX Browser ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}other{‏GTX Browser ‏# دقیقه دیگر راه‌اندازی مجدد می‌شود}}</translation>
<translation id="8629311577791198377">‏با بستن همه پنجره‌های GTX Browser، کوکی‌ها و داده‌های سایت به‌طور خودکار پاک می‌شوند.</translation>
<translation id="8641606876632989680">‏وقتی با گذرواژه‌ای لورفته به سیستم وارد شوید، GTX Browser به شما اطلاع می‌دهد</translation>
<translation id="8669527147644353129">‏راهنمای GTX Browser</translation>
<translation id="8679801911857917785">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی GTX Browser نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="8686817260976772516">‏با نمایه‌های GTX Browser می‌توانید همه چیزتان را در GTX Browser جدا کنید. برای دوستان و اعضای خانواده‌تان نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="873133009373065397">‏GTX Browser نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="8823341990149967727">‏نسخه GTX Browser قدیمی است</translation>
<translation id="8834965163890861871">‏GTX Browser می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="884296878221830158">‏این برنامه همچنین صفحه‌ای را که هنگام راه‌اندازی GTX Browser یا کلیک کردن روی دکمه صفحه اصلی نشان داده می‌شود، کنترل می‌کند.</translation>
<translation id="8862326446509486874">شما حقوق لازم برای نصب در سطح سیستم را ندارید. دوباره به‌عنوان سرپرست نصب‌کننده را اجرا کنید.</translation>
<translation id="8914504000324227558">‏راه‌اندازی مجدد GTX Browser</translation>
<translation id="8922193594870374009">‏برای ارسال شماره از <ph name="ORIGIN" /> به تلفن Android خود، در هر دو دستگاه به سیستم GTX Browser وارد شوید.</translation>
<translation id="8983720963221508955">‏«مرور ایمن پیشرفته» را در حسابتان روشن کرده‌اید. اکنون آن را برای GTX Browser دریافت کنید.</translation>
<translation id="8986207147630327271">با این کار، نمایه کاری را به این مرورگر اضافه می‌کنید و فقط کنترل نمایه کاری را دراختیار سرپرست قرار می‌دهید.</translation>
<translation id="8999208279178790196">{0,plural, =0{‏به‌روزرسانی GTX Browser دردسترس است}=1{‏به‌روزرسانی GTX Browser دردسترس است}one{‏به‌روزرسانی GTX Browser از # روز پیش دردسترس است}other{‏به‌روزرسانی GTX Browser از # روز پیش دردسترس است}}</translation>
<translation id="9026991721384951619">‏سیستم‌عامل GTX Browser قادر به همگام‌سازی داده‌هایتان نبود زیرا جزئیات ورود به سیستم حساب شما به‌روز نیست.</translation>
<translation id="9067395829937117663">‏GTX Browser به Windows 7 یا بالاتر نیاز دارد.</translation>
<translation id="911206726377975832">داده‌های مرور شما نیز حذف شود؟</translation>
<translation id="9138603949443464873">‏برای اعمال تغییراتتان، GTX Browser را راه‌اندازی مجدد کنید</translation>
<translation id="919706545465235479">‏به‌روزرسانی GTX Browser برای شروع همگام‌سازی</translation>
<translation id="922152298093051471">‏سفارشی کردن GTX Browser</translation>
<translation id="940313311831216333">‏برای دسترسی به چیزهای GTX Browser در همه دستگاه‌هایتان، به سیستم وارد شوید، سپس همگام‌سازی را روشن کنید.</translation>
<translation id="989369509083708165">‏GTX Browser مرورگر پیش‌فرضتان است</translation>
<translation id="989816563149873169">‏با <ph name="SHORTCUT" /> می‌توانید بین نمایه‌های GTX Browser جابه‌جا شوید</translation>
</translationbundle>