<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1001534784610492198">ინსტალატორის არქივი დაზიანებული ან არასწორია. გთხოვთ, ხელახლა ჩამოტვირთოთ GTX Browser.</translation>
<translation id="102763973188675173">მოირგეთ და გააკონტროლეთ GTX Browser. ხელმისაწვდომია განახლება.</translation>
<translation id="1051826050538111504">თქვენს კომპიუტერზე აღმოჩენილია საზიანო პროგრამული უზრუნველყოფა. GTX Browser-ს შეუძლია მისი ამოშლა, თქვენი პარამეტრების აღდგენა და გაფართოებების გათიშვა, რომ ბრაუზერმა კვლავ ნორმალურად იმუშაოს.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" /> დრე იყენებდა GTX Browser-ს</translation>
<translation id="110877069173485804">ეს არის თქვენი GTX Browser</translation>
<translation id="1125124144982679672">ვინ იყენებს GTX Browser-ს?</translation>
<translation id="1142745911746664600">GTX Browser-ის განახლება ვერ მოხერხდა</translation>
<translation id="1154147086299354128">GTX Browser-ში &amp;გახსნა</translation>
<translation id="1182414570724401860">GTX Browser გირჩევთ, არ ჩამოტვირთოთ და არც გახსნათ ეს ფაილი</translation>
<translation id="1278833599417554002">ხელახლა გაშვება &amp;GTX Browser-ის გასაახლებლად</translation>
<translation id="1293325835983155583"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის GTX Browser OS-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="1302523850133262269">დაელოდეთ, სანამ GTX Browser დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="137466361146087520">GTX Browser Beta</translation>
<translation id="1399397803214730675">ამ კომპიუტერს უკვე აქვს Google Chrom-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ GTX Browser-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="1434626383986940139">GTX Browser Canary პროგრამები</translation>
<translation id="1507198376417198979">მოირგეთ თქვენი ახალი GTX Browser პროფილი</translation>
<translation id="1516530951338665275">დაწყვილების გასაგრძელებლად GTX Browser საჭიროებს Bluetooth-ზე წვდომას. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1553358976309200471">GTX Browser-ის განახლება</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> უკვე შესულია ამ GTX Browser პროფილში. ეს მოქმედება შექმნის ახალ GTX Browser პროფილს <ph name="USER_EMAIL_ADDRESS" />-ისთვის</translation>
<translation id="1587223624401073077">GTX Browser იყენებს თქვენს კამერას.</translation>
<translation id="1587325591171447154">GTX Browser-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="1597911401261118146"><ph name="BEGIN_LINK" />შედით GTX Browser-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1619887657840448962">GTX Browser-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="1628000112320670027">GTX Browser-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="1674870198290878346">ბმულის გახსნა GTX Browser-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="1682634494516646069">GTX Browser ვერ ახერხებს თავის მონაცემთა დირექტორიაში წაკითხვას და ჩაწერის განხორციელებას:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1698376642261615901">GTX Browser არის ვებ-ბრაუზერი, რომელიც ძალიან სწრაფად ხსნის ვებ-გვერდებს და პროგრამებს. იგი სწრაფი, სტაბილური და ადვილად გამოსაყენებელია. უფრო უსაფრთხოდ დაათვალიერეთ ინტერნეტ-გვერდები, GTX Browser-ში ჩაშენებული საზიანო პროგრამების და თაღლითობის საწინააღმდეგო დაცვის დახმარებით.</translation>
<translation id="1713301662689114961">{0,plural, =1{GTX Browser ხელახლა გაეშვება 1 საათში}other{GTX Browser ხელახლა გაეშვება # საათში}}</translation>
<translation id="1734234790201236882">GTX Browser შეინახავს ამ პაროლს თქვენს Google ანგარიშში. მისი დამახსოვრება აუცილებელი არ არის.</translation>
<translation id="174539241580958092">შესვლის დროს დაშვებული შეცდომის გამო GTX Browser-მა ვერ მოახდინა თქვენი მონაცემების სინქრონიზაცია.</translation>
<translation id="1759842336958782510">GTX Browser</translation>
<translation id="1786003790898721085">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ GTX Browser-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="1812689907177901597">ამ პარამეტრის გამორთვის შემთხვევაში, Google-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ GTX Browser-ში შესვლის გარეშე</translation>
<translation id="1860536484129686729">GTX Browser საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="1873233029667955273">GTX Browser არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="1874309113135274312">GTX Browser Beta (mDNS-In)</translation>
<translation id="1877026089748256423">GTX Browser მოძველებულია</translation>
<translation id="1919130412786645364">GTX Browser-ში შესვლის დაშვება</translation>
<translation id="2018528049276128029">თითოეულ პროფილში ინახება საკუთარი GTX Browser ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="2063848847527508675">განახლების მისასადაგებლად, GTX Browser OS უნდა გადაიტვირთოს.</translation>
<translation id="2094919256425865063">მაინც გსურთ GTX Browser-იდან გასვლა?</translation>
<translation id="2120620239521071941">ეს მოქმედება წაშლის <ph name="ITEMS_COUNT" /> ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით GTX Browser-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">ხელახლა გაშვება &amp;GTX Browser-ის გასაახლებლად</translation>
<translation id="2123055963409958220">ხელი შეუწყვეთ GTX Browser-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="2151406531797534936">გთხოვთ, ახლავე გადატვირთოთ GTX Browser</translation>
<translation id="2189289170880510015">მოირგეთ GTX Browser-ის კონფიდენციალურობის კუთხით ყველაზე მნიშვნელოვანი ვარიანტები</translation>
<translation id="2258103955319320201">GTX Browser ბრაუზერში თქვენს კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, შემდეგ კი ჩართეთ სინქრონიზაცია</translation>
<translation id="2290014774651636340">Google API გასაღები გამოტოვებულია. GTX Browser-ის ზოგიერთი ფუნქცია გამორთული იქნება.</translation>
<translation id="2290095356545025170">ნამდვილად გსურთ მოახდინოთ GTX Browser-ის დეინსტალაცია?</translation>
<translation id="2309047409763057870">ეს GTX Browser-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="2345992953227471816">GTX Browser-მა აღმოაჩინა, რომ შემდეგი გაფართოებები შეიცავს მავნე პროგრამას:</translation>
<translation id="2348335408836342058">GTX Browser საჭიროებს თქვენს კამერასა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="234869673307233423">GTX Browser ვერ ახერხებს პაროლების შემოწმებას. ცადეთ მოგვიანებით.</translation>
<translation id="235650106824528204">ამ პროფილის გამოყენებისას შექმნილი GTX Browser მონაცემების (მაგ., შექმნილი სანიშნეების, ისტორიის, პაროლებისა და სხვა პარამეტრების) ამოშლა შეუძლია სამსახურის პროფილის ადმინისტრატორს. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">გაგრძელება</translation>
<translation id="2429317896000329049">GTX Browser-მა ვერ დაასინქრონა თქვენი მონაცემები, რადგან სინქრონიზაცია არ არის ხელმისაწვდომი თქვენი დომენისთვის.</translation>
<translation id="2467438592969358367">GTX Browser ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="2485422356828889247">დეინსტალაცია</translation>
<translation id="2534507159460261402">Google Pay (GTX Browser-ში კოპირებული)</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> უკვე შესულია ამ GTX Browser პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, GTX Browser-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="2580411288591421699">შეუძლებელია იმავე GTX Browser-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ GTX Browser და ხელახლა სცადეთ.</translation>
<translation id="2586406160782125153">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით GTX Browser-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2622559029861875898">GTX Browser ვერ ახერხებს განახლებების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
<translation id="2644798301485385923">GTX Browser OS სისტემა</translation>
<translation id="2652691236519827073">ბმულის გახსნა GTX Browser-ის ახალ ჩა&amp;ნართში</translation>
<translation id="2665296953892887393">დაგვეხმარეთ GTX Browser-ის გაუმჯობესებაში: გამოგზავნეთ მოხსენებები შეცდომების შესახებ <ph name="UMA_LINK" /> Google-ში</translation>
<translation id="2689103672227170538">ამ გაფართოებამ თქვენ მიერ GTX Browser-ის გაშვებისას ნაჩვენები გვერდი შეცვალა.</translation>
<translation id="2742320827292110288">გაფრთხილება: GTX Browser ვერ შეუშლის ხელს გაფართოებებს ვების დათვალიერების ისტორიის შენახვაში. ამ გაფართოების ინკოგნიტო რეჟიმში გამოსართავად მოხსენით მონიშვნა ამ ვარიანტზე.</translation>
<translation id="2765403129283291972">GTX Browser საჭიროებს თქვენს მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="2770231113462710648">შეცვალეთ ნაგულისხმევი ბრაუზერი-ით:</translation>
<translation id="2775140325783767197">GTX Browser ვერ ახერხებს პაროლების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
