<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="hr">
<translation id="1047130070405668746">Odaberite GTX Browser</translation>
<translation id="1091252999271033193">To znači da će GTX Browser svaki put zahtijevati web-lokaciju za mobilne uređaje.</translation>
<translation id="1185134272377778587">O pregledniku GTX Browser</translation>
<translation id="1257458525759135959">Da bi se slike spremale, dodirnite Postavke kako biste dopustili GTX Browseru da dodaje vašim fotografijama</translation>
<translation id="1289216811211435351">Prelazak na GTX Browser</translation>
<translation id="1361748954329991663">GTX Browser je zastario. Ako u <ph name="BEGIN_LINK" />trgovini aplikacija<ph name="END_LINK" /> nema dostupnih ažuriranja, postoji mogućnost da vaš uređaj više ne podržava nove verzije GTX Browsera.</translation>
<translation id="1431818719585918472">Dopustite GTX Browseru da zaključa vaše anonimne kartice.</translation>
<translation id="1472013873724362412">Vaš račun ne funkcionira na GTX Browseru. Obratite se administratoru domene ili se prijavite običnim Google računom.</translation>
<translation id="1507010443238049608">Pomozite poboljšati GTX Browserove značajke i izvedbu</translation>
<translation id="1531155317299575425">Prikazuje obavijesti za prijavu u GTX Browser.</translation>
<translation id="1617663976202781617">Podaci sinkronizacije GTX Browsera</translation>
<translation id="1722370509450468186">Zaporka će se spremiti na vaš račun (<ph name="EMAIL" />).</translation>
<translation id="1736662517232558588">Podaci GTX Browsera izbrisani su</translation>
<translation id="177102542580335555">Imate standardnu zaštitu sigurnosti za ovaj profil u GTX Browseru</translation>
<translation id="1838412507805038478">GTX Browser je potvrdio da je <ph name="ISSUER" /> izdao certifikat web-lokacije.</translation>
<translation id="1843424232666537147">GTX Browser ima značajke koje vam pomažu u upravljanju internetskim podacima i brzinom kojom se učitavaju web-stranice.
<ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="1867772173333403444">4. Odaberite GTX Browser</translation>
<translation id="2006345422933397527">GTX Browser nije uspio provjeriti ima li ažuriranja. Provjerite internetsku vezu.</translation>
<translation id="2052320862053429062">GTX Browser povremeno uspoređuje vaše zaporke s javno objavljenim popisima. Tom su prilikom vaše zaporke i korisnička imena šifrirani, tako da ih nitko ne može pročitati, uključujući Google.</translation>
<translation id="2054703085270098503">Ostanite sigurni uz GTX Browser</translation>
<translation id="2168108852149185974">Neki programski dodaci uzrokuju rušenje GTX Browsera. Deinstalirajte:</translation>
<translation id="2178608107313874732">GTX Browser trenutačno ne može upotrebljavati vaš fotoaparat</translation>
<translation id="2195025571279539885">Želite li da GTX Browser sljedeći put ponudi prijevod stranica s te web-lokacije za <ph name="LANGUAGE_NAME" />?</translation>
<translation id="2218146227246548550">Vaša organizacija zahtijeva da se prijavite da biste koristili GTX Browser. <ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="2236584955986023187">To znači da će GTX Browser svaki put zahtijevati web-lokaciju za računalo.</translation>
<translation id="2313870531055795960">Provjerava URL-ove s popisom nesigurnih web-lokacija pohranjenih u GTX Browseru. Ako neka web-lokacija pokuša ukrasti vašu zaporku ili ako preuzmete štetnu datoteku, GTX Browser također može sigurnom pregledavanju poslati URL-ove, uključujući dijelove sadržaja web-stranice.</translation>
<translation id="2426113998523353159">Vaša organizacija zahtijeva da se prijavite da biste koristili GTX Browser.</translation>
<translation id="2450140762465183767">Sad možete koristiti GTX Browser svaki put kad dodirnete veze u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="2478931088402984578">Odaberite <ph name="BEGIN_BOLD" />GTX Browser<ph name="END_BOLD" /></translation>
<translation id="2590893390871230428">Sinkroniziraj podatke iz GTX Browsera</translation>
<translation id="2618596336309823556">U postavkama uređaja otvorite <ph name="TEXT_OF_THE_SETTINGS_MENU_ITEM" /> i odaberite GTX Browser.</translation>
<translation id="2650312721222849884">Da biste vidjeli svoje kartice bez obzira na to gdje koristite GTX Browser, uključite sinkronizaciju</translation>
<translation id="2684230048001240293">Postavite GTX Browser kao zadani preglednik da biste sinkronizirali kartice, zaporke i podatke o plaćanju na svim svojim uređajima</translation>
<translation id="2730884209570016437">GTX Browser ne može upotrebljavati vaš fotoaparat jer ga upotrebljava neka druga aplikacija</translation>
<translation id="2915596697727466327">GTX Browser upotrebljava Face ID radi sprječavanja neovlaštenog pristupa vašim zaporkama.</translation>
<translation id="2918709798697875261">Vaša organizacija zahtijeva da ostanete odjavljeni s GTX Browsera.</translation>
<translation id="2942241131342758843">Koristite GTX Browser prema zadanim postavkama da biste otvarali veze, pretraživali putem widgeta i automatski popunjavali zaporke u drugim aplikacijama</translation>
<translation id="2977470724722393594">GTX Browser je ažuran</translation>
<translation id="3102849287235003384">Da biste se odjavili sa svojeg Google računa na svim web-lokacijama, <ph name="BEGIN_LINK" />odjavite se iz GTX Browsera<ph name="END_LINK" />.</translation>
<translation id="3256316712990552818">Kopirano na GTX Browser</translation>
<translation id="3344973607274501920">GTX Browser nije uspio provjeriti vaše zaporke. Provjerite internetsku vezu.</translation>
<translation id="3472200483164753384">Nije podržano u GTX Browser Canaryju</translation>
<translation id="3567399274263440288">Da biste iskoristili sve prednosti koje vam pruža GTX Browser, prijavite se u GTX Browser Google računom.</translation>
<translation id="3639997914391704523">GTX Browser može provjeriti vaše zaporke kad se prijavite Google računom.</translation>
<translation id="3650632991272923014">Korisnik <ph name="USER_EMAIL1" /> upotrebljavao je GTX Browser i ostavio oznake, zaporke i druge postavke na ovom uređaju.</translation>
<translation id="372658070733623520">Da biste upotrebljavali i spremali podatke GTX Browsera na svoj Google račun, potvrdite da ste to vi.</translation>
<translation id="3805899903892079518">GTX Browser nema pristup fotografijama ni videozapisima. Omogućite pristup u Postavkama iOS-a &gt; Privatnost &gt; Fotografije.</translation>
<translation id="4043291146360695975">Zaporke se spremaju u Upravitelj zaporki samo na ovom uređaju.</translation>
<translation id="4099085513035183040">Nije podržano u beta verziji GTX Browsera</translation>
<translation id="4432744876818348753">Prijavite se da biste iskoristili sve prednosti GTX Browsera.</translation>
<translation id="452436063477828504">Provjerite možete li uvijek upotrebljavati podatke iz GTX Browsera na svom Google računu</translation>
<translation id="4555020257205549924">Kada je ta značajka uključena, GTX Browser će ponuditi prijevod stranica napisanih na drugim jezicima pomoću Google prevoditelja. <ph name="BEGIN_LINK" />Saznajte više<ph name="END_LINK" /></translation>
<translation id="4585809515399340748">Sad možete koristiti GTX Browser svaki put kad dodirnete veze u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="4633738821577273991">Nabavite poboljšano sigurno pregledavanje i za ovaj profil u GTX Browseru</translation>
<translation id="4654936625574199632">Radi poboljšanja aplikacije GTX Browser šalje Googleu podatke o upotrebi i rušenju. <ph name="BEGIN_LINK" />Upravljanje<ph name="END_LINK" /></translation>
<translation id="4681781466797808448">Uključite GTX Browserov skener</translation>
<translation id="4736424910885271643">Vašim računom upravlja <ph name="HOSTED_DOMAIN" />, pa će se vaši podaci iz GTX Browsera izbrisati s ovog uređaja</translation>
<translation id="4828317641996116749">GTX Browser nije uspio provjeriti sve zaporke. Pokušajte ponovo kasnije.</translation>
<translation id="4985291216379576555">GTX Browser ne može provjeriti ima li ažuriranja jer ste offline</translation>
<translation id="4996471330284142407">Veća učinkovitost uz GTX Browser, jednostavniji, sigurniji i brži nego ikad.</translation>
<translation id="4999538639245140991">Budući da se odjavljujete s računa kojim upravlja <ph name="SIGNOUT_MANAGED_DOMAIN" />, vaši podaci iz GTX Browsera izbrisat će se s ovog uređaja, no ostat će na vašem Google računu.</translation>
<translation id="5048795749726991615">Da biste jednostavno dohvatili spremljene zaporke u drugim aplikacijama, upotrijebite GTX Browser za Automatsko popunjavanje</translation>
<translation id="5171868502429358653">Prijava na GTX Browser</translation>
<translation id="5224391634244552924">Nema nijedne spremljene zaporke. GTX Browser može provjeriti vaše zaporke kad ih spremite.</translation>
<translation id="5308226104666789935">GTX Browser ne može provjeriti ima li ažuriranja</translation>
<translation id="5396916991083608703">Želite li postaviti GTX Browser kao zadani preglednik?</translation>
<translation id="5453478652154926037">GTX Browser ne može provjeriti vaše zaporke.</translation>
<translation id="5521125884468363740">Da biste vidjeli svoje kartice bez obzira na to gdje koristite GTX Browser, prijavite se i uključite sinkronizaciju</translation>
<translation id="5522297504975449419">Neke značajke GTX Browsera više neće biti dostupne.</translation>
<translation id="5573014823074921752">Savjet za GTX Browser. Za više opcija za kartice dodirnite i držite gumb Prikaži kartice na alatnoj traci pri dnu ili vrhu zaslona.</translation>
<translation id="5700709190537129682">GTX Browser ne može provjeriti vaše zaporke</translation>
<translation id="5777187867430702742">GTX Browserova stranica</translation>
<translation id="5945387852661427312">Prijavljujete se računom kojim upravlja <ph name="DOMAIN" /> i njegovom administratoru dajete kontrolu nad svojim podacima u GTX Browseru. Vaši će se podaci trajno povezati s tim računom. Ako se odjavite s GTX Browsera, vaši će se podaci izbrisati s ovog uređaja, no ostat će pohranjeni na vašem Google računu.</translation>
<translation id="5983312940147103417">Poboljšavanje GTX Browsera</translation>
<translation id="6062449165341879460">Vaša organizacija <ph name="DOMAIN" /> imat će pristup vašim podacima, oznakama, povijesti, zaporkama i drugim postavkama GTX Browsera koje pohranjujete na ovom računu. Kad se odjavite, vaši će se podaci izbrisati s ovog uređaja.  No vaši će podaci ostati pohranjeni na vašem upravljanom Google računu i bit će dostupni vašoj organizaciji. Vaša organizacija može postaviti i korisnička pravila koja se odnose na taj račun i koja mogu promijeniti GTX Browserovo ponašanje.</translation>
<translation id="61109258320235597">Da biste upotrebljavali podatke iz GTX Browsera na svojem Google računu i spremili ih, unesite šifru.</translation>
<translation id="6119647025869519954">Da biste postavili GTX Browser kao zadani preglednik:
1. Otvorite postavke.
2. Dodirnite opciju Zadana aplikacija preglednika.
3. Odaberite GTX Browser.</translation>
<translation id="6268381023930128611">Želite li se odjaviti iz GTX Browsera?</translation>
<translation id="632825460376924298">Dopusti prijavu u GTX Browser</translation>
<translation id="6337530241089703714">Odaberite želite li podatke iz GTX Browsera izbrisati s ovog uređaja ili ih zadržati</translation>
<translation id="6424492062988593837">GTX Browser je postao još bolji! Dostupna je nova verzija.</translation>
<translation id="6625409903340039086">GTX Browser sada za vaš upravljani račun podržava korisnička pravila</translation>
<translation id="6752854822223394465">Vaša organizacija postavlja GTX Browser...</translation>
<translation id="6820823224820483452">GTX Browser nije uspio provjeriti sve zaporke. Pokušajte ponovo sutra.</translation>
<translation id="6911341667534646387">Nastavite upotrebljavati podatke iz GTX Browsera na svom Google računu</translation>
<translation id="7006920032187763988">Zaporke koje ste spremili u Upravitelj zaporki možete koristiti u drugim aplikacijama na iPadu.</translation>
<translation id="7018284295775193585">GTX Browser se ne može ažurirati</translation>
<translation id="7045244423563602563">Prilagodite GTX Browser sebi</translation>
<translation id="7099326575020694068">GTX Browser ne može upotrebljavati vaš fotoaparat u načinu podijeljenog prikaza</translation>
<translation id="7118091470949186573">Sad možete koristiti GTX Browser svaki put kad dodirnete veze u porukama, dokumentima i drugim aplikacijama.</translation>
<translation id="7165402419892018581">Odabir GTX Browsera za automatsko popunjavanje</translation>
<translation id="7175400662502680481">Vaša je zaporka ugrožena zbog povrede podataka. Upravitelj zaporki preporučuje da je odmah promijenite.</translation>
<translation id="7192111075364461693">Obavijesti GTX Browsera trenutačno su isključene u postavkama uređaja.</translation>
<translation id="7208566199746267865">GTX Browser vam štedi vrijeme sinkronizacijom vaših računa na webu. Račune možete dodavati i uklanjati u postavkama.</translation>
<translation id="725427773388857052">GTX Browser vam može pomoći da se bolje zaštitite od povrede podataka, nesigurnih web-lokacija i još mnogo toga.</translation>
<translation id="7255976941681861701">Upoznajte novi izbornik GTX Browsera</translation>
<translation id="7269362888766543920">Neki programski dodaci uzrokuju rušenje GTX Browsera. Pokušajte ih deinstalirati.</translation>
<translation id="7313655110045230863">Da biste postavili GTX Browser kao svoj zadani preglednik, otvorite postavke. Dodirnite opciju Zadana aplikacija preglednika i odaberite GTX Browser.</translation>
<translation id="7337881442233988129">GTX Browser</translation>
<translation id="7357211569052832586">Odabrani podaci uklonjeni su iz GTX Browsera i sa sinkroniziranih uređaja. Na Google računu možda postoje drugi oblici povijesti pregledavanja, primjerice pretraživanja i aktivnosti s drugih Googleovih usluga, na stranici history.google.com.</translation>
<translation id="7395825497086981028">Zaporka će se spremiti u Upravitelj zaporki za <ph name="EMAIL" />.</translation>
<translation id="7400689562045506105">Upotrebljavajte GTX Browser svugdje</translation>
<translation id="7674213385180944843">Otvorite Postavke &gt; Privatnost &gt; Fotoaparat &gt; GTX Browser i uključite fotoaparat.</translation>
<translation id="7746854981345936341">Savjet za GTX Browser. Neki se gumbi sada nalaze pri dnu zaslona, primjerice za natrag, naprijed i pretraživanje.</translation>
<translation id="7763454117143368771">Koristite GTX Browser kao zadani preglednik da biste se zaštitili od opasnih web-lokacija i očuvali sigurnost svojih zaporki</translation>
<translation id="7812317783196516890">Prijavljeni ste i vaši se podaci sinkroniziraju s računom kojim upravlja web-lokacija <ph name="DOMAIN" />. Administrator sada može postaviti korisnička pravila koja se odnose na taj račun i koja mogu promijeniti ponašanje GTX Browsera.</translation>
<translation id="7859018312476869945">Kad upisujete u adresnu traku ili okvir za pretraživanje, ono što upisujete GTX Browser šalje vašoj zadanoj tražilici kako bi vam pružio bolje prijedloge. To je isključeno u anonimnom načinu.</translation>
<translation id="786327964234957808">Prebacujete sinkronizirane račune s korisnika <ph name="USER_EMAIL1" /> na korisnika <ph name="USER_EMAIL2" />. Vašim postojećim podacima na GTX Browseru upravlja <ph name="DOMAIN" />. Ovime će se izbrisati vaši podaci s vašeg uređaja, no oni će ostati na računu <ph name="USER_EMAIL1" />.</translation>
<translation id="7890287942691234100">Počnite koristiti GTX Browserov skener</translation>
<translation id="7928628054454574139">Otvorite GTX Browser svaki put kada dodirnite veze u drugim aplikacijama</translation>
<translation id="7931842119211730154">Zaključavanje anonimnih kartica pri zatvaranju Chromea</translation>
<translation id="7980860476903281594">GTX Browser dijeli vašu lokaciju s web-lokacijama za koje dopustite dijeljenje.</translation>
<translation id="8013573822802650211">Da biste vidjeli svoje kartice bez obzira na to gdje koristite GTX Browser, prijavite se na svim svojim uređajima</translation>
<translation id="8073677936375100957">Želite li izbrisati svoje podatke iz GTX Browsera s ovog uređaja?</translation>
<translation id="8240981428553046115">GTX Browser nije uspio provjeriti ima li ažuriranja. Pokušajte ponovo kasnije.</translation>
<translation id="8409374867500149834">Imate najsnažniju GTX Browserovu zaštitu od štetnih web-lokacija</translation>
<translation id="858114650497379505">Zaporke koje ste spremili u Upravitelj zaporki možete koristiti u drugim aplikacijama na iPhoneu.</translation>
<translation id="8586442755830160949">Autorska prava <ph name="YEAR" />. Autori GTX Browsera. Sva prava pridržana.</translation>
<translation id="865600487977764604">Štiti vas na GTX Browseru i može se upotrebljavati za poboljšanje sigurnosti u drugim Googleovim aplikacijama kad ste prijavljeni.</translation>
<translation id="8663480472502753423">Ažuriranje GTX Browsera</translation>
<translation id="8685813584220679697">Prijavite se na ovu web-lokaciju i GTX Browser.</translation>
<translation id="8747378496147986285">Kada je uključeno:
<ph name="BEGIN_INDENT" />  • Pomozite poboljšati GTX Browser za korisnike koji ga upotrebljavaju na isti način kao vi.<ph name="END_INDENT" />

Važne napomene:
<ph name="BEGIN_INDENT" />  • Podaci o upotrebi GTX Browsera šalju se Googleu, no nisu povezani s vama.

  • Ako se GTX Browser sruši, pojedinosti o rušenju mogu uključivati neke osobne podatke.

  • Ako uključite sinkronizaciju, mjerni podaci mogu uključivati i podatke o URL-ovima koje posjetite.<ph name="END_INDENT" /></translation>
<translation id="8776843108004031667">Taj račun i svi nespremljeni podaci uklonit će se iz GTX Browsera.</translation>
<translation id="894437814105052438">Kad se odjavite, GTX Browser neće sinkronizirati nove podatke s vašim Google računom. Ranije sinkronizirani podaci ostat će na računu.</translation>
<translation id="8963279154877372067">Dopustite obavijesti GTX Browsera da biste primali upozorenja o sniženju cijena</translation>
<translation id="9022552996538154597">Prijava na GTX Browser</translation>
<translation id="9059693977935746710">Nećete morati pamtiti tu zaporku. Spremit će se u Upravitelj zaporki za <ph name="EMAIL" /></translation>
<translation id="9089354809943900324">GTX Browser je zastario</translation>
<translation id="9110075932708282655">Koristi GTX Browser prema zadanim postavkama</translation>
<translation id="921174536258924340">GTX Browser nije uspio provjeriti sve zaporke. Pokušajte ponovno sutra ili <ph name="BEGIN_LINK" />provjerite zaporke na svojem Google računu<ph name="END_LINK" />.</translation>
<translation id="985602178874221306">Autori GTX Browsera</translation>
</translationbundle>